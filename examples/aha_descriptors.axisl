; H1c: AHA's two queue descriptors, declared from PCE's own definitions
; (docs/accelerator_design.md). tools/aha_descriptor_check.py holds every
; number here to the constants in PCE, and runs the bundle through AHA's
; loader when a PCE checkout is present.
;
; XNN grid v1 -- pce hardware/accel_engines/xnn_grid_descriptor_ingress.py,
; `decode_xnn_grid_descriptor_v1`. Eight 32-bit words, little-endian:
;   w0 = version(15:0) | flags(31:16)     w1 = rows(15:0) | cols(31:16)
;   w2 = m_count(15:0) | reserved(31:16)  w3 = reserved
;   w4:w5 = row cut mask (64)             w6:w7 = col cut mask (64)
; The ingress is instantiated for ONE physical geometry, so rows and cols are
; checked against it: this corpus describes the 16 x 16 instance. Error codes
; are PCE's and so is their priority. Two of PCE's eight are not here, and
; not by omission: TRANSPORT (1) is a DMA fault while fetching the words, and
; START_ID (7) is the start handshake matching a staged base -- neither is a
; property of the descriptor's contents, which is all a check can read.
; The status is RETURNED: the grid reports its error code rather than writing
; it through a pointer, so `XNN_GRID_SUBMIT rd, (rs1)` returns it in rd.
;
; Bio v1 -- pce aha/verticals/bio/queue_abi.py, as in descriptor.axisl. Its
; engine is `nearasic`: queue_abi.py submits to BIO_ACCEL_TARGET = 5, which the
; RVMT SDK (rvmt_queue_abi.h) names RVMT_ACCEL_TARGET_NEARASIC. The same header
; also defines RVMT_ACCEL_TARGET_BIO = 10. Which one Bio means is PCE's to
; say; this follows the queue ABI, which is what a submitted job carries.
(axis-module aha_descriptors
  (version "0.1.0")
  (target rvmt)
  (description "AHA's XNN grid and Bio queue descriptors, declared and linked to their engines")

  (defisa rvaha
    (base rv64im) (word-bits 64) (registers "x[32]:i64" "pc:i64")
    (features custom) (memory-model rvwmo) (endianness little))

  (defformat R
    (bits 32)
    (fields (opcode 6 0) (rd 11 7) (func3 14 12) (rs1 19 15) (rs2 24 20) (func7 31 25)))

  (defdescriptor xnn_grid_v1
    (bytes 32)
    (fields
      (version 0 i16) (flags 2 i16) (rows 4 i16) (cols 6 i16)
      (m_count 8 i16) (reserved_hi 10 i16) (reserved_word 12 i32)
      (row_cut_mask 16 i64) (col_cut_mask 24 i64))
    (check (and (eq version 1) (eq flags 0)) 2)
    (check (and (eq rows 16) (eq cols 16)) 3)
    (check (and (eq reserved_hi 0) (eq reserved_word 0)) 4)
    (check (ne m_count 0) 5)
    ; Both masks cut at element 0, and neither names an element past the
    ; geometry: 0xFFFF_FFFF_FFFF_0000 is every bit outside sixteen.
    (check (and (eq (and i64 row_cut_mask 1) 1)
                (eq (and i64 col_cut_mask 1) 1)
                (eq (and i64 row_cut_mask 18446744073709486080) 0)
                (eq (and i64 col_cut_mask 18446744073709486080) 0))
           6)
    (status returned i4)
    (description "XNN grid descriptor v1 for a 16x16 grid: 8 words; error 2 version/flags, 3 geometry, 4 reserved, 5 m_count, 6 mask"))

  (defdescriptor bio_v1
    (bytes 68)
    (fields
      (magic 0 i32) (abi_version 4 i32) (op 8 i32) (flags 12 i32)
      (input_ptr 16 i32) (input_bytes 20 i32) (output_ptr 24 i32) (output_bytes 28 i32)
      (scratch_ptr 32 i32) (scratch_bytes 36 i32)
      (param0 40 i32) (param1 44 i32) (param2 48 i32) (param3 52 i32)
      (job_id 56 i32) (reserved 60 i32) (status_ptr 64 i32))
    (check (eq magic 1112100657) 1)
    (check (eq abi_version 1) 2)
    (check (ult param0 9) 3)
    (status status_ptr i32)
    (description "AHA Bio queue ABI v1: 17 u32 words; status 0 ok, 1 magic, 2 version, 3 count"))

  (defkernel double_words
    (params out in count)
    (space (i 8))
    (when (ult i count)
      (store (add i64 out (mul i64 i 4))
             (mul i32 (load i32 unsigned (add i64 in (mul i64 i 4))) 2)
             i32))
    (description "out[i] = 2 * in[i] for i < count"))

  ; Validate and stage: what the grid then computes arrives as a stream, and
  ; this launch is the half a descriptor describes.
  (definstruction xnn_grid_submit
    (mnemonic XNN_GRID_SUBMIT) (isa rvaha) (category custom) (format R)
    (opcode 11) (func3 0) (func7 0)
    (encoding (rs2 0))
    (operands (rd reg i64 out) (rs1 reg i64 in))
    (asm "xnn_grid_submit $rd, ($rs1)")
    (semantics "Validate the XNN grid descriptor at rs1 and return its error code in rd")
    (launches xnn_grid_v1 rs1)
    (latency 8) (throughput 1.0)
    (area-estimate-um2 1.0) (power-estimate-mw 1.0) (expected-speedup 1.0)
    (rationale "The grid reports rather than writes, so the status is returned"))

  (definstruction bio_submit
    (mnemonic BIO_SUBMIT) (isa rvaha) (category custom) (format R)
    (opcode 11) (func3 1) (func7 0)
    (encoding (rd 0) (rs2 0))
    (operands (rs1 reg i64 in))
    (asm "bio_submit ($rs1)")
    (semantics "Run the Bio job at rs1 and write its status through status_ptr")
    (launches bio_v1 rs1 double_words output_ptr input_ptr param0)
    (latency 100) (throughput 0.01)
    (area-estimate-um2 1.0) (power-estimate-mw 1.0) (expected-speedup 1.0)
    (rationale "Bio writes its status where the descriptor says"))

  ; The descriptor-bytes are left for the declaration to supply: the schema
  ; names a defdescriptor, and a count that disagreed with it is refused.
  (defaccelerator xnn_grid
    (family xnn) (subtype gemm)
    (descriptor-version 1) (descriptor-schema xnn_grid_v1)
    (launch-abi rvmt_submit_entry) (completion event_queue)
    (target xnn) (coupling queue_descriptor)
    (latency 64) (throughput 1.0))

  (defaccelerator bio
    (family nearasic) (subtype bio)
    (descriptor-version 1) (descriptor-schema bio_v1) (descriptor-bytes 68)
    (launch-abi rvmt_submit_entry) (completion status_addr)
    (target nearasic) (coupling queue_descriptor)
    (latency 1000) (throughput 0.01)))
