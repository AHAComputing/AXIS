(axis-module xfuzz
  (version "1.0")
  (target rvmt)

  (defisa rv32_fuzz
    (base rv32im)
    (word-bits 32)
    (registers "x[32]:i32")
    (features m custom)
    (memory-model rvwmo)
    (endianness little)
  )

  (definstruction add_x
    (mnemonic ADD_X)
    (category custom)
    (format R)
    (opcode 11)
    (func3 0)
    (func7 0)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (semantics "rd = rs1 + rs2")
    (formal (add i32 rs1 rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
  )

  (definstruction xor_x
    (mnemonic XOR_X)
    (category custom)
    (format R)
    (opcode 11)
    (func3 1)
    (func7 0)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (semantics "rd = rs1 ^ rs2")
    (formal (xor i32 rs1 rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
  )

  (definstruction lw_x
    (mnemonic LW_X)
    (category custom)
    (format I)
    (opcode 11)
    (func3 2)
    (func7 0)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (imm imm i12 in)
    )
    (asm "lw_x $rd, $imm($rs1)")
    (behavior
      (set rd (load i32 signed (add rs1 imm)))
    )
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
  )

  (definstruction sw_x
    (mnemonic SW_X)
    (category custom)
    (format R)
    (opcode 11)
    (func3 3)
    (func7 16)
    (encoding (rd 0))
    (operands
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (asm "sw_x $rs2, ($rs1)")
    (behavior
      (store rs1 rs2 i32)
    )
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
  )

  (definstruction teq_x
    (mnemonic TEQ_X)
    (category custom)
    (format R)
    (opcode 11)
    (func3 4)
    (func7 0)
    (encoding (rd 0))
    (operands
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (asm "teq_x $rs1, $rs2")
    (behavior
      (when (icmp_eq rs1 rs2) (trap illegal))
    )
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
  )

  (definstruction beq_x
    (mnemonic BEQ_X)
    (category custom)
    (format B)
    (opcode 11)
    (func3 5)
    (func7 0)
    (operands
      (rs1 reg i32 in)
      (rs2 reg i32 in)
      (imm imm i13 in)
    )
    (asm "beq_x $rs1, $rs2, $imm")
    (behavior
      (when (icmp_eq rs1 rs2) (setpc (add pc imm)))
    )
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
  )
)
