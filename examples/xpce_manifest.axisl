; The PCE-era `xpce` fixture, in Lisp. It is a different document from
; `rvmt_xpce.axisl` and only ever shared a file stem: this one is the small
; extension manifest PCE's loader was written against, with DOT4 and the TLS
; scratchpad ops, and the compiler-collateral tests are about *it*.
(axis-module xpce
  (version "1.0")
  (target rvmt)
  (description "RVMT custom ISA extension manifest")

  (definstruction tls_load
    (mnemonic TLS_LOAD)
    (description "Thread-local scratchpad load with RVMT decode counter support")
    (category memory)
    (format I)
    (opcode 11)
    (func3 1)
    (func7 2)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (imm imm i12 in)
    )
    (semantics "rd = load_tls(rs1 + imm)")
    (latency 2)
    (throughput 1.0)
    (area-estimate-um2 1200.0)
    (power-estimate-mw 1.5)
    (expected-speedup 1.4)
    (intrinsic llvm.pce.tls.load)
    (patterns thread_local memory_hiding)
    (applicable-patterns thread_local memory_hiding)
    (rationale "Exposes thread-local loads as a custom op so AHA can score memory hiding opportunities.")
  )

  (definstruction dot4
    (mnemonic DOT4)
    (description "Four-lane integer dot product for compact vector kernels")
    (category vector)
    (format R)
    (opcode 11)
    (func3 2)
    (func7 3)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (semantics "rd = dot4_i8(rs1, rs2)")
    (latency 4)
    (throughput 0.5)
    (area-estimate-um2 3600.0)
    (power-estimate-mw 4.0)
    (expected-speedup 2.2)
    (intrinsic llvm.pce.dot4)
    (patterns dot_product neural)
    (applicable-patterns dot_product neural)
    (rationale "Collapses multiply-add byte lanes into one RVMT-visible custom instruction.")
  )

  (definstruction fma_i
    (mnemonic FMA_I)
    (description "Integer fused multiply-add (rs1 * rs2 + rs3) — one cycle, single result.")
    (category arithmetic)
    (format R4)
    (opcode 11)
    (func3 3)
    (encoding (func2 0))
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
      (rs3 reg i32 in)
    )
    (semantics "rd = rs1 * rs2 + rs3")
    (formal (add i32 (mul i32 rs1 rs2) rs3))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 2000.0)
    (power-estimate-mw 2.5)
    (expected-speedup 1.6)
    (intrinsic pce.fma_i)
    (patterns mac dense_matrix)
    (applicable-patterns mac dense_matrix)
    (rationale "Demonstrates ADL formal_semantics — bridge auto-derives a Z3-verified peephole pass that fuses ADD(MUL(a,b), c) into pce.fma_i(a,b,c).")
  )

  (definstruction mac_sq
    (mnemonic MAC_SQ)
    (description "Multiply-accumulate-square — rs1*rs2 + rs1 (uses 2 operands; demo for RTL.1 lowering pipeline).")
    (category arithmetic)
    (format R)
    (opcode 11)
    (func3 4)
    (func7 5)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (semantics "rd = rs1 * rs2 + rs1")
    (formal (add i32 (mul i32 rs1 rs2) rs1))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 1800.0)
    (power-estimate-mw 2.0)
    (expected-speedup 1.3)
    (intrinsic pce.mac_sq)
    (patterns mac)
    (applicable-patterns mac)
    (rationale "2-operand MAC-style instruction; smallest non-trivial demo of ADL formal_semantics flowing to a generated PyRTL semantics callable that simulates correctly.")
  )

  (defcore rvmt0
    (kind rvmt)
    (threads 4)
    (features m atomics barriers custom)
  )

  (defaccelerator nearasic0
    (family nearasic)
    (subtype reduce)
    (descriptor-version 1)
    (descriptor-bytes 0)
    (mmio-base 0)
    (mmio-size 0)
    (target nearasic)
    (coupling queue_descriptor)
    (region-id 0)
    (manifest-version 0)
    (profile scalar)
    (backend-kind auto)
    (exec-shape scalar)
    (simd-lanes 1)
    (element-width-bits 0)
    (fallback-policy software)
    (latency 1)
    (throughput 1.0)
  )

  (deftile rvmt_tile0
    (cores rvmt0)
    (accelerators nearasic0)
    (memories l1 scratchpad)
    (interconnect crossbar)
  )
)
