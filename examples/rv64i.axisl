    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "`rs2` of zero is `C.JALR`, told apart the same way"))

  (definstruction C_LW
    (mnemonic C_LW)
    (isa rv64i)
    (category custom)
    (format C_CL_W)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 2) (op 0))
    (operands
      (rd rv_gpr_c i64 out)
      (rs1 rv_gpr_c i64 in)
      (imm imm i7 in))
    (asm "c.lw $rd, $imm($rs1)")
    (semantics "rd = sign_extend(Mem32[rs1 + imm])")
    (behavior
      (set rd (load i32 signed (add i64 rs1 imm))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "The offset is unsigned and already scaled: its low two bits are not encoded because a word access is aligned"))

  (definstruction C_FLD
    (mnemonic C_FLD)
    (isa rv64i)
    (category custom)
    (format C_CL_D)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 1) (op 0))
    (operands
      (rd rv_fpr_c i64 out)
      (rs1 rv_gpr_c i64 in)
      (imm imm i8 in))
    (asm "c.fld $rd, $imm($rs1)")
    (semantics "fd = Mem64[rs1 + imm]")
    (behavior
      (set rd (load i64 unsigned (add i64 rs1 imm))))
    (latency 2)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "The same offset layout as C.LD, into the FP file: a compressed instruction reaches f8-f15 exactly as it reaches x8-x15"))

  (definstruction C_LD
    (mnemonic C_LD)
    (isa rv64i)
    (category custom)
    (format C_CL_D)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 3) (op 0))
    (operands
      (rd rv_gpr_c i64 out)
      (rs1 rv_gpr_c i64 in)
      (imm imm i8 in))
    (asm "c.ld $rd, $imm($rs1)")
    (semantics "rd = Mem64[rs1 + imm]")
    (behavior
      (set rd (load i64 unsigned (add i64 rs1 imm))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "A doubleword access is eight-aligned, so three low bits go unencoded and the offset reaches further"))

  (definstruction C_SW
    (mnemonic C_SW)
    (isa rv64i)
    (category custom)
    (format C_CS_W)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 6) (op 0))
    (operands
      (rs1 rv_gpr_c i64 in)
      (rs2 rv_gpr_c i64 in)
      (imm imm i7 in))
    (asm "c.sw $rs2, $imm($rs1)")
    (semantics "Mem32[rs1 + imm] = rs2")
    (behavior
      (store (add i64 rs1 imm) rs2 i32))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "The same offset layout as C.LW, with the register field holding a source"))

  (definstruction C_J
    (mnemonic C_J)
    (isa rv64i)
    (category custom)
    (format C_CJ)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 5) (op 1))
    (operands
      (imm imm i12 in))
    (asm "c.j $imm")
    (semantics "pc = pc + sign_extend(imm12)")
    (behavior
      (setpc (add i64 pc (sext i64 12 imm))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "Eleven bits of target in eleven bits of instruction, scattered so the common ones land where the format has room"))

  (definstruction C_BEQZ
    (mnemonic C_BEQZ)
    (isa rv64i)
    (category custom)
    (format C_CB)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 6) (op 1))
    (operands
      (rs1 rv_gpr_c i64 in)
      (imm imm i9 in))
    (asm "c.beqz $rs1, $imm")
    (semantics "Branch when rs1 is zero")
    (behavior
      (when (icmp_eq rs1 0) (setpc (add i64 pc (sext i64 9 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "Comparing against zero is what makes a branch fit in sixteen bits: the second register is implied"))

  (definstruction C_BNEZ
    (mnemonic C_BNEZ)
    (isa rv64i)
    (category custom)
    (format C_CB)
    (opcode 0) (func3 0) (func7 0)
