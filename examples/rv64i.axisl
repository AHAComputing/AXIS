  ; --- The C extension ------------------------------------------------------
  ; Measured on a compiled RV64GC object: 44 of 70 instructions are compressed,
  ; led by `c.addi` (9), `c.jr`/`ret` (7), `c.li` and `c.add` (4 each). These
  ; are the arithmetic and move forms; each is a full-width operation in
  ; sixteen bits, so the semantics are the ordinary ones.

  (definstruction C_ADDI
    (mnemonic C_ADDI)
    (isa rv64i)
    (category custom)
    (format C_CI)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 0) (op 1))
    (operands
      (rd rv_gpr i64 inout)
      (imm imm i6 in))
    (asm "c.addi $rd, $imm")
    (semantics "rd = rd + sign_extend(imm6)")
    (requires (!= rd 0))
    (formal (add i64 rd (sext i64 6 imm)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "The commonest compressed instruction there is: a small constant added in place"))

  (definstruction C_ADDIW
    (mnemonic C_ADDIW)
    (isa rv64i)
    (category custom)
    (format C_CI)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 1) (op 1))
    (operands
      (rd rv_gpr i64 inout)
      (imm imm i6 in))
    (asm "c.addiw $rd, $imm")
    (semantics "Add the immediate to the low 32 bits and sign-extend the result")
    (formal (sext i64 32 (add i32 rd (sext i32 6 imm))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "C.ADDI's 64-bit sibling narrowed to 32: the same six-bit immediate, sign-extended from bit 31"))

  (definstruction C_LI
    (mnemonic C_LI)
    (isa rv64i)
    (category custom)
    (format C_CI)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 2) (op 1))
    (operands
      (rd rv_gpr i64 out)
      (imm imm i6 in))
    (asm "c.li $rd, $imm")
    (semantics "rd = sign_extend(imm6)")
    (formal (sext i64 6 imm))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "A six-bit constant, which is most of the constants a compiler needs"))

  (definstruction C_SLLI
    (mnemonic C_SLLI)
    (isa rv64i)
    (category custom)
    (format C_CI)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 0) (op 2))
    (operands
      (rd rv_gpr i64 inout)
      (imm imm i6 in))
    (asm "c.slli $rd, $imm")
    (semantics "rd = rd << imm6")
    (formal (shl i64 rd imm))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "The shift amount is unsigned here, which is why it is not sign-extended"))

  (definstruction C_MV
    (mnemonic C_MV)
    (isa rv64i)
    (category custom)
    (format C_CR)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct4 8) (op 2))
    (operands
      (rd rv_gpr i64 out)
      (rs2 rv_gpr i64 in))
    (asm "c.mv $rd, $rs2")
    (semantics "rd = rs2")
