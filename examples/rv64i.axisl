  (definstruction C_SRLI
    (mnemonic C_SRLI)
    (isa rv64i)
    (category custom)
    (format C_CB_SHIFT)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 4) (funct2 0) (op 1))
    (operands
      (rd rv_gpr_c i64 inout)
      (shamt imm i6 in))
    (asm "c.srli $rd, $shamt")
    (semantics "rd = rd >> shamt (logical)")
    (formal (lshr i64 rd shamt))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "The shift group shares `funct3` with the logical one and is told apart by `funct2`"))

  (definstruction C_ADDI4SPN
    (mnemonic C_ADDI4SPN)
    (isa rv64i)
    (category custom)
    (format C_CIW)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct3 0) (op 0))
    (operands
      (rd rv_gpr_c i64 out)
      (rs1 rv_gpr i64 in (fixed 2))
