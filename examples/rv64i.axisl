      (rs2 rv_gpr i64 in))
    (asm "sc.w.aq $rd, $rs2, ($rs1)")
    (semantics "Store if the reservation still holds; rd reads zero on success; acquire, which no store ordering can carry, so it is stated conservatively as a full fence after the store")
    (behavior
      (set rd (select i64 (or i64 (xor i64 exclusive_address rs1) (xor i64 exclusive_size 4) (xor i64 exclusive_valid 1)) 1 0))
      (when (icmp_eq (or i64 (xor i64 exclusive_address rs1) (xor i64 exclusive_size 4) (xor i64 exclusive_valid 1)) 0)
