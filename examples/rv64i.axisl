    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "Its `funct3` is the whole difference from C.BEQZ"))

  (definstruction C_JR
    (mnemonic C_JR)
    (isa rv64i)
    (category custom)
    (format C_CR)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct4 8) (rs2 0) (op 2))
    (operands
      (rd rv_gpr i64 in))
    (asm "c.jr $rd")
    (semantics "Jump to the address in rd")
    (requires (!= rd 0))
