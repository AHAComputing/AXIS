    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "C.SUBW's sibling, and the one a compiler emits far more often"))

  (definstruction C_XOR
    (mnemonic C_XOR)
    (isa rv64i)
    (category custom)
    (format C_CA)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct6 35) (funct2 1) (op 1))
    (operands
      (rd rv_gpr_c i64 inout)
      (rs2 rv_gpr_c i64 in))
