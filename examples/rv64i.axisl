  ; --- A extension: load-reserved and store-conditional ------------------
  ;
  ; A known limitation, stated rather than hidden. RISC-V requires SC to *fail*
  ; if another store to the reservation set intervenes between the LR and the
  ; SC. This model clears the reservation only on SC, so an intervening store —
  ; an AMO to the same address, say — leaves it valid and SC can report success
  ; where the architecture requires failure. That is not conservative: a
  ; permissive model here is wrong, not merely imprecise. Modelling it faithfully
  ; means every store consulting the monitor, which is a larger change than this
  ; corpus. The AArch64 seed's LDXR/STXR carry the same limitation.

  (definstruction LR_W
    (mnemonic LR_W)
    (isa rv64i)
    (category custom)
    (format RV_AMO)
    (opcode 0x2f)
    (func3 2)
    (encoding (func5 2) (aq 0) (rl 0) (rs2 0))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in))
    (asm "lr.w $rd, ($rs1)")
    (semantics "Load and register a reservation on the address; no ordering")
    (behavior
      (set rd (atomic_load i32 signed relaxed rs1))
      (setstate exclusive_address rs1 i64)
      (setstate exclusive_size 4 i8)
      (setstate exclusive_valid 1 i1)
      (setstate exclusive_value (load i32 unsigned rs1) i64))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 2000.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Load-reserved establishes the reservation store-conditional tests"))

  (definstruction SC_W
    (mnemonic SC_W)
    (isa rv64i)
    (category custom)
    (format RV_AMO)
    (opcode 0x2f)
    (func3 2)
    (encoding (func5 3) (aq 0) (rl 0))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sc.w $rd, $rs2, ($rs1)")
    (semantics "Store if the reservation still holds; rd reads zero on success; no ordering")
    (behavior
      (set rd (select i64 (or i64 (xor i64 exclusive_address rs1) (xor i64 exclusive_size 4) (xor i64 exclusive_valid 1)) 1 0))
      (when (icmp_eq (or i64 (xor i64 exclusive_address rs1) (xor i64 exclusive_size 4) (xor i64 exclusive_valid 1)) 0)
        (atomic_store rs1 rs2 i32 relaxed))
      (setstate exclusive_valid 0 i1))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 2000.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Store-conditional reports success as zero, which is what makes a retry loop terminate"))

