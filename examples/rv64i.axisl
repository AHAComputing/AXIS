; RV64I — the RISC-V 64-bit base integer instruction set, complete.
;
; RV64I is not a superset of RV32I in the way a casual reading suggests. The
; shared opcodes are *reinterpreted* at 64 bits: ADD adds 64-bit registers, SRAI
; shifts by six bits of immediate rather than five, and the loads gain LD/LWU
; while LW becomes sign-extending. On top of that sit the W instructions, which
; operate on the low 32 bits and sign-extend the result back into the full
; register — the only way a 64-bit machine reproduces 32-bit arithmetic exactly.
;
; So this is a separate document rather than a mode of the RV32I one: the same
; encoding means a different function of its operands, which is exactly what an
; ISA description is for.
(axis-module rv64i
  (version "1.0.0")
  (target rvmt)
  (description "RV64I base integer instruction set")

  (defisa rv64i
    (base rv64i)
    (word-bits 64)
    (registers "x[32]:i64" "pc:i64"
      ; The reservation LR sets and SC tests. Modelling it as ISA state
      ; rather than as a special case is what let the exclusives work with no
      ; new mechanism.
      "exclusive_address:i64" "exclusive_size:i8" "exclusive_valid:i1" "exclusive_value:i64" "frm:i3" "fflags:i5")
    (features i)
    (memory-model rvwmo)
    (endianness little))

  ; The A extension's own layout: func5 selects the operation and the aq and rl
  ; bits carry the ordering, the same way AArch64's A and L bits do. The built-in
  ; R format has a seven-bit func7 spanning all three, so they need naming.

  ; The floating-point layout: what the R format calls func3 is the rounding
  ; mode, so it needs naming. RISC-V encodes the mode per instruction, which is
  ; exactly what AXIS's mode-as-argument design was for.
  ; RISC-V's FENCE splits the I-format immediate into `fm`, a predecessor set
  ; and a successor set. The two sets are the barrier's option, eight bits of
  ; it, which is why the effect model's four-bit option had to stop being
  ; AArch64's `CRm`.
  ; --- The C extension's sixteen-bit formats ---------------------------------
  ; 63% of a real RV64GC object is compressed, so a description without these
  ; cannot read a RISC-V binary at all -- and a decoder stepping four bytes
  ; through one misaligns everything after the first 16-bit instruction.
  ; `(bits 16)` is what says so, and the decode table publishes it.
  ;
  ; Compressed and uncompressed cannot collide: every 16-bit encoding has
  ; `op` != 3 and every 32-bit one has `op` == 3, which the two low bits carry.

  (defformat C_CR
    (bits 16)
    (fields
      (funct4 15 12)
      (rd 11 7)
      (rs2 6 2)
      (op 1 0)))

  ; The six-bit immediate is split across bit 12 and bits 6:2, which is what the
  ; four-number field form is for: instruction bit 12 carries immediate bit 5.
  (defformat C_CI
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 5 5)
      (rd 11 7)
      (imm 6 2 4 0)
      (op 1 0)))

  (defformat C_CA
    (bits 16)
    (fields
      (funct6 15 10)
      (rd 9 7)
      (funct2 6 5)
      (rs2 4 2)
      (op 1 0)))

  ; The shift and mask forms of the C1 group, whose `funct2` tells them apart
  ; and whose register field is the three-bit one.
  (defformat C_CB_SHIFT
    (bits 16)
    (fields
      (funct3 15 13)
      (shamt 12 12 5 5)
      (funct2 11 10)
      (rd 9 7)
      (shamt 6 2 4 0)
      (op 1 0)))

  ; The load/store and branch forms, whose immediates the architecture
  ; deliberately scatters so the common offsets fit in the bits left over.
  ; `(imm 12 10 5 3)` reads: instruction bits 12:10 carry immediate bits 5:3.
  (defformat C_CL_W
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 10 5 3)
      (rs1 9 7)
      (imm 6 6 2 2)
      (imm 5 5 6 6)
      (rd 4 2)
      (op 1 0)))

  (defformat C_CL_D
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 10 5 3)
      (rs1 9 7)
      (imm 6 5 7 6)
      (rd 4 2)
      (op 1 0)))

  (defformat C_CS_W
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 10 5 3)
      (rs1 9 7)
      (imm 6 6 2 2)
      (imm 5 5 6 6)
      (rs2 4 2)
      (op 1 0)))

  (defformat C_CB
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 8 8)
      (imm 11 10 4 3)
      (rs1 9 7)
      (imm 6 5 7 6)
      (imm 4 3 2 1)
      (imm 2 2 5 5)
      (op 1 0)))

  (defformat C_CJ
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 11 11)
      (imm 11 11 4 4)
      (imm 10 9 9 8)
      (imm 8 8 10 10)
      (imm 7 7 6 6)
      (imm 6 6 7 7)
      (imm 5 3 3 1)
      (imm 2 2 5 5)
      (op 1 0)))

  ; The remaining RVC layouts. Each scatters its immediate differently, because
  ; the C extension orders immediate bits for decoder hardware, not for reading.
  ; C.ADDI4SPN's zero-extended, four-scaled offset into a three-bit register.
  (defformat C_CIW
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 11 5 4)
      (imm 10 7 9 6)
      (imm 6 6 2 2)
      (imm 5 5 3 3)
      (rd 4 2)
      (op 1 0)))

  ; C.ADDI16SP: rd is pinned to sp and the immediate counts sixteen-byte steps.
  (defformat C_CI_SP16
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 9 9)
      (rd 11 7)
      (imm 6 6 4 4)
      (imm 5 5 6 6)
      (imm 4 3 8 7)
      (imm 2 2 5 5)
      (op 1 0)))

  ; C.LUI: the six encoded bits are immediate bits 17:12.
  (defformat C_CI_LUI
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 17 17)
      (rd 11 7)
      (imm 6 2 16 12)
      (op 1 0)))

  ; C.ANDI: C_CB_SHIFT's layout with a signed immediate in place of the shift.
  (defformat C_CB_IMM
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 5 5)
      (funct2 11 10)
      (rd 9 7)
      (imm 6 2 4 0)
      (op 1 0)))

  (defformat C_CS_D
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 10 5 3)
      (rs1 9 7)
      (imm 6 5 7 6)
      (rs2 4 2)
      (op 1 0)))

  ; The stack-pointer-relative forms: loads put rd in 11:7, stores put rs2 in
  ; 6:2, and the scaled offset fills what is left. Their sp, like C.ADDI4SPN's,
  ; is a `(fixed 2)` operand named `rs1`: it is read through the same register
  ; port as any base address, so it must not become a port of its own.
  (defformat C_CI_LWSP
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 5 5)
      (rd 11 7)
      (imm 6 4 4 2)
      (imm 3 2 7 6)
      (op 1 0)))

  (defformat C_CI_LDSP
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 12 5 5)
      (rd 11 7)
      (imm 6 5 4 3)
      (imm 4 2 8 6)
      (op 1 0)))

  (defformat C_CSS_W
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 9 5 2)
      (imm 8 7 7 6)
      (rs2 6 2)
      (op 1 0)))

  (defformat C_CSS_D
    (bits 16)
    (fields
      (funct3 15 13)
      (imm 12 10 5 3)
      (imm 9 7 8 6)
      (rs2 6 2)
      (op 1 0)))

  (defformat RV_FENCE
    (bits 32)
    (fields
      (fm 31 28)
      (option 27 20)
      (rs1 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))

  (defformat RV_FP
    (bits 32)
    (fields
      (func7 31 25)
      (rs2 24 20)
      (rs1 19 15)
      (rm 14 12)
      (rd 11 7)
      (opcode 6 0)))

  (defformat RV_AMO
    (bits 32)
    (fields
      (func5 31 27)
      (aq 26 26)
      (rl 25 25)
      (rs2 24 20)
      (rs1 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))

  ; The CSR *immediate* forms put a five-bit unsigned operand where the register
  ; forms put `rs1`. That is one field with two names -- RISC-V's own manual
  ; calls it `uimm[4:0]` in these encodings -- and an operand binds to the field
  ; its name matches, so describing them against `I` left the operand encoded
  ; nowhere and the field bound to nothing. Six instructions per corpus were
  ; therefore unencodable, which means no fixture, which means executed by
  ; nothing: the roundtrip manifest listed them under `unencoded_operand` every
  ; run and nothing read it.
  (defformat RV_CSRI
    (bits 32)
    (fields
      (imm 31 20)
      (uimm 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))


  ; RV64 shift-immediates: shamt is six bits, so func7 shrinks to six and the
  ; shift amount spans bits 25:20. Encoding a six-bit amount in the R format's
  ; five-bit rs2 field silently drops the top bit, which turns `slli x, y, 32`
  ; into `slli x, y, 0` — the shift that does nothing.
  (defformat RV64_SHIFT_I
    (bits 32)
    (fields
      (func6 31 26)
      (shamt 25 20)
      (rs1 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))

  (definstruction LUI
    (mnemonic LUI)
    (isa rv64i)
    (category custom)
    (format U)
    (opcode 0x37)
    (operands
      (rd rv_gpr i64 out)
      (imm imm i64 in))
    (asm "lui $rd, $imm")
    (semantics "Load the 20-bit upper immediate; the U format already places it at bits 31:12")
    (formal (sext i64 32 imm))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Load the 20-bit upper immediate; the U format already places it at bits 31:12"))

  (definstruction AUIPC
    (mnemonic AUIPC)
    (isa rv64i)
    (category custom)
    (format U)
    (opcode 0x17)
    (operands
      (rd rv_gpr i64 out)
      (imm imm i64 in))
    (asm "auipc $rd, $imm")
    (semantics "Add the upper immediate to the pc")
    (behavior
      (set rd (add i64 pc (sext i64 32 imm))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Add the upper immediate to the pc"))

  (definstruction JAL
    (mnemonic JAL)
    (isa rv64i)
    (category custom)
    (format J)
    (opcode 0x6f)
    (operands
      (rd rv_gpr i64 out)
      (imm imm i64 in))
    (asm "jal $rd, $imm")
    (semantics "Jump and link; the J format packs a 21-bit signed offset whose low bit is always zero")
    (behavior
      (setpc (add i64 pc (sext i64 21 imm)))
      (set rd (add i64 pc 4)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Jump and link; the J format packs a 21-bit signed offset whose low bit is always zero"))

  (definstruction JALR
    (mnemonic JALR)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x67)
    (func3 0)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "jalr $rd, $rs1, $imm")
    (semantics "Jump to rs1 plus offset with the low bit cleared, and link")
    (behavior
      (setpc (and i64 (add i64 rs1 (sext i64 12 imm)) 0xfffffffffffffffe))
      (set rd (add i64 pc 4)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Jump to rs1 plus offset with the low bit cleared, and link"))

  (definstruction BEQ
    (mnemonic BEQ)
    (isa rv64i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 0)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "beq $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is equal rs2")
    (behavior
      (when (icmp_eq rs1 rs2) (setpc (add i64 pc (sext i64 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is equal rs2"))

  (definstruction BNE
    (mnemonic BNE)
    (isa rv64i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 1)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "bne $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is not equal rs2")
    (behavior
      (when (icmp_ne rs1 rs2) (setpc (add i64 pc (sext i64 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is not equal rs2"))

  (definstruction BLT
    (mnemonic BLT)
    (isa rv64i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 4)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "blt $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is less than, signed rs2")
    (behavior
      (when (icmp_slt rs1 rs2) (setpc (add i64 pc (sext i64 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is less than, signed rs2"))

  (definstruction BGE
    (mnemonic BGE)
    (isa rv64i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 5)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "bge $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is greater or equal, signed rs2")
    (behavior
      (when (icmp_sge rs1 rs2) (setpc (add i64 pc (sext i64 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is greater or equal, signed rs2"))

  (definstruction BLTU
    (mnemonic BLTU)
    (isa rv64i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 6)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "bltu $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is less than, unsigned rs2")
    (behavior
      (when (icmp_ult rs1 rs2) (setpc (add i64 pc (sext i64 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is less than, unsigned rs2"))

  (definstruction BGEU
    (mnemonic BGEU)
    (isa rv64i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 7)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "bgeu $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is greater or equal, unsigned rs2")
    (behavior
      (when (icmp_uge rs1 rs2) (setpc (add i64 pc (sext i64 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is greater or equal, unsigned rs2"))

  (definstruction LB
    (mnemonic LB)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x03)
    (func3 0)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "lb $rd, $imm($rs1)")
    (semantics "Load a 8-bit value, signed-extended into rd")
    (behavior
      (set rd (load i8 signed (add i64 rs1 (sext i64 12 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Load a 8-bit value, signed-extended into rd"))

  (definstruction LH
    (mnemonic LH)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x03)
    (func3 1)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "lh $rd, $imm($rs1)")
    (semantics "Load a 16-bit value, signed-extended into rd")
    (behavior
      (set rd (load i16 signed (add i64 rs1 (sext i64 12 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Load a 16-bit value, signed-extended into rd"))

  (definstruction LW
    (mnemonic LW)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x03)
    (func3 2)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "lw $rd, $imm($rs1)")
    (semantics "Load a 32-bit value, signed-extended into rd")
    (behavior
      (set rd (load i32 signed (add i64 rs1 (sext i64 12 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Load a 32-bit value, signed-extended into rd"))

  (definstruction LBU
    (mnemonic LBU)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x03)
    (func3 4)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "lbu $rd, $imm($rs1)")
    (semantics "Load a 8-bit value, unsigned-extended into rd")
    (behavior
      (set rd (load i8 unsigned (add i64 rs1 (sext i64 12 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Load a 8-bit value, unsigned-extended into rd"))

  (definstruction LHU
    (mnemonic LHU)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x03)
    (func3 5)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "lhu $rd, $imm($rs1)")
    (semantics "Load a 16-bit value, unsigned-extended into rd")
    (behavior
      (set rd (load i16 unsigned (add i64 rs1 (sext i64 12 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Load a 16-bit value, unsigned-extended into rd"))

  (definstruction SB
    (mnemonic SB)
    (isa rv64i)
    (category custom)
    (format S)
    (opcode 0x23)
    (func3 0)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "sb $rs2, $imm($rs1)")
    (semantics "Store the low 8 bits of rs2")
    (behavior
      (store (add i64 rs1 (sext i64 12 imm)) rs2 i8))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Store the low 8 bits of rs2"))

  (definstruction SH
    (mnemonic SH)
    (isa rv64i)
    (category custom)
    (format S)
    (opcode 0x23)
    (func3 1)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "sh $rs2, $imm($rs1)")
    (semantics "Store the low 16 bits of rs2")
    (behavior
      (store (add i64 rs1 (sext i64 12 imm)) rs2 i16))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Store the low 16 bits of rs2"))

  (definstruction SW
    (mnemonic SW)
    (isa rv64i)
    (category custom)
    (format S)
    (opcode 0x23)
    (func3 2)
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "sw $rs2, $imm($rs1)")
    (semantics "Store the low 32 bits of rs2")
    (behavior
      (store (add i64 rs1 (sext i64 12 imm)) rs2 i32))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Store the low 32 bits of rs2"))

  (definstruction ADDI
    (mnemonic ADDI)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x13)
    (func3 0)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "addi $rd, $rs1, $imm")
    (semantics "Add the sign-extended immediate")
    (formal (add i64 rs1 (sext i64 12 imm)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Add the sign-extended immediate"))

  (definstruction SLTI
    (mnemonic SLTI)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x13)
    (func3 2)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "slti $rd, $rs1, $imm")
    (semantics "Set to 1 when rs1 is less than the immediate, signed")
    (formal (icmp_slt i64 rs1 (sext i64 12 imm)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Set to 1 when rs1 is less than the immediate, signed"))

  (definstruction SLTIU
    (mnemonic SLTIU)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x13)
    (func3 3)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i64 in))
    (asm "sltiu $rd, $rs1, $imm")
    (semantics "Set to 1 when rs1 is less than the immediate, unsigned; the immediate is still sign-extended first")
    (formal (icmp_ult i64 rs1 (sext i64 12 imm)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Set to 1 when rs1 is less than the immediate, unsigned; the immediate is still sign-extended first"))

  (definstruction XORI
