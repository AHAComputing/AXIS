    (behavior
      (barrier fence 51)
      (set rd (atomic_load i64 signed acquire rs1))
      (setstate exclusive_address rs1 i64)
      (setstate exclusive_size 8 i8)
      (setstate exclusive_valid 1 i1)
      (setstate exclusive_value (load i64 unsigned rs1) i64))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 2000.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Load-reserved establishes the reservation store-conditional tests"))

  (definstruction SC_D_AQRL
