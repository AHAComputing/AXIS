    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "`rs2` of zero is `C.JR` at the same funct4, which the constraint separates"))

  (definstruction C_ADD
    (mnemonic C_ADD)
    (isa rv64i)
    (category custom)
    (format C_CR)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct4 9) (op 2))
    (operands
      (rd rv_gpr i64 inout)
      (rs2 rv_gpr i64 in))
    (asm "c.add $rd, $rs2")
    (semantics "rd = rd + rs2")
    (requires (!= rs2 0))
    (formal (add i64 rd rs2))
