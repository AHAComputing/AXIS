    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "Seven of the compressed instructions in a real object: `ret` is `c.jr ra`, and every function ends with one"))

  (definstruction C_SUB
    (mnemonic C_SUB)
    (isa rv64i)
    (category custom)
    (format C_CA)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct6 35) (funct2 0) (op 1))
    (operands
      (rd rv_gpr_c i64 inout)
      (rs2 rv_gpr_c i64 in))
    (asm "c.sub $rd, $rs2")
    (semantics "rd = rd - rs2")
    (formal (sub i64 rd rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "The three-bit register fields reach x8-x15, which is what `rv_gpr_c` says"))

  (definstruction C_SUBW
    (mnemonic C_SUBW)
    (isa rv64i)
    (category custom)
    (format C_CA)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct6 39) (funct2 0) (op 1))
    (operands
      (rd rv_gpr_c i64 inout)
      (rs2 rv_gpr_c i64 in))
    (asm "c.subw $rd, $rs2")
    (semantics "Subtract the low 32 bits and sign-extend the result")
    (formal (sext i64 32 (sub i32 rd rs2)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
    (rationale "A different `funct6` from C.SUB, and the width is the whole difference"))

  (definstruction C_ADDW
    (mnemonic C_ADDW)
    (isa rv64i)
    (category custom)
    (format C_CA)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct6 39) (funct2 1) (op 1))
