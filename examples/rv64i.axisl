      (rs1 rv_fpr i64 in)
      (rs2 rv_fpr i64 in))
    (asm "fsgnjx.s $rd, $rs1, $rs2")
    (semantics "Magnitude from rs1, sign from rs2; pure bit manipulation, so no rounding mode")
    (formal (or i64 (zext i64 32 (or i32 (and i32 rs1 0x7fffffff) (and i32 (xor i32 rs1 rs2) 0x80000000))) 0xffffffff00000000))
