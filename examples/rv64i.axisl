  ; The minimum and maximum are bit-for-bit selections, not arithmetic, so
  ; like the sign injections above they carry no rounding mode. Single results
  ; are NaN-boxed into the wide register the same way.
  ; The moves between register files are pure bit copies -- `FMV.X.W` takes the
  ; low 32 bits of an f register into an x register sign-extended, and
  ; `FMV.W.X` puts an x register's low 32 bits into an f register NaN-boxed.
  ; Neither rounds, and `rs2` is fixed rather than read.
  ; The fused multiply-adds. `fma` is one rounding over `a * b + c`, which is
  ; the whole reason the language spells it rather than letting a multiply and
  ; an add be contracted -- writing these as `(fadd (fmul ...) ...)` would say
  ; the machine rounds twice, and it does not.
  ;
  ; Only the round-to-nearest forms are here. The other three rounding modes
  ; need `fma_rm`, and `FMSUB`/`FNMADD`/`FNMSUB` need a negation of a float,
  ; and the language has neither -- see docs/simd_fp_design.md.
  (definstruction FMADD_S
    (mnemonic FMADD_S)
    (isa rv64i)
    (category custom)
    (format R4)
    (opcode 0x43)
    (func3 0)
    (encoding (func2 0))
    (operands
      (rd rv_fpr i64 out)
      (rs1 rv_fpr i64 in)
      (rs2 rv_fpr i64 in)
      (rs3 rv_fpr i64 in))
    (asm "fmadd.s $rd, $rs1, $rs2, $rs3, rne")
    (semantics "One rounding over rs1 * rs2 + rs3, under RNE")
    (behavior
      (set rd (or i64 (zext i64 32 (fma f32 rs1 rs2 rs3)) 0xffffffff00000000))
      (setstate fflags (or i5 fflags (fma_fx f32 rs1 rs2 rs3)) i5))
    (latency 5)
    (throughput 1.0)
    (area-estimate-um2 9000.0)
    (power-estimate-mw 12.0)
    (expected-speedup 1.0)
    (rationale "RV64F fused multiply-add"))

