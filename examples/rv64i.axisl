  ; ECALL and EBREAK are the whole of the base ISA's environment interface,
  ; and every bit of their word is fixed: the I-format's rd, rs1 and func3 are
  ; zero and the immediate is what tells them apart.
  (definstruction FENCE
    (mnemonic FENCE)
    (isa rv64i)
    (category custom)
    (format RV_FENCE)
    (opcode 0x0f)
    (func3 0)
    (encoding (fm 0) (rd 0) (rs1 0))
    (operands
      (option imm i8 in))
    (asm "fence $option")
    (semantics "Order the memory accesses named by the predecessor and successor sets")
    (behavior (barrier fence option))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "RV32I/RV64I memory fence"))

  ; `fence.i` is the Zifencei extension, and it is not a memory fence: it
  ; orders instruction *fetch* against prior writes to instruction memory,
  ; which is the pipeline rather than the memory model -- the same distinction
  ; AArch64 draws between `dmb` and `isb`. Its immediate field is reserved and
  ; zero, so unlike `FENCE` it has no option to name.
  (definstruction FENCE_I
    (mnemonic FENCE_I)
    (isa rv64i)
    (category custom)
    (format RV_FENCE)
    (opcode 0x0f)
    (func3 1)
    (encoding (fm 0) (option 0) (rd 0) (rs1 0))
    (operands)
    (asm "fence.i")
    (semantics "Order instruction fetch against prior writes to instruction memory")
    (behavior (barrier fence_i))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zifencei instruction-fetch fence"))

  (definstruction ECALL
    (mnemonic ECALL)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x73)
    (func3 0)
    (encoding (rd 0) (rs1 0) (imm 0))
    (operands)
    (asm "ecall")
    (semantics "Request a service of the execution environment")
    (behavior
      (trap ecall))
