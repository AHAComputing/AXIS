  ; --- Invalid on a comparison ------------------------------------------
  ;
  ; RISC-V's two rules differ, and the difference is the whole content:
  ; FLT and FLE signal invalid on *any* NaN, quiet or signalling, because an
  ; ordering comparison has no answer for one. FEQ signals only on a
  ; signalling NaN, because equality against a quiet NaN is defined -- it is
  ; false.
  ;
  ; No new operator: which NaN a bit pattern is, is a predicate on the pattern,
  ; the same fact FCLASS is built from. A quiet NaN sets the mantissa's top
  ; bit; a signalling one leaves it clear.
  (defsem rv_isnan32 ((x i32)) i32
    (select i32 (icmp_eq i32 (and i32 (lshr i32 x 23) 0xff) 0xff)
      (select i32 (icmp_eq i32 (and i32 x 0x7fffff) 0) 0 1)
      0))

  (defsem rv_isnan64 ((x i64)) i64
    (select i64 (icmp_eq i64 (and i64 (lshr i64 x 52) 0x7ff) 0x7ff)
      (select i64 (icmp_eq i64 (and i64 x 0xfffffffffffff) 0) 0 1)
      0))

  (defsem rv_issnan32 ((x i32)) i32
    (select i32 (icmp_eq i32 (rv_isnan32 x) 1)
      (select i32 (icmp_eq i32 (and i32 (lshr i32 x 22) 1) 1) 0 1)
      0))

  (defsem rv_issnan64 ((x i64)) i64
    (select i64 (icmp_eq i64 (rv_isnan64 x) 1)
      (select i64 (icmp_eq i64 (and i64 (lshr i64 x 51) 1) 1) 0 1)
      0))

  ; The ordering comparisons: any NaN.
  (defsem rv_order_nv32 ((a i32) (b i32)) i5
    (select i5 (icmp_eq i32 (or i32 (rv_isnan32 a) (rv_isnan32 b)) 1) 16 0))

  (defsem rv_order_nv64 ((a i64) (b i64)) i5
    (select i5 (icmp_eq i64 (or i64 (rv_isnan64 a) (rv_isnan64 b)) 1) 16 0))

  ; Equality, and FMIN/FMAX: only a signalling NaN.
  (defsem rv_quiet_nv32 ((a i32) (b i32)) i5
    (select i5 (icmp_eq i32 (or i32 (rv_issnan32 a) (rv_issnan32 b)) 1) 16 0))

  (defsem rv_quiet_nv64 ((a i64) (b i64)) i5
    (select i5 (icmp_eq i64 (or i64 (rv_issnan64 a) (rv_issnan64 b)) 1) 16 0))

  ; --- Floating-point classification ------------------------------------
  ;
  ; `FCLASS` writes a ten-bit mask with exactly one bit set, saying which of
  ; RISC-V's ten classes the operand falls into. It needs no new operator: the
  ; classification is a predicate on the bit pattern -- sign, an exponent field
  ; that is all ones or all zeros, and a mantissa that is zero or not -- and an
  ; f register read at an integer type is already those bits. Writing it out is
  ; what lets every backend prove it, rather than each having to be taught a
  ; primitive by hand.
  ;
  ;   bit 0 -inf   bit 2 -subnormal   bit 4 +0          bit 6 +normal   bit 8 sNaN
  ;   bit 1 -normal  bit 3 -0         bit 5 +subnormal  bit 7 +inf      bit 9 qNaN
  ;
  ; Signalling and quiet NaN differ only in the mantissa's top bit, which is
  ; set for quiet.
  (defsem rv_fclass32 ((x i32)) i32
    (let ((exp (and i32 (lshr i32 x 23) 0xff)))
      (let ((mant (and i32 x 0x7fffff)))
        (let ((neg (icmp_eq i32 (and i32 (lshr i32 x 31) 1) 1)))
          (select i32 (icmp_eq i32 exp 0xff)
            (select i32 (icmp_eq i32 mant 0)
              (select i32 neg 0x001 0x080)
              (select i32 (icmp_eq i32 (and i32 (lshr i32 mant 22) 1) 1) 0x200 0x100))
            (select i32 (icmp_eq i32 exp 0)
              (select i32 (icmp_eq i32 mant 0)
                (select i32 neg 0x008 0x010)
                (select i32 neg 0x004 0x020))
              (select i32 neg 0x002 0x040)))))))

  (defsem rv_fclass64 ((x i64)) i32
    (let ((exp (and i64 (lshr i64 x 52) 0x7ff)))
      (let ((mant (and i64 x 0xfffffffffffff)))
        (let ((neg (icmp_eq i64 (and i64 (lshr i64 x 63) 1) 1)))
          (select i32 (icmp_eq i64 exp 0x7ff)
            (select i32 (icmp_eq i64 mant 0)
              (select i32 neg 0x001 0x080)
              (select i32 (icmp_eq i64 (and i64 (lshr i64 mant 51) 1) 1) 0x200 0x100))
            (select i32 (icmp_eq i64 exp 0)
              (select i32 (icmp_eq i64 mant 0)
                (select i32 neg 0x008 0x010)
                (select i32 neg 0x004 0x020))
              (select i32 neg 0x002 0x040)))))))

  ; --- F extension: single-precision floating point ---------------------
  ;
  ; The f registers are a second file: f0 is not x0, and FMV/FCVT move between
  ; them. A register class carries an offset into the flat register array, so
  ; f5 is slot 37 -- which is what lets one array model two files.
  ;
  ; What is still not described here, and why:
  ;
  ;   * **Zicsr** -- CSRRW/CSRRS/CSRRC and their immediate forms. This is the
  ;     one that matters: `frm` is ISA state here and the DYN instructions read
  ;     it, but nothing can *write* it, so a program cannot select a dynamic
  ;     rounding mode. Describing DYN without Zicsr describes a machine whose
  ;     mode register is read-only.
  ;   * The RV64-only float/integer conversions: FCVT.L.S, FCVT.LU.S,
  ;     FCVT.S.L, FCVT.S.LU and their D forms. The W forms are all here; these
  ;     are the ones that need XLEN=64 to be worth having.
  ;
  ; FMIN/FMAX, FCLASS, the fused multiply-adds under a rounding mode, rm = 100
  ; (RMM) and rm = 111 (DYN) were on this list and are now described. Two of
  ; those entries had stated a reason that turned out to be wrong: DYN was said
  ; to need "architectural state the description would have to read, not a
  ; rounding mode it can name", when a behavior reads ISA state and a mode is
  ; an ordinary argument to a `_rm` operator; and RMM was said to be
  ; inexpressible because the operators carry AArch64's two-bit mode, when the
  ; mode simply had to become three bits.

  (definstruction FLS
    (mnemonic FLS)
    (isa rv64i)
    (category custom)
    (format I)
    (opcode 0x07)
    (encoding (func3 2))
    (operands
      (rd rv_fpr i64 out)
      (rs1 rv_gpr i64 in)
      (imm imm i32 in))
    (asm "flw $rd, $imm($rs1)")
    (semantics "Load a 32-bit float")
    (behavior
      (set rd (load i32 unsigned (add i64 rs1 (sext i64 12 imm))))
      (set rd (or i64 rd (not i64 (ones i64 32)))))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 6000.0)
    (power-estimate-mw 8.0)
    (expected-speedup 1.0)
    (rationale "Load a 32-bit float"))

  (definstruction FSS
    (mnemonic FSS)
    (isa rv64i)
    (category custom)
    (format S)
    (opcode 0x27)
    (encoding (func3 2))
    (operands
      (rs1 rv_gpr i64 in)
      (rs2 rv_fpr i64 in)
      (imm imm i32 in))
    (asm "fsw $rs2, $imm($rs1)")
    (semantics "Store a 32-bit float")
    (behavior
      (store (add i64 rs1 (sext i64 12 imm)) rs2 i32))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 6000.0)
    (power-estimate-mw 8.0)
    (expected-speedup 1.0)
    (rationale "Store a 32-bit float"))

  (definstruction FADD_S_RNE
    (mnemonic FADD_S_RNE)
    (isa rv64i)
    (category custom)
    (format RV_FP)
