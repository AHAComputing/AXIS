  (definstruction C_OR
    (mnemonic C_OR)
    (isa rv64i)
    (category custom)
    (format C_CA)
    (opcode 0) (func3 0) (func7 0)
    (encoding (funct6 35) (funct2 2) (op 1))
    (operands
      (rd rv_gpr_c i64 inout)
      (rs2 rv_gpr_c i64 in))
    (asm "c.or $rd, $rs2")
    (semantics "rd = rd | rs2")
    (formal (or i64 rd rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 200.0)
    (power-estimate-mw 0.5)
    (expected-speedup 1.0)
