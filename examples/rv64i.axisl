    (asm "lr.d.rl $rd, ($rs1)")
    (semantics "Load and register a reservation on the address; release, which no load ordering can carry, so it is stated conservatively as a full fence before the load")
    (behavior
      (barrier fence 51)
      (set rd (atomic_load i64 signed relaxed rs1))
      (setstate exclusive_address rs1 i64)
      (setstate exclusive_size 8 i8)
      (setstate exclusive_valid 1 i1)
      (setstate exclusive_value (load i64 unsigned rs1) i64))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 2000.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Load-reserved establishes the reservation store-conditional tests"))

  (definstruction SC_D_RL
    (mnemonic SC_D_RL)
    (isa rv64i)
    (category custom)
    (format RV_AMO)
    (opcode 0x2f)
    (func3 3)
    (encoding (func5 3) (aq 0) (rl 1))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sc.d.rl $rd, $rs2, ($rs1)")
    (semantics "Store if the reservation still holds; rd reads zero on success; release")
    (behavior
      (set rd (select i64 (or i64 (xor i64 exclusive_address rs1) (xor i64 exclusive_size 8) (xor i64 exclusive_valid 1)) 1 0))
      (when (icmp_eq (or i64 (xor i64 exclusive_address rs1) (xor i64 exclusive_size 8) (xor i64 exclusive_valid 1)) 0)
        (atomic_store rs1 rs2 i64 release))
      (setstate exclusive_valid 0 i1))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 2000.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Store-conditional reports success as zero, which is what makes a retry loop terminate"))

  (definstruction LR_D_AQRL
    (mnemonic LR_D_AQRL)
    (isa rv64i)
