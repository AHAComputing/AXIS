  ; --- Round to nearest, ties away from zero (rm = 100) ------------------
  ;
  ; RMM is a fifth mode: RISC-V has it and AArch64, whose FPCR encoding the
  ; `_rm` operators carry, does not. It differs from RNE in exactly one
  ; situation -- the exact result sits halfway between two representables --
  ; and agrees everywhere else, which is why only a witness on a tie can
  ; tell them apart.
  ;
  ; The golden model decides "halfway" with exact rationals and SMT names it
  ; `RNA`. C declines these: `fesetround` has no ties-away direction, C23
  ; makes `FE_TONEARESTFROMZERO` optional and it is absent here, and the
  ; two-bit mask this header applies would give ties-*even* silently.
  ; Rust and LLVM already decline every directed rounding mode.

  (definstruction FADD_S_RMM
    (mnemonic FADD_S_RMM)
    (isa rv64i)
    (category custom)
    (format RV_FP)
    (opcode 0x53)
    (encoding (func7 0) (rm 4))
    (operands
      (rd rv_fpr i64 out)
      (rs1 rv_fpr i64 in)
      (rs2 rv_fpr i64 in))
    (asm "fadd.s $rd, $rs1, $rs2, rmm")
    (semantics "fadd under RMM rounding")
    (behavior
      (set rd (or i64 (zext i64 32 (fadd_rm f32 4 rs1 rs2)) 0xffffffff00000000))
      (setstate fflags (or i5 fflags (fadd_fx f32 rs1 rs2)) i5))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 6000.0)
    (power-estimate-mw 8.0)
    (expected-speedup 1.0)
    (rationale "fadd under RMM rounding"))

