;; T8: `defkernel` -- a named, parameterised body over a declared iteration
;; space, launched by an instruction with `runs-kernel`.
;;
;; `mm` has no behavior of its own: the launch supplies it, and every backend
;; sees the six stores the space expands to. `mmflat` writes those six stores
;; out by hand and ALSO names the kernel, which makes the pair a claim the
;; elaborator checks -- the hand-written behavior must be the kernel's, effect
;; by effect, after constant folding. `vadd` is the elementwise case: a space
;; with no reduction in it.
;;
;; The matmul is deliberately not square (2x4 times 4x3) so that an i and a j
;; swapped anywhere lands on a different address, not on the same one.
(axis-module kernel
  (version "0.1.0") (target rvmt)
  (description "Kernels and their launches: matmul and elementwise add")
  (defisa kern (base rv64im) (word-bits 64) (registers "x[32]:i64" "pc:i64")
    (features custom) (memory-model rvwmo) (endianness little))
  (defformat R (bits 32) (fields (opcode 6 0) (rd 11 7) (func3 14 12) (rs1 19 15) (rs2 24 20) (func7 31 25)))
  (definstruction mm
    (mnemonic MM) (isa kern) (category custom) (format R)
    (opcode 11) (func3 0) (func7 0)
    (operands (rd reg i64 in) (rs1 reg i64 in) (rs2 reg i64 in))
    (asm "mm $rd, $rs1, $rs2")
    (semantics "C[2x3] = A[2x4] x B[4x3], i32 row-major, through the kernel")
    (runs-kernel matmul rd rs1 rs2)
    (latency 24) (throughput 0.1)
    (area-estimate-um2 1.0) (power-estimate-mw 1.0) (expected-speedup 1.0)
    (rationale "T8 corpus: a kernel is launched, not transcribed"))
  (definstruction mmflat
    (mnemonic MMFLAT) (isa kern) (category custom) (format R)
    (opcode 11) (func3 1) (func7 0)
    (operands (rd reg i64 in) (rs1 reg i64 in) (rs2 reg i64 in))
    (asm "mmflat $rd, $rs1, $rs2")
    (semantics "the same matmul written out, checked against the kernel")
    (runs-kernel matmul rd rs1 rs2)
    (behavior
      (store (add i64 rd 0)
             (accumulate i32 add (k 4) (order sequential)
               (mul i32 (load i32 unsigned (add i64 rs1 (add i64 0 (mul i64 k 4))))
                        (load i32 unsigned (add i64 rs2 (add i64 (mul i64 k 12) 0)))))
             i32)
      (store (add i64 rd 4)
             (accumulate i32 add (k 4) (order sequential)
               (mul i32 (load i32 unsigned (add i64 rs1 (add i64 0 (mul i64 k 4))))
                        (load i32 unsigned (add i64 rs2 (add i64 (mul i64 k 12) 4)))))
             i32)
      (store (add i64 rd 8)
             (accumulate i32 add (k 4) (order sequential)
               (mul i32 (load i32 unsigned (add i64 rs1 (add i64 0 (mul i64 k 4))))
                        (load i32 unsigned (add i64 rs2 (add i64 (mul i64 k 12) 8)))))
             i32)
      (store (add i64 rd 12)
             (accumulate i32 add (k 4) (order sequential)
               (mul i32 (load i32 unsigned (add i64 rs1 (add i64 16 (mul i64 k 4))))
                        (load i32 unsigned (add i64 rs2 (add i64 (mul i64 k 12) 0)))))
             i32)
      (store (add i64 rd 16)
             (accumulate i32 add (k 4) (order sequential)
               (mul i32 (load i32 unsigned (add i64 rs1 (add i64 16 (mul i64 k 4))))
                        (load i32 unsigned (add i64 rs2 (add i64 (mul i64 k 12) 4)))))
             i32)
      (store (add i64 rd 20)
             (accumulate i32 add (k 4) (order sequential)
               (mul i32 (load i32 unsigned (add i64 rs1 (add i64 16 (mul i64 k 4))))
                        (load i32 unsigned (add i64 rs2 (add i64 (mul i64 k 12) 8)))))
             i32))
    (latency 24) (throughput 0.1)
    (area-estimate-um2 1.0) (power-estimate-mw 1.0) (expected-speedup 1.0)
    (rationale "T8 corpus: a kernel is launched, not transcribed"))
  (definstruction vadd
    (mnemonic VADD) (isa kern) (category custom) (format R)
    (opcode 11) (func3 2) (func7 0)
    (operands (rd reg i64 in) (rs1 reg i64 in) (rs2 reg i64 in))
    (asm "vadd $rd, $rs1, $rs2")
    (semantics "c[i] = a[i] + b[i] for eight i16 elements")
    (runs-kernel vadd8 rd rs1 rs2)
    (latency 24) (throughput 0.1)
    (area-estimate-um2 1.0) (power-estimate-mw 1.0) (expected-speedup 1.0)
    (rationale "T8 corpus: a kernel is launched, not transcribed"))
  (defkernel matmul
    (params c a b)
    (space (i 2) (j 3))
    (store (add i64 c (add i64 (mul i64 i 12) (mul i64 j 4)))
           (accumulate i32 add (k 4) (order sequential)
             (mul i32 (load i32 unsigned (add i64 a (add i64 (mul i64 i 16) (mul i64 k 4))))
                      (load i32 unsigned (add i64 b (add i64 (mul i64 k 12) (mul i64 j 4))))))
           i32)
    (description "2x4 by 4x3 i32 matmul, row-major"))
  (defkernel vadd8
    (params c a b)
    (space (i 8))
    (store (add i64 c (mul i64 i 2))
           (add i16 (load i16 unsigned (add i64 a (mul i64 i 2)))
                    (load i16 unsigned (add i64 b (mul i64 i 2))))
           i16)
    (description "eight-element i16 add")))
