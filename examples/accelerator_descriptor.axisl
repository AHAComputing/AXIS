(axis-module xnear
  (version "1.0")
  (target rvmt)
  (description "Descriptor-backed accelerator launch instructions")

  (definstruction near_launch
    (mnemonic NEAR_LAUNCH)
    (description "Launch a descriptor-backed NearASIC operation from RVMT")
    (category custom)
    (format R)
    (opcode 43)
    (func3 1)
    (func7 16) (encoding (rd 0))
    (operands
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (semantics "launch_descriptor(rs1, rs2)")
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 800.0)
    (power-estimate-mw 0.8)
    (expected-speedup 1.8)
    (intrinsic llvm.pce.near.launch)
    (patterns accelerator_launch queue_descriptor)
    (applicable-patterns accelerator_launch queue_descriptor)
    (rationale "Gives AHA a concrete ISA hook for tightly coupled accelerator launch paths.")
  )

  (defcore rvmt_ctrl
    (kind rvmt)
    (threads 8)
    (features m atomics queues)
  )

  (defaccelerator nearasic_reduce
    (family nearasic)
    (subtype reduce)
    (descriptor-version 1)
    (descriptor-schema rvmt_nearasic_v1)
    (descriptor-bytes 68)
    (launch-abi rvmt_submit_entry)
    (completion status_addr)
    (mmio-base 0)
    (mmio-size 0)
    (target nearasic)
    (coupling tightly_coupled)
    (region-id 0)
    (manifest-version 0)
    (profile scalar)
    (backend-kind auto)
    (exec-shape scalar)
    (simd-lanes 1)
    (element-width-bits 0)
    (fallback-policy software)
    (latency 1)
    (throughput 1.0)
  )

  (deftile control_tile
    (cores rvmt_ctrl)
    (accelerators nearasic_reduce)
    (memories scratchpad)
    (interconnect mailbox)
  )
)
