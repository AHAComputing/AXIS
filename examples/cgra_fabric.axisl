; A spatial fabric: a grid of processing elements and the links between them
; (docs/vliw_spatial_design.md §4.3, stage G1).
;
; The point of describing a CGRA here rather than in its own language is that
; the PEs reuse the *same* unit classes a VLIW packet's slots declare. An
; operation legal on an `alu` slot is legal on an `alu` PE with no second
; declaration and no second semantics: one instruction set, two ways of
; issuing it. So this module declares the instructions once and then says a
; fabric issues them spatially, next to a packet that issues them in a row.
(axis-module cgra
  (version "1.0.0")
  (target spatial_dataflow)
  (description "A 4x4 nearest-neighbour fabric over a shared instruction set")

  (defisa cg32
    (base rv32im)
    (word-bits 32)
    (registers "x[32]:i32" "pc:i32")
    (memory-model rvwmo)
    (endianness little))

  (defmemory scratchpad
    (kind sram)
    (size-bytes 65536)
    (width-bits 32)
    (latency-cycles 2))

  ; Nearest-neighbour mesh. A pattern is an edge for every PE whose neighbour
  ; is on the grid, so the edges of the mesh simply have fewer links -- a torus
  ; would be a different pattern, not a flag on this one.
  (deffabric cgra4x4
    (rows 4)
    (cols 4)
    (pe (units alu mul) (regs 2) (const 1))
    (links (north 1) (south 1) (east 1) (west 1))
    (memory-ports (row 0 scratchpad) (row 3 scratchpad))
    (ii-max 16)
    (description "Nearest-neighbour 4x4 fabric with two memory rows"))

  ; A multi-context fabric: each PE stores four configurations and a context
  ; selector picks between them. That is what lets one PE do a different thing
  ; at each residue of a four-cycle steady state -- which the modulo rule has
  ; always permitted and nothing used to require the hardware to support.
  ; The two ways this machine issues. They are one set of functional units --
  ; the array's first row is the VLIW's slots -- so they cannot both be running,
  ; and a mode is how a description says which one is. Without this the two
  ; halves are declared and nothing stops a corpus claiming both at once.
  (defmode issue_mode
    (csr 0x7c1)
    (field 0 0)
    (values
      (vliw 0)
      (cgra 1))
    (default vliw)
    (description "Which of the two issue mechanisms is running"))

  ; An elastic channel: a value in flight whose arrival is a window rather than
  ; a cycle. Everything the modulo checks prove rests on arrival being a static
  ; function of the schedule, and a handshake breaks that -- so a route naming a
  ; channel is exempt from those checks and carries a different obligation, that
  ; the result does not depend on the timing.
  ;
  ; The protocol is a name. AXIS does not describe handshake wires and no gate
  ; here can say a handshake is implemented correctly; `ready-valid` is an
  ; identifier a consumer matches on, which is the same boundary every other
  ; mechanism in this file draws.
  ;
  ; `(capacity 1)` is the load-bearing number. A ring of pure wires has nowhere
  ; to put a token, so nothing moves -- one buffered token is what lets the ring
  ; turn, and it is decidable from this declaration without executing anything.
  ; `(initial 1)` is what lets the ring start. Every operation on a cycle waits
  ; for a value only the cycle produces, so a ring with an empty buffer never
  ; fires at all -- hardware primes it, and a description that could not say so
  ; would describe a machine that never runs. That is not a hypothetical: the
  ; first version of this corpus had no initial token, and its
  ; latency-insensitivity gate passed by comparing two empty results.
  (defchannel accumulator-bus
    (protocol ready-valid)
    (latency 1 4)
    (capacity 1)
    (order preserving)
    (initial 1)
    (description "A buffered path back to the accumulator, primed with one token"))

  ; A pure wire, for the same fabric, so the corpus states both kinds and the
  ; deadlock rule has something to be true *about* rather than only something
  ; to reject.
  (defchannel forward-wire
    (protocol credit)
    (latency 0 2)
    (capacity 0)
    (order preserving)
    (description "An unbuffered forward hop"))

  ; Entering the array. The instruction supplies what the kernel reads and
  ; receives what it leaves, and `(runs-mapping ...)` ties it to the schedule --
  ; which is what makes the claim checkable rather than asserted. Its semantics
  ; must be the mapping's scalar order composed: CMUL's product feeds CADD's
  ; routed operand, CADD's other operand is the PE constant 7, and both of
  ; CMUL's operands read the one register the launch takes in `rs1`.
  ;
  ; Three obligations meet here and none sees the other's evidence. The executor
  ; gates prove this instruction against the golden model; `fabric_vs_scalar`
  ; proves the mapping computes its scalar order over the fabric; and validation
  ; proves this semantics *is* that order composed. Change any one of the three
  ; and the other two disagree with it.
  (definstruction cgra_launch
    (mnemonic CGRA_LAUNCH)
    (isa cg32)
    (category custom)
    (unit alu)
    (format R)
    (opcode 11)
    (func3 2)
    (func7 0)
    ; Nothing reads the third register slot, so it is a fixed zero rather than
    ; a field with no meaning -- which is also what makes the instruction
    ; encodable, and so what lets the executor gates run it.
    (encoding (rs2 0))
    (runs-mapping madd-on-adres)
    ; Legal in the VLIW mode, because that is the side that issues it: the
    ; array is entered, not entered from.
    (modes vliw)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in))
    (asm "cgra.launch $rd, $rs1")
    (semantics "Run the mapped kernel: square the input and add the PE constant")
    (formal (add i32 (mul i32 rs1 rs1) 7))
    (latency 8)
    (throughput 0.5)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 4.0)
    (rationale "The seam between the two modes, and the only place they meet"))

  ; The other way into the array, and the one an ADRES machine actually uses.
  ; This launch takes no input operands at all: the kernel reads the shared
  ; register file itself, which is what `(getreg reg 3)` says. The two modes are
  ; one set of functional units over one file (`vliw-row` below), so entering
  ; the array does not move values anywhere -- they are already where the array
  ; reads them.
  ;
  ; Until `getreg` existed a description could only say this by taking the
  ; values in operands and claiming the launch supplied them, which states a
  ; different machine: one whose kernel reads whatever registers the launch's
  ; operands happen to name. Here the mapping's `(reg 3)` and `(reg 4)` mean x3
  ; and x4, and validation composes the kernel with exactly those reads in
  ; place.
  (definstruction cgra_enter
    (mnemonic CGRA_ENTER)
    (isa cg32)
    (category custom)
    (unit alu)
    (format R)
    (opcode 11)
    (func3 3)
    (func7 0)
    (encoding (rs1 0) (rs2 0))
    (runs-mapping madd-direct-on-adres)
    (modes vliw)
    (operands
      (rd reg i32 out))
    (asm "cgra.enter $rd")
    (semantics "Run the mapped kernel over x3 and x4, leaving the result in rd")
    (behavior
      (set rd (add (mul (getreg reg 3) (getreg reg 4)) 11)))
    (latency 8)
    (throughput 0.5)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 4.0)
    (rationale "The mode switch, with the live-ins the array reads for itself"))

  ; The VLIW front of an ADRES-like machine. Its slots are not a copy of the
  ; array's first row -- they *are* that row, which `(vliw-row 0 adres_vliw)`
  ; on the fabric below says. That is the architecture's defining relation: one
  ; set of functional units, issued two ways, which is why the two modes are
  ; exclusive and why a value crosses between them through the register file
  ; rather than being transferred anywhere.
  ;
  ; The slots differ from each other -- one multiplies, one does not -- which is
  ; the ordinary shape of a VLIW row and the reason the shared row cannot be
  ; described by a single unit list of its own.
  (defpacket adres_vliw
    (isa cg32)
    (slots
      (s0 (width 32) (units alu mul))
      (s1 (width 32) (units alu))
      (s2 (width 32) (units alu))
      (s3 (width 32) (units alu)))
    (mode vliw)
    (order little)
    (end fixed)
    (hazards interlocked)
    (branches at-most-one)
    (description "Four syllables that are also the array's first row"))

  ; An ADRES-shaped fabric: the first row is the machine's VLIW functional
  ; units and the rows below are plain ALUs. That asymmetry is the whole point
  ; of the architecture -- a kernel's multiplies have to land on row 0, and a
  ; mapper that did not know it would place them anywhere.
  ;
  ; It is also what makes the placement check able to fail. On a uniform grid
  ; every PE holds every unit the fabric names, so "is this operation's unit on
  ; this PE" is a question with one answer.
  (deffabric adres4x4
    (rows 4)
    (cols 4)
    (mode cgra)
    (vliw-row 0 adres_vliw)
    (pe (units alu) (regs 2) (const 1))
    ; A second multiplier row, away from the seam: real arrays are not one
    ; special row and a uniform remainder, and this keeps the row-scoped form
    ; exercised beside the shared one.
    (pe (row 3) (units alu mul) (regs 4) (const 2))
    (links (north 1) (south 1) (east 1) (west 1))
    (memory-ports (row 0 scratchpad))
    (ii-max 16)
    (description "First row carries the VLIW units, the rest are ALUs"))

  (deffabric cgra2x2_mc
    (rows 2)
    (cols 2)
    (pe (units alu mul) (regs 2) (const 1))
    (links (north 1) (south 1) (east 1) (west 1))
    (ii-max 8)
    (contexts 4)
    (description "Two-by-two whose PEs hold four configurations each"))

  ; The irregular case the compass patterns cannot describe: a long diagonal
  ; that costs two cycles because it crosses the die.
  (deffabric cgra2x2_bus
    (rows 2)
    (cols 2)
    (pe (units alu) (regs 1) (const 1))
    (links (east 1))
    (link (0 0) (1 1) (latency 2))
    (ii-max 4)
    (description "Two-by-two with one explicit diagonal"))

  (definstruction cadd
    (mnemonic CADD)
    (isa cg32)
    (category custom)
    (unit alu)
    (format R)
    (opcode 11)
    (func3 0)
    (func7 0)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in))
    (asm "cadd $rd, $rs1, $rs2")
    (semantics "Add two registers on any ALU, in a slot or on a PE")
    (formal (add i32 rs1 rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "The shared operation a packet slot and a fabric PE both issue"))

  (definstruction cmul
    (mnemonic CMUL)
    (isa cg32)
    (category custom)
    (unit mul)
    (format R)
    (opcode 11)
    (func3 1)
    (func7 0)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in))
    (asm "cmul $rd, $rs1, $rs2")
    (semantics "Multiply two registers on a multiplier PE")
    (formal (mul i32 rs1 rs2))
    (latency 3)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "A unit only some PEs hold, so a mapping cannot place it anywhere"))
  ; A mapping is a CGRA's program: where each operation runs, when, and how its
  ; result reaches the next one. AXIS checks a mapping and does not compute
  ; one -- placement and routing are a compiler's search problem, and this is
  ; the checker its output is held to.
  ;
  ; `ii 2` with operations at cycles 0 and 4 is the point of a *modulo*
  ; schedule: the steady state repeats every two cycles, so legality is about
  ; `cycle mod ii` and not about the absolute cycle. CMUL takes three cycles
  ; and the link one, so its result reaches (1,2) at cycle 0+3+1 = 4, which is
  ; where CADD issues.
  (defmapping madd-on-cgra4x4
    (fabric cgra4x4)
    (ii 2)
    (place (op0 CMUL (pe 1 1) (cycle 0))
           (op1 CADD (pe 1 2) (cycle 4)))
    (route (op0 -> op1 (operand rs1) (via (1 1) (1 2)) (cycle 3)))
    (equivalent-to op0 op1)
    (description "Multiply then add, one hop east, in a two-cycle steady state"))

  ; A second mapping whose route crosses two links, so the time a value spends
  ; in flight is load-bearing: the first hop occupies its link at cycle 3 and
  ; the second at cycle 4, and a checker that used the route's start cycle for
  ; both would agree with this one only while every route is a single hop.
  ; CMUL takes three cycles and each hop one, so the result lands at 0+3+2 = 5.
  ; A kernel on the ADRES fabric. The multiply must sit on PE (0, 0): row 0 is
  ; the VLIW's slots, and only slot `s0` has a multiplier, so the placement is
  ; pinned to one column rather than to a row. The add can go anywhere.
  ; Moving the multiply to any other PE is rejected -- which is the check that
  ; could not fail while every PE held every unit the fabric named.
  (defmapping madd-on-adres
    (fabric adres4x4)
    (ii 2)
    (place (op0 CMUL (pe 0 0) (cycle 0))
           (op1 CADD (pe 1 0) (cycle 4)))
    (route (op0 -> op1 (operand rs1) (via (0 0) (1 0)) (cycle 3)))
    ; Where the values come from and where the result is left. The multiply
    ; reads two architectural registers; the add takes the product on its
    ; routed operand and a constant on the other, which is what the PE's
    ; constant register is for. Both of op0's operands name x3 on purpose:
    ; one register feeding two operands must give them one value, which is a
    ; property anonymous inputs could not state, let alone check.
    (live-in (op0 rs1 (reg 3))
             (op0 rs2 (reg 3))
             (op1 rs2 (const 7)))
    (live-out (op1 (reg 5)))
    (equivalent-to op0 op1)
    (description "Multiply on the VLIW row, add on an ALU row below it"))

  ; The same kernel shape as `madd-on-adres`, on the multiplier row away from
  ; the seam, and with both of its live-ins named rather than supplied: x3 and
  ; x4 are the registers the array reads, and `CGRA_ENTER` reads them itself.
  ; Two distinct registers, so which one feeds which operand of the multiply is
  ; a thing the composition can get wrong -- and does, if they are swapped.
  (defmapping madd-direct-on-adres
    (fabric adres4x4)
    (ii 2)
    (place (op0 CMUL (pe 3 1) (cycle 0))
           (op1 CADD (pe 2 1) (cycle 4)))
    (route (op0 -> op1 (operand rs1) (via (3 1) (2 1)) (cycle 3)))
    (live-in (op0 rs1 (reg 3))
             (op0 rs2 (reg 4))
             (op1 rs2 (const 11)))
    (live-out (op1 (reg 5)))
    (equivalent-to op0 op1)
    (description "Multiply x3 by x4 on the far multiplier row, add the PE constant"))

  ; An elastic kernel: an accumulator that feeds itself. The forward hop crosses
  ; a pure wire and the loop-carried hop crosses the buffered channel, so the
  ; ring turns -- which is exactly the property the deadlock rule decides, and
  ; the reason this corpus declares a channel with capacity and one without.
  ;
  ; No cycles anywhere: an elastic route's arrival is its channel's window, and
  ; stating a cycle beside it would be two answers to one question. That is why
  ; this mapping is not launched by an instruction either -- what an elastic
  ; kernel computes is not a static composition, and A4's launch check composes
  ; one.
  (defmapping accumulate-elastic
    (fabric cgra4x4)
    (ii 2)
    (place (acc CADD (pe 2 2) (cycle 0))
           (step CMUL (pe 2 3) (cycle 0)))
    (route (acc -> step (operand rs1) (via (2 2) (2 3)) (channel forward-wire))
           (step -> acc (operand rs2) (via (2 3) (2 2)) (distance 1)
                 (channel accumulator-bus)))
    (equivalent-to acc step)
    (description "A self-feeding accumulator whose back edge is buffered"))

  (defmapping madd2-on-cgra4x4
    (fabric cgra4x4)
    (ii 2)
    (place (op0 CMUL (pe 1 1) (cycle 0))
           (op1 CADD (pe 1 3) (cycle 5)))
    (route (op0 -> op1 (operand rs1) (via (1 1) (1 2) (1 3)) (cycle 3)))
    (equivalent-to op0 op1)
    (description "Two hops east, so a value's time in flight matters"))

  ; A software-pipelined loop: the value CMUL produces in one iteration is
  ; consumed by CADD in the *next*. This is what a modulo schedule is for, and
  ; what `distance` exists to state -- CMUL issues at cycle 0 and takes three
  ; cycles, the hop takes one, so the result lands at cycle 4; with `ii 2` that
  ; is cycle 2 of the iteration after it, which is where CADD issues.
  ;
  ; Nothing modulo `ii` can distinguish this from the same-iteration mapping
  ; above: both have the value arriving at residue 0. Only the absolute
  ; equation `0 + 3 + 1 == 2 + 1*2` says which iteration reads it, which is why
  ; the check is exact and why this corpus needs a case where the two differ.
  (defmapping madd-pipelined-on-cgra4x4
    (fabric cgra4x4)
    (ii 2)
    (place (op0 CMUL (pe 2 1) (cycle 0))
           (op1 CADD (pe 2 2) (cycle 2)))
    (route (op0 -> op1 (operand rs1) (distance 1) (via (2 1) (2 2)) (cycle 3)))
    (equivalent-to op0 op1)
    (description "CMUL feeds the next iteration's CADD across the modulo wrap"))

  ; Three operations time-multiplexed onto one PE, one per residue. On the
  ; single-context `cgra4x4` this is rejected; here the PE has four
  ; configurations and three is within its means.
  (defmapping stacked-on-cgra2x2-mc
    (fabric cgra2x2_mc)
    (ii 4)
    (place (a CADD (pe 0 0) (cycle 0))
           (b CADD (pe 0 0) (cycle 1))
           (c CMUL (pe 0 0) (cycle 2)))
    (equivalent-to a b c)
    (description "Three configurations on one PE, one per residue"))
)
