  (definstruction CPOPW
    (mnemonic CPOPW)
    (isa rv64_bitmanip)
    (category custom)
    (format I)
    (opcode 0x1b)
    (func3 1)
    (encoding (imm 0x602))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in))
    (asm "cpopw $rd, $rs1")
