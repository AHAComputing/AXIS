;; RV64 bit manipulation and conditional zero: Zba, Zbb, Zbs, Zbc and Zicond.
;;
;; These sit beside RV64GC (rv64i.axisl) in the RVA23 profile, and every
;; recent RISC-V Linux kernel and C library selects code for them at run time:
;; the string routines use ORC.B and CLZ/CTZ, address arithmetic uses SHnADD.
;;
;; Semantics are formal wherever an AXIS operator exists. ORC.B and REV8 are
;; written out byte by byte because there is no byte-swap or or-combine
;; operator; the carry-less multiplies are decode-only for want of one.
(axis-module rv64_bitmanip
  (version "1.0.0")
  (target rvmt)
  (description "RV64 Zba, Zbb, Zbs, Zbc and Zicond")

  (defisa rv64_bitmanip
    (base rv64i)
    (word-bits 64)
    (registers "x[32]:i64" "pc:i64")
    (features custom)
    (memory-model rvwmo)
    (endianness little))

  ; RV64 shift-immediates: a six-bit shift amount and a six-bit function code.
  (defformat RV64_SHIFT_I
    (bits 32)
    (fields
      (func6 31 26)
      (shamt 25 20)
      (rs1 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))

  ; The W shift-immediates: a five-bit shift amount under a seven-bit function code.
  (defformat RV_SHIFTW
    (bits 32)
    (fields
      (func7 31 25)
      (shamt 24 20)
      (rs1 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))

  (definstruction SH1ADD
    (mnemonic SH1ADD)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 2)
    (func7 0x10)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sh1add $rd, $rs1, $rs2")
    (semantics "rd = (rs1 << 1) + rs2")
    (formal (add i64 (shl i64 rs1 1) rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: scaled index into an array of 2**n-byte elements"))

  (definstruction SH1ADD_UW
    (mnemonic SH1ADD_UW)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x3b)
    (func3 2)
    (func7 0x10)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sh1add.uw $rd, $rs1, $rs2")
    (semantics "rd = (zero_extend(rs1[31:0]) << 1) + rs2")
    (formal (add i64 (shl i64 (zext i64 32 rs1) 1) rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: the same with an unsigned 32-bit index"))

  (definstruction SH2ADD
    (mnemonic SH2ADD)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 4)
    (func7 0x10)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sh2add $rd, $rs1, $rs2")
    (semantics "rd = (rs1 << 2) + rs2")
    (formal (add i64 (shl i64 rs1 2) rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: scaled index into an array of 2**n-byte elements"))

  (definstruction SH2ADD_UW
    (mnemonic SH2ADD_UW)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x3b)
    (func3 4)
    (func7 0x10)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sh2add.uw $rd, $rs1, $rs2")
    (semantics "rd = (zero_extend(rs1[31:0]) << 2) + rs2")
    (formal (add i64 (shl i64 (zext i64 32 rs1) 2) rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: the same with an unsigned 32-bit index"))

  (definstruction SH3ADD
    (mnemonic SH3ADD)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 6)
    (func7 0x10)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sh3add $rd, $rs1, $rs2")
    (semantics "rd = (rs1 << 3) + rs2")
    (formal (add i64 (shl i64 rs1 3) rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: scaled index into an array of 2**n-byte elements"))

  (definstruction SH3ADD_UW
    (mnemonic SH3ADD_UW)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x3b)
    (func3 6)
    (func7 0x10)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "sh3add.uw $rd, $rs1, $rs2")
    (semantics "rd = (zero_extend(rs1[31:0]) << 3) + rs2")
    (formal (add i64 (shl i64 (zext i64 32 rs1) 3) rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: the same with an unsigned 32-bit index"))

  (definstruction ADD_UW
    (mnemonic ADD_UW)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x3b)
    (func3 0)
    (func7 0x04)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "add.uw $rd, $rs1, $rs2")
    (semantics "rd = zero_extend(rs1[31:0]) + rs2")
    (formal (add i64 (zext i64 32 rs1) rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: an unsigned 32-bit index added to a base"))

  (definstruction SLLI_UW
    (mnemonic SLLI_UW)
    (isa rv64_bitmanip)
    (category custom)
    (format RV64_SHIFT_I)
    (opcode 0x1b)
    (func3 1)
    (encoding (func6 0x02))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (shamt imm i6 in))
    (asm "slli.uw $rd, $rs1, $shamt")
    (semantics "rd = zero_extend(rs1[31:0]) << shamt")
    (formal (shl i64 (zext i64 32 rs1) shamt))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zba: an unsigned 32-bit index scaled by a shift"))

  (definstruction ANDN
    (mnemonic ANDN)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 7)
    (func7 0x20)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "andn $rd, $rs1, $rs2")
    (semantics "rd = rs1 & ~rs2")
    (formal (and i64 rs1 (not i64 rs2)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zbb logic with an inverted operand"))

  (definstruction ORN
    (mnemonic ORN)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 6)
    (func7 0x20)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "orn $rd, $rs1, $rs2")
    (semantics "rd = rs1 | ~rs2")
    (formal (or i64 rs1 (not i64 rs2)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zbb logic with an inverted operand"))

  (definstruction XNOR
    (mnemonic XNOR)
    (isa rv64_bitmanip)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 4)
    (func7 0x20)
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in)
      (rs2 rv_gpr i64 in))
    (asm "xnor $rd, $rs1, $rs2")
    (semantics "rd = ~(rs1 ^ rs2)")
    (formal (not i64 (xor i64 rs1 rs2)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zbb logic with an inverted result"))

  (definstruction CLZ
    (mnemonic CLZ)
    (isa rv64_bitmanip)
    (category custom)
    (format I)
    (opcode 0x13)
    (func3 1)
    (encoding (imm 0x600))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in))
    (asm "clz $rd, $rs1")
    (semantics "rd = clz(rs1)")
    (formal (clz i64 rs1))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zbb bit counting over 64 bits"))

  (definstruction CLZW
    (mnemonic CLZW)
    (isa rv64_bitmanip)
    (category custom)
    (format I)
    (opcode 0x1b)
    (func3 1)
    (encoding (imm 0x600))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in))
    (asm "clzw $rd, $rs1")
    (semantics "rd = clz(rs1[31:0])")
    (formal (zext i64 32 (clz i32 rs1)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zbb bit counting over the low 32 bits"))

  (definstruction CTZ
    (mnemonic CTZ)
    (isa rv64_bitmanip)
