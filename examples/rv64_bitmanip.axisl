    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zbb bit counting over the low 32 bits"))

  (definstruction CPOP
    (mnemonic CPOP)
    (isa rv64_bitmanip)
    (category custom)
    (format I)
    (opcode 0x13)
    (func3 1)
    (encoding (imm 0x602))
    (operands
      (rd rv_gpr i64 out)
      (rs1 rv_gpr i64 in))
