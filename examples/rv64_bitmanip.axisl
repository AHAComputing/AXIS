  (definstruction ORC_B
    (mnemonic ORC_B)
    (isa rv64_bitmanip)
    (category custom)
    (format I)
    (opcode 0x13)
    (func3 5)
    (encoding (imm 0x287))
    (operands
      (rd rv_gpr i64 out)
