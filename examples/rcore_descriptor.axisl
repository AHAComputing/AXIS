(axis-module xrcore
  (version "1.0")
  (target rvmt)
  (description "Descriptor-backed region-core launch instructions")

  (definstruction rcore_launch
    (mnemonic RCORE_LAUNCH)
    (description "Launch a descriptor-backed region-core operation from RVMT")
    (category custom)
    (format R)
    (opcode 43)
    (func3 2)
    (func7 17) (encoding (rd 0))
    (operands
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (semantics "launch_rcore_descriptor(rs1, rs2)")
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 700.0)
    (power-estimate-mw 0.7)
    (expected-speedup 1.7)
    (intrinsic llvm.pce.rcore.launch)
    (patterns accelerator_launch queue_descriptor region_core)
    (applicable-patterns accelerator_launch queue_descriptor region_core)
    (rationale "Gives AHA a concrete ISA hook for RVMT region-core sidecar launch paths.")
  )

  (defcore rvmt_ctrl
    (kind rvmt)
    (threads 8)
    (features m atomics queues)
  )

  (defaccelerator rcore_region
    (family rcore)
    (subtype scalar)
    (descriptor-version 1)
    (descriptor-schema rvmt_rcore_v1)
    (descriptor-bytes 36)
    (launch-abi rvmt_submit_entry)
    (completion mailbox)
    (mmio-base 0)
    (mmio-size 0)
    (target rcore)
    (coupling tightly_coupled)
    (region-id 17)
    (manifest-version 3)
    (profile scalar)
    (backend-kind auto)
    (exec-shape scalar)
    (simd-lanes 1)
    (element-width-bits 0)
    (fallback-policy software)
    (latency 1)
    (throughput 1.0)
  )

  (deftile control_tile
    (cores rvmt_ctrl)
    (accelerators rcore_region)
    (memories scratchpad)
    (interconnect mailbox)
  )
)
