; More than one load in an effect (docs/tensor_design.md, T8).
;
; The effect model allowed one load per effect, at the top of the value. That
; was the wall a kernel hit: a contraction whose terms are memory reads -- which
; is what every kernel in the tensor inventory is -- could not be written
; however the loop machinery was wired.
;
; ⚠️ The restriction lived in ONE PLACE, and not the one it looked like. The
; nested case already existed for atomic read-modify-write, whose load sits
; inside the stored value; the Python executor has always evaluated loads
; recursively through its memory reader; the effect summaries already walked
; for loads anywhere, with a comment saying so. What refused a second load was
; the validation step that lowers an effect value into the pure typed IR, which
; stripped a load only when the whole value was one. Everything else was ready.
;
; The fix is the move `getreg` made one construct over: a load is a leaf the
; pure IR has no node for, so it becomes a symbol before lowering and what the
; IR checks is the expression around it. The load itself is checked in the
; rewrite -- shape, width, sign, order, and its address as an ordinary pure
; expression at the MACHINE's width rather than the surrounding value's.
;
; DOT_MEM is why this matters: four values read from memory and contracted, at
; an accumulator wide enough that the order cannot show. That is the inner step
; of a kernel, and it was not describable before.
(axis-module nested_loads
  (version "0.1.0")
  (target rvmt)
  (description "An effect may read memory more than once")

  (defisa mem
    (base rv64im)
    (word-bits 64)
    (registers "x[32]:i64" "pc:i64")
    (features custom)
    (memory-model rvwmo)
    (endianness little))

  (defformat M_R
    (bits 32)
    (fields
      (opcode 6 0)
      (rd 11 7)
      (func3 14 12)
      (rs1 19 15)
      (rs2 24 20)
      (func7 31 25)))

  (definstruction dot_mem
    (mnemonic DOT_MEM) (isa mem) (category custom) (format M_R)
    (opcode 11) (func3 0) (func7 0)
    (encoding (rs2 0))
    (operands (rd reg i64 out) (rs1 reg i64 in))
    (asm "dot_mem $rd, $rs1")
    (semantics "Contract four halfwords read from memory")
    (behavior (set rd (accumulate i64 add (k 4) (order exact)
      (zext i64 16 (load i16 unsigned (add i64 rs1 (mul i64 k 8)))))))
    (latency 12) (throughput 0.3)
    (area-estimate-um2 1400.0) (power-estimate-mw 1.8) (expected-speedup 4.0)
    (rationale "The inner step of a kernel: terms that are memory reads"))

  (definstruction add_mem
    (mnemonic ADD_MEM) (isa mem) (category custom) (format M_R)
    (opcode 11) (func3 1) (func7 0)
    (operands (rd reg i64 out) (rs1 reg i64 in) (rs2 reg i64 in))
    (asm "add_mem $rd, $rs1, $rs2")
    (semantics "Add two words read from two addresses")
    (behavior (set rd (add i64 (load i64 unsigned rs1) (load i64 unsigned rs2))))
    (latency 8) (throughput 0.5)
    (area-estimate-um2 700.0) (power-estimate-mw 0.9) (expected-speedup 2.0)
    (rationale "Two loads side by side, which is the smallest thing the old rule refused"))

  (definstruction chase
    (mnemonic CHASE) (isa mem) (category custom) (format M_R)
    (opcode 11) (func3 2) (func7 0)
    (encoding (rs2 0))
    (operands (rd reg i64 out) (rs1 reg i64 in))
    (asm "chase $rd, $rs1")
    (semantics "Follow a pointer: a load whose address is a load")
    (behavior (set rd (load i64 unsigned (load i64 unsigned rs1))))
    (latency 16) (throughput 0.2)
    (area-estimate-um2 500.0) (power-estimate-mw 0.7) (expected-speedup 1.0)
    (rationale "A load inside an address, which is the other place one can nest"))

  (definstruction copy_sum
    (mnemonic COPY_SUM) (isa mem) (category custom) (format M_R)
    (opcode 11) (func3 3) (func7 0)
    (operands (rd reg i64 out) (rs1 reg i64 in) (rs2 reg i64 in))
    (asm "copy_sum $rd, $rs1, $rs2")
    (semantics "Store the sum of two loaded words")
    (behavior (store rs2 (add i64 (load i64 unsigned rs1)
                                  (load i64 unsigned (add i64 rs1 8))) i64))
    (latency 10) (throughput 0.3)
    (area-estimate-um2 800.0) (power-estimate-mw 1.0) (expected-speedup 1.0)
    (rationale "Two loads feeding a store: memory to memory in one effect"))
)
