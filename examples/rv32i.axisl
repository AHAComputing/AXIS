  ; An ABI is not derivable from an instruction set (L4). Which register holds
  ; the first argument is a property of a platform, and a description that
  ; guessed would be inventing a convention rather than generating one. So it
  ; is declared -- and what a declaration can be held to is whether it is
  ; consistent with itself, which is the class of mistake a compiler acts on
  ; silently.
  ;
  ; This is RISC-V's ILP32 with soft float: the `rv_fpr` file is named in no
  ; role, which is what a soft-float convention *is*, rather than an omission.
  (defabi ilp32
    (isa rv32i)
    (pointer-bits 32)
    (stack-alignment 16)
    ; Reserved by definition: an allocatable stack pointer is not a stack
    ; pointer, and x0 discards what is written to it.
    (stack-pointer (rv_gpr 2))
    ; Callee-saved by definition: a frame pointer the callee does not preserve
    ; is not a frame pointer.
    (frame-pointer (rv_gpr 8))
    (link-register (rv_gpr 1))
    (arguments (rv_gpr 10 17))
    (returns (rv_gpr 10 11))
    (callee-saved (rv_gpr 8 9) (rv_gpr 18 27))
    (caller-saved (rv_gpr 1) (rv_gpr 5 7) (rv_gpr 10 17) (rv_gpr 28 31))
    (reserved (rv_gpr 0) (rv_gpr 2) (rv_gpr 3) (rv_gpr 4))
    ; The frame (F1), and it is the one a consumer of this description already
    ; writes by hand: `pce/hardware/grv/grv_linked_execution.py` checks a
    ; prologue of `addi sp, sp, -16 / sw ra, 12(sp) / sw s0, 8(sp) /
    ; addi s0, sp, 16` against hand-encoded words. The layout below computes
    ; those same offsets -- ra at the top slot, s0 beneath it -- from the order
    ; the registers are saved in.
    ;
    ; `ra` is caller-saved and still saved here, which is not a contradiction:
    ; a non-leaf callee clobbers it by calling, so it saves it for the caller.
    ; That is why the rule is "callee-saved, or the link register" and not
    ; "callee-saved".
    (frame
      (growth down)
      (saved-area top)
      (slot-bytes 4)
      (save-order (rv_gpr 1) (rv_gpr 8))
      (frame-pointer-at incoming-sp)
      ; 2048, because that is where `sw`'s signed 12-bit offset stops: the
      ; instruction set decides how big a frame the adjustment can open in one
      ; step, and the gate checks this number against it rather than trusting
      ; it.
      (max-frame-bytes 2048)
      (red-zone 0)
      (adjust ADDI)
      (save SW)
      (restore LW)
      ; The frame's regions, lowest address first (F4). No sizes: how many
      ; spill slots a function needs and how big its locals are is the register
      ; allocator's decision, made per function, and a description that stated
      ; it would be stating what it cannot know. The order is the platform's,
      ; and it has consequences -- the outgoing-argument area is at the frame
      ; base because that is where the callee's own stack pointer finds it.
      (regions outgoing locals spill saved)
      ; What one register costs when it is spilled. Machine data: a register
      ; needs its own width wherever it is put.
      (spill (rv_gpr 4 4) (rv_fpr 8 8))
      ; The pointer discipline (F5). Realignment moves the frame away from the
      ; incoming stack pointer; dynamic allocation moves the stack pointer away
      ; from the frame. Either alone leaves one pointer that still reaches a
      ; local. This abi permits dynamic allocation and not realignment, so the
      ; frame pointer is enough and no base pointer is declared.
      (realignment forbidden)
      (dynamic-allocation allowed))
    ; How a laid-out aggregate is passed (F3). Not how it is laid out: padding
    ; and nested alignment are C's rule, not the machine's, and they belong to
    ; whoever defines the source language. Two registers' worth by value, the
    ; rest by reference, and a returned aggregate's address arrives in the
    ; first argument register -- which is why the rule is that it has to *be*
    ; an argument register.
    (aggregates
      (max-register-bytes 8)
      (split allowed)
      (return-pointer (rv_gpr 10)))
    (description "RISC-V ILP32, soft float"))
)
