  ; --- Dynamic rounding (rm = 111) ---------------------------------------
  ;
  ; `DYN` takes its rounding mode from `fcsr.frm` at execution rather than
  ; from the encoding, which is how essentially all compiled RISC-V float
  ; code runs. It needs nothing the language did not already have: a mode
  ; is an ordinary argument to a `_rm` operator, and a behavior can read
  ; ISA state where a `formal` cannot.
  ;
  ; The reserved modes trap rather than round. `frm` 5 and 6 are reserved
  ; and 7 is invalid in `fcsr`, so `frm >= 5` is an illegal instruction --
  ; which is what the hardware does. 4 is RMM and is now described, so it
  ; rounds rather than trapping.

  (definstruction FADD_S_DYN
    (mnemonic FADD_S_DYN)
    (isa rv32i)
    (category custom)
    (format RV_FP)
    (opcode 0x53)
    (encoding (func7 0) (rm 7))
    (operands
      (rd rv_fpr i64 out)
      (rs1 rv_fpr i64 in)
      (rs2 rv_fpr i64 in))
    (asm "fadd.s $rd, $rs1, $rs2")
    (semantics "fadd under the mode `fcsr.frm` names")
    (behavior
      (when (icmp_uge frm 5) (trap illegal))
      (when (icmp_ult frm 5)
        (set rd (or i64 (zext i64 32 (fadd_rm f32 frm rs1 rs2)) 0xffffffff00000000)))
      (when (icmp_ult frm 5)
        (setstate fflags (or i5 fflags (fadd_fx f32 rs1 rs2)) i5)))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 6000.0)
    (power-estimate-mw 8.0)
    (expected-speedup 1.0)
    (rationale "fadd under the mode `fcsr.frm` names"))

