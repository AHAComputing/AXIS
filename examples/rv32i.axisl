  ; --- Zicsr: the control and status registers ---------------------------
  ;
  ; A CSR is selected by a twelve-bit field of the encoding, and AXIS names its
  ; architectural state statically -- so one instruction addressing all 4096
  ; registers is not describable, and would not be worth describing: this
  ; machine has one CSR whose value anything reads. `frm` is at 0x002, the
  ; instructions below pin that field, and each says which state slot it
  ; touches by name.
  ;
  ; They exist because the DYN forms read `frm` and nothing could write it.
  ; A description with a read-only mode register describes a machine on which
  ; dynamic rounding cannot be selected, which is not the machine RISC-V
  ; specifies.
  ;
  ; The spec's two no-side-effect rules need no guard here. CSRRS/CSRRC with
  ; `rs1` = x0 must not write the CSR, and `x | 0` and `x & ~0` are both the
  ; identity, so the plain description already writes back what was there.
  ; CSRRW with `rd` = x0 must not *read* it, and reading `frm` has no side
  ; effect to suppress.

  (definstruction CSRRW_FRM
    (mnemonic CSRRW_FRM)
    (isa rv32i)
    (category custom)
    (format I)
    (opcode 0x73)
    (func3 1)
    (encoding (imm 2))
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in))
    (asm "csrrw $rd, frm, $rs1")
    (semantics "CSR swap: read `frm`, write the register")
    (behavior
      (set rd (zext i32 3 frm))
      (setstate frm rs1 i3))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zicsr access to the dynamic rounding mode"))

  (definstruction CSRRS_FRM
    (mnemonic CSRRS_FRM)
    (isa rv32i)
    (category custom)
    (format I)
    (opcode 0x73)
    (func3 2)
    (encoding (imm 2))
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in))
    (asm "csrrs $rd, frm, $rs1")
    (semantics "CSR set: read `frm`, set the bits the register names")
    (behavior
      (set rd (zext i32 3 frm))
      (setstate frm (or i3 frm rs1) i3))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zicsr access to the dynamic rounding mode"))

  (definstruction CSRRC_FRM
    (mnemonic CSRRC_FRM)
    (isa rv32i)
    (category custom)
    (format I)
    (opcode 0x73)
    (func3 3)
    (encoding (imm 2))
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in))
    (asm "csrrc $rd, frm, $rs1")
    (semantics "CSR clear: read `frm`, clear the bits the register names")
    (behavior
      (set rd (zext i32 3 frm))
      (setstate frm (and i3 frm (xor i3 rs1 7)) i3))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zicsr access to the dynamic rounding mode"))

  (definstruction CSRRWI_FRM
