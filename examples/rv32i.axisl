  (definstruction BGE
    (mnemonic BGE)
    (isa rv32i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 5)
    (operands
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in)
