  (definstruction FMV_X_W
    (mnemonic FMV_X_W)
    (isa rv32i)
    (category custom)
    (format RV_FP)
    (opcode 0x53)
    (encoding (func7 112) (rm 0) (rs2 0))
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_fpr i64 in))
    (asm "fmv.x.w $rd, $rs1")
    (semantics "The single's bits into an integer register")
    ; XLEN is 32 here, so the low half of the f register *is* the result --
    ; RV64's `FMV.X.W` sign-extends it into a 64-bit x register instead.
    (formal (and i32 rs1 0xffffffff))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "RV32F move to integer"))

