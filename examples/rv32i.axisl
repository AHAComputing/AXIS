    (behavior
      (when (icmp_uge frm 5) (trap illegal))
      (when (icmp_ult frm 5)
        (set rd (fadd_rm f64 frm rs1 rs2)))
      (when (icmp_ult frm 5)
        (setstate fflags (or i5 fflags (fadd_fx f64 rs1 rs2)) i5)))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 6000.0)
    (power-estimate-mw 8.0)
    (expected-speedup 1.0)
    (rationale "fadd under the mode `fcsr.frm` names"))

