; RV32I — the RISC-V base integer instruction set, complete.
;
; This is AXIS's second real ISA. The first, AArch64, shaped the language; two
; things it never needed turned up in the first hour of writing this one:
;
;   * Integer comparisons as values. AArch64 compares by writing NZCV and
;     testing it, so `slt` and the compare-branches had nothing to compute with.
;   * A hardwired zero register. AArch64 encodes XZR as index 31 in some classes
;     and SP in others; RISC-V's x0 is index 0 and always zero. That is now a row
;     in the register-class table rather than a branch per architecture.
;
; Encodings are the real ones. The base formats R/I/S/B/U/J are built in, with
; the scattered immediate slices RISC-V uses, so an instruction here declares its
; opcode and function fields and nothing more.
(axis-module rv32i
  (version "1.0.0")
  (target rvmt)
  (description "RV32I base integer instruction set")

  (defisa rv32i
    (base rv32i)
    (word-bits 32)
    (registers "x[32]:i32" "pc:i32"
      ; The reservation LR sets and SC tests. Modelling it as ISA state
      ; rather than as a special case is what let the exclusives work with no
      ; new mechanism.
      "exclusive_address:i32" "exclusive_size:i8" "exclusive_valid:i1" "exclusive_value:i32" "frm:i3" "fflags:i5")
    (features i)
    (memory-model rvwmo)
    (endianness little))

  ; The A extension's own layout: func5 selects the operation and the aq and rl
  ; bits carry the ordering, the same way AArch64's A and L bits do. The built-in
  ; R format has a seven-bit func7 spanning all three, so they need naming.

  ; The floating-point layout: what the R format calls func3 is the rounding
  ; mode, so it needs naming. RISC-V encodes the mode per instruction, which is
  ; exactly what AXIS's mode-as-argument design was for.
  ; RISC-V's FENCE splits the I-format immediate into `fm`, a predecessor set
  ; and a successor set. The two sets are the barrier's option, eight bits of
  ; it, which is why the effect model's four-bit option had to stop being
  ; AArch64's `CRm`.
  (defformat RV_FENCE
    (bits 32)
    (fields
      (fm 31 28)
      (option 27 20)
      (rs1 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))

  (defformat RV_FP
    (bits 32)
    (fields
      (func7 31 25)
      (rs2 24 20)
      (rs1 19 15)
      (rm 14 12)
      (rd 11 7)
      (opcode 6 0)))

  (defformat RV_AMO
    (bits 32)
    (fields
      (func5 31 27)
      (aq 26 26)
      (rl 25 25)
      (rs2 24 20)
      (rs1 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))

  ; The CSR *immediate* forms put a five-bit unsigned operand where the register
  ; forms put `rs1`. That is one field with two names -- RISC-V's own manual
  ; calls it `uimm[4:0]` in these encodings -- and an operand binds to the field
  ; its name matches, so describing them against `I` left the operand encoded
  ; nowhere and the field bound to nothing. Six instructions per corpus were
  ; therefore unencodable, which means no fixture, which means executed by
  ; nothing: the roundtrip manifest listed them under `unencoded_operand` every
  ; run and nothing read it.
  (defformat RV_CSRI
    (bits 32)
    (fields
      (imm 31 20)
      (uimm 19 15)
      (func3 14 12)
      (rd 11 7)
      (opcode 6 0)))


  (definstruction LUI
    (mnemonic LUI)
    (isa rv32i)
    (category custom)
    (format U)
    (opcode 0x37)
    (operands
      (rd rv_gpr i32 out)
      (imm imm i32 in))
    (asm "lui $rd, $imm")
    (semantics "Load the 20-bit upper immediate; the U format already places it at bits 31:12")
    (formal (or i32 imm 0))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Load the 20-bit upper immediate; the U format already places it at bits 31:12"))

  (definstruction AUIPC
    (mnemonic AUIPC)
    (isa rv32i)
    (category custom)
    (format U)
    (opcode 0x17)
    (operands
      (rd rv_gpr i32 out)
      (imm imm i32 in))
    (asm "auipc $rd, $imm")
    (semantics "Add the upper immediate to the pc")
    (behavior
      (set rd (add i32 pc imm)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Add the upper immediate to the pc"))

  (definstruction JAL
    (mnemonic JAL)
    (isa rv32i)
    (category custom)
    (format J)
    (opcode 0x6f)
    (operands
      (rd rv_gpr i32 out)
      (imm imm i32 in))
    (asm "jal $rd, $imm")
    (semantics "Jump and link; the J format packs a 21-bit signed offset whose low bit is always zero")
    (behavior
      (setpc (add i32 pc (sext i32 21 imm)))
      (set rd (add i32 pc 4)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Jump and link; the J format packs a 21-bit signed offset whose low bit is always zero"))

  (definstruction JALR
    (mnemonic JALR)
    (isa rv32i)
    (category custom)
    (format I)
    (opcode 0x67)
    (func3 0)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "jalr $rd, $rs1, $imm")
    (semantics "Jump to rs1 plus offset with the low bit cleared, and link")
    (behavior
      (setpc (and i32 (add i32 rs1 (sext i32 12 imm)) 0xfffffffe))
      (set rd (add i32 pc 4)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Jump to rs1 plus offset with the low bit cleared, and link"))

  (definstruction BEQ
    (mnemonic BEQ)
    (isa rv32i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 0)
    (operands
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "beq $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is equal rs2")
    (behavior
      (when (icmp_eq rs1 rs2) (setpc (add i32 pc (sext i32 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is equal rs2"))

  (definstruction BNE
    (mnemonic BNE)
    (isa rv32i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 1)
    (operands
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "bne $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is not equal rs2")
    (behavior
      (when (icmp_ne rs1 rs2) (setpc (add i32 pc (sext i32 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is not equal rs2"))

  (definstruction BLT
    (mnemonic BLT)
    (isa rv32i)
    (category custom)
    (format B)
    (opcode 0x63)
    (func3 4)
    (operands
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "blt $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is less than, signed rs2")
    (behavior
      (when (icmp_slt rs1 rs2) (setpc (add i32 pc (sext i32 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
