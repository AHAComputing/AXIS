  (definstruction LB
    (mnemonic LB)
    (isa rv32i)
    (category custom)
    (format I)
    (opcode 0x03)
    (func3 0)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "lb $rd, $imm($rs1)")
