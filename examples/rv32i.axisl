  ; `fflags` at 0x001, beside `frm` at 0x002. Arithmetic only ever accrues
  ; bits -- `(or i5 fflags ...)` -- so a CSR write is the only way a program
  ; clears them, and without these the flags would be a register that fills up
  ; and never empties.

  (definstruction CSRRW_FFLAGS
    (mnemonic CSRRW_FFLAGS)
    (isa rv32i)
    (category custom)
    (format I)
    (opcode 0x73)
    (func3 1)
    (encoding (imm 1))
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in))
    (asm "csrrw $rd, fflags, $rs1")
    (semantics "CSR swap: read the accrued exception flags")
    (behavior
      (set rd (zext i32 5 fflags))
      (setstate fflags rs1 i5))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zicsr access to the accrued floating-point exception flags"))

  (definstruction CSRRS_FFLAGS
    (mnemonic CSRRS_FFLAGS)
