  ; --- M extension: multiply and divide ---------------------------------
  ; RISC-V defines the edge cases rather than trapping: division by zero
  ; yields all ones, the remainder by zero yields the dividend, and the most
  ; negative value divided by minus one overflows to itself with a zero
  ; remainder. Those are written out here because they are architecture, not
  ; an artefact of how any backend divides.

  (definstruction MUL
    (mnemonic MUL)
    (isa rv32i)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 0)
    (func7 0x01)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in))
    (asm "mul $rd, $rs1, $rs2")
    (semantics "Multiply, keeping the low bits")
    (formal (mul i32 rs1 rs2))
    (latency 3)
    (throughput 1.0)
    (area-estimate-um2 4000.0)
    (power-estimate-mw 5.0)
    (expected-speedup 1.0)
    (rationale "Multiply, keeping the low bits"))

  (definstruction MULH
    (mnemonic MULH)
    (isa rv32i)
    (category custom)
    (format R)
    (opcode 0x33)
    (func3 1)
    (func7 0x01)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in))
    (asm "mulh $rd, $rs1, $rs2")
    (semantics "High bits of a signed times signed product")
    (formal (mulh i32 rs1 rs2))
    (latency 3)
    (throughput 1.0)
    (area-estimate-um2 4000.0)
    (power-estimate-mw 5.0)
    (expected-speedup 1.0)
    (rationale "High bits of a signed times signed product"))

