  ; --- D extension: double-precision floating point ---------------------
  ;
  ; The same shapes as F with func7 raised by one, plus the conversions between
  ; the two precisions. FLEN is set by which extensions are present rather than
  ; by XLEN, so with `D` the f registers are 64 bits on RV32 exactly as on RV64
  ; -- which the register class states, and which is why a single is NaN-boxed
  ; into the high bits rather than stored narrow.

  (definstruction FLD
    (mnemonic FLD)
    (isa rv32i)
    (category custom)
    (format I)
    (opcode 0x07)
    (encoding (func3 3))
    (operands
      (rd rv_fpr i64 out)
      (rs1 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "fld $rd, $imm($rs1)")
    (semantics "Load a 64-bit float")
    (behavior
      (set rd (load i64 unsigned (add i64 rs1 (sext i64 12 imm)))))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 6000.0)
    (power-estimate-mw 8.0)
    (expected-speedup 1.0)
    (rationale "Load a 64-bit float"))

  (definstruction FSD
    (mnemonic FSD)
    (isa rv32i)
    (category custom)
    (format S)
    (opcode 0x27)
    (encoding (func3 3))
    (operands
      (rs1 rv_gpr i32 in)
      (rs2 rv_fpr i64 in)
      (imm imm i32 in))
    (asm "fsd $rs2, $imm($rs1)")
    (semantics "Store a 64-bit float")
    (behavior
      (store (add i64 rs1 (sext i64 12 imm)) rs2 i64))
    (latency 4)
    (throughput 1.0)
    (area-estimate-um2 6000.0)
    (power-estimate-mw 8.0)
    (expected-speedup 1.0)
    (rationale "Store a 64-bit float"))

