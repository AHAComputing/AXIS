  ; --- SUNPKLO/HI, UUNPKLO/HI: the low or high half, extended ----------------
  (definstruction sunpklo_h
    (mnemonic SUNPKLO_H) (isa sve) (category simd) (format SVE_UNPK)
    (encoding (hi 5) (size 1) (op 12) (u 0) (h 0) (op2 14))
    (operands (zd vreg i16 out) (zn vreg i16 in))
    (asm "sunpklo_h $zd, $zn")
    (semantics "SUNPKLO: the low half's 8-bit elements, sign-extended to 16 bits")
    (formal (vmap vni16 ((a (vzip1 vni16 zn zn)) (odd (and vni16 (vid vni16) 1))) (sext i16 8 (select i16 (icmp_ne i16 odd 0) (lshr i16 a 8) a))))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "SUNPKLO: the low half's 8-bit elements, sign-extended to 16 bits"))

