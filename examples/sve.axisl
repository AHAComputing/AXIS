  ; --- loads and stores: [Xn|SP, #imm, MUL VL], Pg/Z loads -----------------
  (definstruction ld1_b
    (mnemonic LD1_B) (isa sve) (category custom) (format SVE_LD_SI)
    (encoding (hi 82) (dtype 0) (nf 0) (op 5))
    (operands (zt vreg i8 out) (pg preg i8 in) (rn a64_gpr64sp i64 in) (imm imm i4 in))
    (asm "ld1_b $zt, $pg, $rn, $imm")
    (semantics "LD1B: active 8-bit elements from [Xn + imm * VL], inactive zero")
    (behavior (when (ne (and vni8 pg 1) 0) (set zt (vload vni8 (add i64 rn (mul i64 (sext i64 4 imm) 16))))) (when (eq (and vni8 pg 1) 0) (set zt 0)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "LD1B: active 8-bit elements from [Xn + imm * VL], inactive zero"))

  (definstruction st1_b
    (mnemonic ST1_B) (isa sve) (category custom) (format SVE_ST_SI)
    (encoding (hi 114) (msz 0) (size 0) (zero 0) (op 7))
    (operands (zt vreg i8 in) (pg preg i8 in) (rn a64_gpr64sp i64 in) (imm imm i4 in))
    (asm "st1_b $zt, $pg, $rn, $imm")
    (semantics "ST1B: active 8-bit elements to [Xn + imm * VL], no others")
    (behavior (when (ne (and vni8 pg 1) 0) (store (vaddr vni8 (add i64 rn (mul i64 (sext i64 4 imm) 16))) zt i8)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "ST1B: active 8-bit elements to [Xn + imm * VL], no others"))

