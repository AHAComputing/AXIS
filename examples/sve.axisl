  ; --- SVE2 widening: SADDL/UADDL/SSUBL/USUBL/SMULL/UMULL, bottom and top ----
  (definstruction saddlb_h
    (mnemonic SADDLB_H) (isa sve) (category simd) (format SVE2_WIDE)
    (encoding (hi 69) (size 1) (zero 0) (op 0))
    (operands (zd vreg i16 out) (zn vreg i16 in) (zm vreg i16 in))
    (asm "saddlb_h $zd, $zn, $zm")
    (semantics "SADDLB: the even 8-bit elements, signed, add at 16 bits")
    (formal (vmap vni16 ((a zn) (b zm)) (add i16 (sext i16 8 a) (sext i16 8 b))))
