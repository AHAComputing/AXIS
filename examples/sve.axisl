  ; --- RAX1: Zn XOR Zm rotated left by one, over 64-bit elements --------------
  (definstruction rax1
    (mnemonic RAX1) (isa sve) (category simd) (format SVE2_RAX)
    (encoding (hi 553) (op 61))
    (operands (zd vreg i64 out) (zn vreg i64 in) (zm vreg i64 in))
    (asm "rax1 $zd, $zn, $zm")
    (semantics "RAX1: each 64-bit element of Zn XOR Zm's rotated left by one")
    (formal (vmap vni64 ((a zn) (b zm)) (xor i64 a (or i64 (shl i64 b 1) (lshr i64 b 63)))))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "RAX1: each 64-bit element of Zn XOR Zm's rotated left by one"))

  ; --- the FFR: SETFFR, WRFFR, RDFFR(S) ------------------------------------
  (definstruction setffr
    (mnemonic SETFFR) (isa sve) (category simd) (format SVE_FFR0)
    (encoding (hi 623677440))
    (operands (ffr preg i8 out (fixed 16)))
    (asm "setffr")
    (semantics "Every FFR element true")
    (formal (vdup vni8 1))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Every FFR element true"))

  (definstruction wrffr
    (mnemonic WRFFR) (isa sve) (category simd) (format SVE_FFR_N)
    (encoding (hi 1217608) (lo 0))
    (operands (ffr preg i8 out (fixed 16)) (pn preg i8 in))
