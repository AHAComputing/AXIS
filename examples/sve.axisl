    (asm "tbl_z_b $zd, $zn, $zm")
    (semantics "Table lookup over 8-bit elements: element i reads zn[zm[i]], or zero when that index is out of range")
    (formal (vrgather vni8 zn zm))
    (latency 2) (throughput 1.0)
