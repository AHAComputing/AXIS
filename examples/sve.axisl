  ; --- saturating arithmetic: the A64 corpus's own defsems ----------------------
  (defsem a64_sqadd_8 ((a i8) (b i8)) i8
    (let ((sum (add i8 a b))
          (same-sign (icmp_eq i8 (and i8 (xor i8 a b) 0x80) 0))
          (flipped (icmp_ne i8 (and i8 (xor i8 a sum) 0x80) 0))
          (overflowed (and i8 same-sign flipped))
          (limit (select i8 (icmp_eq i8 (and i8 (lshr i8 a 7) 1) 1)
                              0x80 0x7f)))
      (select i8 overflowed limit sum)))
  (defsem a64_uqadd_8 ((a i8) (b i8)) i8
    (let ((sum (add i8 a b)))
      (select i8 (icmp_ult i8 sum a) 0xff sum)))
  (defsem a64_sqsub_8 ((a i8) (b i8)) i8
    (let ((diff (sub i8 a b))
          (opposite (icmp_ne i8 (and i8 (xor i8 a b) 0x80) 0))
          (flipped (icmp_ne i8 (and i8 (xor i8 a diff) 0x80) 0))
          (overflowed (and i8 opposite flipped))
          (limit (select i8 (icmp_eq i8 (and i8 (lshr i8 a 7) 1) 1)
                              0x80 0x7f)))
      (select i8 overflowed limit diff)))
  (defsem a64_uqsub_8 ((a i8) (b i8)) i8
    (select i8 (icmp_ult i8 a b) 0 (sub i8 a b)))
  (defsem a64_sqadd_16 ((a i16) (b i16)) i16
    (let ((sum (add i16 a b))
          (same-sign (icmp_eq i16 (and i16 (xor i16 a b) 0x8000) 0))
          (flipped (icmp_ne i16 (and i16 (xor i16 a sum) 0x8000) 0))
          (overflowed (and i16 same-sign flipped))
          (limit (select i16 (icmp_eq i16 (and i16 (lshr i16 a 15) 1) 1)
                              0x8000 0x7fff)))
      (select i16 overflowed limit sum)))
  (defsem a64_uqadd_16 ((a i16) (b i16)) i16
    (let ((sum (add i16 a b)))
      (select i16 (icmp_ult i16 sum a) 0xffff sum)))
  (defsem a64_sqsub_16 ((a i16) (b i16)) i16
    (let ((diff (sub i16 a b))
          (opposite (icmp_ne i16 (and i16 (xor i16 a b) 0x8000) 0))
          (flipped (icmp_ne i16 (and i16 (xor i16 a diff) 0x8000) 0))
          (overflowed (and i16 opposite flipped))
          (limit (select i16 (icmp_eq i16 (and i16 (lshr i16 a 15) 1) 1)
                              0x8000 0x7fff)))
      (select i16 overflowed limit diff)))
  (defsem a64_uqsub_16 ((a i16) (b i16)) i16
    (select i16 (icmp_ult i16 a b) 0 (sub i16 a b)))
  (defsem a64_sqadd_32 ((a i32) (b i32)) i32
    (let ((sum (add i32 a b))
          (same-sign (icmp_eq i32 (and i32 (xor i32 a b) 0x80000000) 0))
          (flipped (icmp_ne i32 (and i32 (xor i32 a sum) 0x80000000) 0))
          (overflowed (and i32 same-sign flipped))
          (limit (select i32 (icmp_eq i32 (and i32 (lshr i32 a 31) 1) 1)
                              0x80000000 0x7fffffff)))
      (select i32 overflowed limit sum)))
  (defsem a64_uqadd_32 ((a i32) (b i32)) i32
    (let ((sum (add i32 a b)))
      (select i32 (icmp_ult i32 sum a) 0xffffffff sum)))
  (defsem a64_sqsub_32 ((a i32) (b i32)) i32
    (let ((diff (sub i32 a b))
          (opposite (icmp_ne i32 (and i32 (xor i32 a b) 0x80000000) 0))
          (flipped (icmp_ne i32 (and i32 (xor i32 a diff) 0x80000000) 0))
          (overflowed (and i32 opposite flipped))
          (limit (select i32 (icmp_eq i32 (and i32 (lshr i32 a 31) 1) 1)
                              0x80000000 0x7fffffff)))
      (select i32 overflowed limit diff)))
  (defsem a64_uqsub_32 ((a i32) (b i32)) i32
    (select i32 (icmp_ult i32 a b) 0 (sub i32 a b)))
  (defsem a64_sqadd_64 ((a i64) (b i64)) i64
    (let ((sum (add i64 a b))
          (same-sign (icmp_eq i64 (and i64 (xor i64 a b) 0x8000000000000000) 0))
          (flipped (icmp_ne i64 (and i64 (xor i64 a sum) 0x8000000000000000) 0))
          (overflowed (and i64 same-sign flipped))
          (limit (select i64 (icmp_eq i64 (and i64 (lshr i64 a 63) 1) 1)
                              0x8000000000000000 0x7fffffffffffffff)))
      (select i64 overflowed limit sum)))
  (defsem a64_uqadd_64 ((a i64) (b i64)) i64
    (let ((sum (add i64 a b)))
      (select i64 (icmp_ult i64 sum a) 0xffffffffffffffff sum)))
  (defsem a64_sqsub_64 ((a i64) (b i64)) i64
    (let ((diff (sub i64 a b))
          (opposite (icmp_ne i64 (and i64 (xor i64 a b) 0x8000000000000000) 0))
          (flipped (icmp_ne i64 (and i64 (xor i64 a diff) 0x8000000000000000) 0))
          (overflowed (and i64 opposite flipped))
          (limit (select i64 (icmp_eq i64 (and i64 (lshr i64 a 63) 1) 1)
                              0x8000000000000000 0x7fffffffffffffff)))
      (select i64 overflowed limit diff)))
  (defsem a64_uqsub_64 ((a i64) (b i64)) i64
    (select i64 (icmp_ult i64 a b) 0 (sub i64 a b)))

  ; --- SQADD/UQADD/SQSUB/UQSUB, SMULH/UMULH, SQDMULH/SQRDMULH (unpredicated) -
  (definstruction sqadd_z_b
    (mnemonic SQADD_Z_B) (isa sve) (category simd) (format SVE_INT_UNPRED)
    (encoding (hi 4) (size 0) (one 1) (op 4))
    (operands (zd vreg i8 out) (zn vreg i8 in) (zm vreg i8 in))
    (asm "sqadd_z_b $zd, $zn, $zm")
    (semantics "SQADD of every 8-bit element")
    (formal (vmap vni8 ((a zn) (b zm)) (a64_sqadd_8 a b)))
    (latency 3) (throughput 1.0)
