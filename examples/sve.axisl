  ; --- FLOGB: the base-2 exponent of each float element, as a signed integer --
  (definstruction flogb_h
    (mnemonic FLOGB_H) (isa sve) (category simd) (format SVE_F_UNARY)
    (encoding (hi 101) (size 0) (op 26) (op2 5))
    (operands (zd vreg i16 inout) (pg preg i16 in) (zn vreg i16 in))
    (asm "flogb_h $zd, $pg, $zn")
    (semantics "FLOGB: the unbiased exponent of each active 16-bit float; MIN for zero or NaN, MAX for infinity")
    (formal (vmerge vni16 (and vni16 pg 1) (vmap vni16 ((x zn)) (select i16 (icmp_eq i16 (and i16 (lshr i16 x 10) 31) 31) (select i16 (icmp_eq i16 (and i16 x 1023) 0) 0x7fff 0x8000) (select i16 (icmp_eq i16 (and i16 (lshr i16 x 10) 31) 0) (select i16 (icmp_eq i16 (and i16 x 1023) 0) 0x8000 (sub i16 (select i16 (icmp_uge i16 (and i16 x 1023) 512) 9 (select i16 (icmp_uge i16 (and i16 x 1023) 256) 8 (select i16 (icmp_uge i16 (and i16 x 1023) 128) 7 (select i16 (icmp_uge i16 (and i16 x 1023) 64) 6 (select i16 (icmp_uge i16 (and i16 x 1023) 32) 5 (select i16 (icmp_uge i16 (and i16 x 1023) 16) 4 (select i16 (icmp_uge i16 (and i16 x 1023) 8) 3 (select i16 (icmp_uge i16 (and i16 x 1023) 4) 2 (select i16 (icmp_uge i16 (and i16 x 1023) 2) 1 (select i16 (icmp_uge i16 (and i16 x 1023) 1) 0 0)))))))))) 24)) (sub i16 (and i16 (lshr i16 x 10) 31) 15)))) zd))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "FLOGB: the unbiased exponent of each active 16-bit float; MIN for zero or NaN, MAX for infinity"))

  (definstruction flogb_s
