  ; --- INDEX: element e is start + e * step, at the element width ------------
  (definstruction index_ii_b
    (mnemonic INDEX_II_B) (isa sve) (category simd) (format SVE_INDEX_II)
    (encoding (hi 4) (size 0) (one 1) (op 16))
    (operands (zd vreg i8 out) (start imm i5 in) (step imm i5 in))
    (asm "index_ii_b $zd, $start, $step")
    (semantics "INDEX over 8-bit elements: element e is start + e * step, wrapping at the element")
    (formal (add vni8 (vdup vni8 (sext i8 5 start)) (mul vni8 (vid vni8) (vdup vni8 (sext i8 5 step)))))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
