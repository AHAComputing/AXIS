  ; --- ADD/SUB (immediate): Zdn +- imm8, shifted left by 8 when sh is set --
  (definstruction add_i_b
    (mnemonic ADD_I_B) (isa sve) (category simd) (format SVE_ADDI_B)
    (encoding (hi 37) (size 0) (op 4) (opc 0) (op2 3) (sh 0))
