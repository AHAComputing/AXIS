    (semantics "The FFR from Pn")
    (formal (and vni8 pn 1))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "The FFR from Pn"))

  (definstruction rdffr
    (mnemonic RDFFR) (isa sve) (category simd) (format SVE_FFR_D)
