    (asm "shadd_m_b $zd, $pg, $zm")
    (semantics "SHADD of active 8-bit elements into Zdn; inactive unchanged")
    (formal (vmerge vni8 (and vni8 pg 1) (vmap vni8 ((a zd) (b zm)) (add i8 (add i8 (ashr i8 a 1) (ashr i8 b 1)) (and i8 (and i8 a b) 1))) zd))
