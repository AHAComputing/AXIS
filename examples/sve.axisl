  ; --- gathers and scatters: [Xn, Zm, (U|S)XTW|LSL #s] ------------------------
  (definstruction ld1w_gu
    (mnemonic LD1W_GU) (isa sve) (category custom) (format SVE_GATHER)
    (encoding (hi 1064) (op 2))
    (operands (zt vreg i32 out) (pg preg i32 in) (rn a64_gpr64sp i64 in) (zm vreg i32 in))
    (asm "ld1w_gu $zt, $pg, $rn, $zm")
    (semantics "LD1W: each active 32-bit element at Xn + UXTW(Zm); inactive zero")
    (behavior (when (ne (and vni32 pg 1) 0) (set zt (vload_indexed vni32 rn (shl i64 (zext i64 32 zm) 0)))) (when (eq (and vni32 pg 1) 0) (set zt 0)))
    (latency 6) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "LD1W: each active 32-bit element at Xn + UXTW(Zm); inactive zero"))

