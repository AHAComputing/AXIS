  ; --- WHILEGE/GT/HS/HI: counting down from the top element ----------------------
  (definstruction whilege_p_b
    (mnemonic WHILEGE_P_B) (isa sve) (category simd) (format SVE_WHILE)
    (encoding (hi 37) (size 0) (one 1) (op 4) (eq 0))
    (operands (pd preg i8 out) (rn a64_gpr64 i64 in) (rm a64_gpr64 i64 in))
    (asm "whilege_p_b $pd, $rn, $rm")
    (semantics "From the top element down, active while Xn - k against Xm holds (signed, >=); NZCV from the result")
    (behavior (set pd (vmerge vni8 (and i64 (vdup vni8 (icmp_sge i64 rn rm)) (icmp_uge i64 (vdup vni8 (sub i64 rn rm)) (sub i64 15 (zext i64 8 (vid vni8))))) 1 0)) (setstate nzcv (or i4 (or i4 (select i4 (icmp_ne i8 (vextract vni8 (vmerge vni8 (and i64 (vdup vni8 (icmp_sge i64 rn rm)) (icmp_uge i64 (vdup vni8 (sub i64 rn rm)) (sub i64 15 (zext i64 8 (vid vni8))))) 1 0) 0) 0) 8 0) (select i4 (icmp_eq i8 (vredor vni8 (vmerge vni8 (and i64 (vdup vni8 (icmp_sge i64 rn rm)) (icmp_uge i64 (vdup vni8 (sub i64 rn rm)) (sub i64 15 (zext i64 8 (vid vni8))))) 1 0)) 0) 4 0)) (select i4 (icmp_eq i8 (vlastb vni8 1 (vmerge vni8 (and i64 (vdup vni8 (icmp_sge i64 rn rm)) (icmp_uge i64 (vdup vni8 (sub i64 rn rm)) (sub i64 15 (zext i64 8 (vid vni8))))) 1 0)) 0) 2 0)) i4))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "From the top element down, active while Xn - k against Xm holds (signed, >=); NZCV from the result"))

  (definstruction whilege_p_h
    (mnemonic WHILEGE_P_H) (isa sve) (category simd) (format SVE_WHILE)
