  ; --- LDNF1 [Xn, #imm, MUL VL] and LDFF1 [Xn, Xm, LSL #s], every size ------
  (definstruction ldnf1_b
    (mnemonic LDNF1_B) (isa sve) (category custom) (format SVE_LD_SI)
    (encoding (hi 82) (dtype 0) (nf 1) (op 5))
    (operands (zt vreg i8 inout) (pg preg i8 in) (rn a64_gpr64sp i64 in) (imm imm i4 in) (ffr preg i8 inout (fixed 16)))
    (asm "ldnf1_b $zt, $pg, $rn, $imm")
    (semantics "LDNF1B: a non-fault load from [Xn + imm * VL]; an element that would fault is suppressed, and it and every element after keep Zt and clear the FFR")
    (behavior (when (ne (and vni8 (and vni8 (and vni8 ffr 1) (vmsbf vni8 (and vni8 (and vni8 pg 1) (xor vni8 (vinbounds vni8 (add i64 rn (mul i64 (sext i64 4 imm) 16)) mem_lo mem_hi) 1)))) (and vni8 pg 1)) 0) (set zt (vload vni8 (add i64 rn (mul i64 (sext i64 4 imm) 16))))) (when (ne (and vni8 (and vni8 (and vni8 ffr 1) (vmsbf vni8 (and vni8 (and vni8 pg 1) (xor vni8 (vinbounds vni8 (add i64 rn (mul i64 (sext i64 4 imm) 16)) mem_lo mem_hi) 1)))) (xor vni8 (and vni8 pg 1) 1)) 0) (set zt 0)) (set ffr (vmerge vni8 (and vni8 (and vni8 ffr 1) (vmsbf vni8 (and vni8 (and vni8 pg 1) (xor vni8 (vinbounds vni8 (add i64 rn (mul i64 (sext i64 4 imm) 16)) mem_lo mem_hi) 1)))) ffr 0)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "LDNF1B: a non-fault load from [Xn + imm * VL]; an element that would fault is suppressed, and it and every element after keep Zt and clear the FFR"))

  (definstruction ldff1_b
    (mnemonic LDFF1_B) (isa sve) (category custom) (format SVE_LD_SS)
