    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Pd from the FFR where Pg is active, inactive zero"))

  (definstruction rdffrs_z
    (mnemonic RDFFRS_Z) (isa sve) (category simd) (format SVE_FFR_GD)
