  ; --- SDOT/UDOT: four products of quarter-width elements, into Zda ------------
  (definstruction sdot_s
    (mnemonic SDOT_S) (isa sve) (category simd) (format SVE2_WIDE)
    (encoding (hi 68) (size 2) (zero 0) (op 0))
    (operands (zd vreg i32 inout) (zn vreg i32 in) (zm vreg i32 in))
    (asm "sdot_s $zd, $zn, $zm")
    (semantics "SDOT: Zda plus the dot product of each group of four 8-bit elements")
    (formal (vmap vni32 ((d zd) (a zn) (b zm)) (add i32 (add i32 (add i32 (add i32 d (mul i32 (sext i32 8 (lshr i32 a 0)) (sext i32 8 (lshr i32 b 0)))) (mul i32 (sext i32 8 (lshr i32 a 8)) (sext i32 8 (lshr i32 b 8)))) (mul i32 (sext i32 8 (lshr i32 a 16)) (sext i32 8 (lshr i32 b 16)))) (mul i32 (sext i32 8 (lshr i32 a 24)) (sext i32 8 (lshr i32 b 24))))))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "SDOT: Zda plus the dot product of each group of four 8-bit elements"))

