  ; --- CDOT: complex dot product, Zm rotated; CMLA: complex multiply-add -------
  (definstruction cdot0_s
    (mnemonic CDOT0_S) (isa sve) (category simd) (format SVE2_WIDE)
    (encoding (hi 68) (size 2) (zero 0) (op 4))
    (operands (zd vreg i32 inout) (zn vreg i32 in) (zm vreg i32 in))
