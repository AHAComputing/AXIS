  ; --- predicated, destructive: Zdn = Zdn op Zm where active --------------------
  (definstruction fadd_m_h
    (mnemonic FADD_M_H) (isa sve) (category simd) (format SVE_F_PRED)
    (encoding (hi 101) (size 1) (zero 0) (opc 0) (op 4))
