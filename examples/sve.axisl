    (asm "tbx_b $zd, $zn, $zm")
    (semantics "TBX: element i reads zn[zm[i]], or keeps Zd when that index is out of range")
    (formal (vmerge vni8 (icmp_ult vni8 zm (vdup vni8 16)) (vrgather vni8 zn zm) zd))
