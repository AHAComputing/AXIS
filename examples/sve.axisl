    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Destructive, as Arm's EXT is -- its source is the destination's own register, read as a separate operand because lane k reads element k+1 of it; described at the one immediate a static permute can take"))

