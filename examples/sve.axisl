    (asm "sxtb_h $zd, $pg, $zn")
    (semantics "SXTB: the low 8 bits of each active 16-bit element, extended")
    (formal (vmerge vni16 (and vni16 pg 1) (vmap vni16 ((a zn)) (sext i16 8 a)) zd))
