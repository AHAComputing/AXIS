(axis-module xzbb_test
  (version "1.0")
  (target rvmt)
  (description "Zbb-class operator coverage test")

  (definstruction andn
    (mnemonic ANDN)
    (category custom)
    (format R)
    (opcode 11)
    (func3 0)
    (func7 1)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (semantics "rd = rs1 & ~rs2")
    (formal (and i32 rs1 (not i32 rs2)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Zbb-class operator coverage for the AXIS semantic IR.")
  )

  (definstruction rolx
    (mnemonic ROLX)
    (category custom)
    (format R)
    (opcode 11)
    (func3 1)
    (func7 1)
    (operands
