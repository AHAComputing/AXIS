; Explicit rounding modes (stage F3 of docs/simd_fp_design.md).
;
; The rounding mode is the operator's first argument, a 2-bit value in AArch64's
; FPCR.RMode encoding: 00 nearest-even, 01 toward +infinity, 10 toward -infinity,
; 11 toward zero. Taking it as an argument rather than reading FPCR implicitly is
; what keeps the typed IR a function of its arguments; a real ISA instruction
; spells the state dependency in its behavior, as
;   (set fd (fadd_rm f64 (and (lshr fpcr 22) 3) fn fm))
; using operators the language already has.
;
; Proven on the golden model, SMT and C. Rust and LLVM decline these operators
; with the reason in the emitted file: neither can perform directed rounding
; without control of the floating-point environment, which one has no API for
; and the other cannot portably set from emitted IR. See section 8 of the design
; doc — that is a stated limit, not a silent round-to-nearest.
(axis-module fp_rounding
  (version "0.1.0")
  (target rvmt)
  (description "IEEE-754 arithmetic under an explicit rounding mode")

  (defisa fprm
    (base rv64im)
    (word-bits 64)
    (registers "f[32]:i64" "pc:i64")
    (features float custom)
    (memory-model rvwmo)
    (endianness little))

  (defformat FP_R
    (bits 32)
    (fields
      (opcode 6 0)
      (fd 11 7)
      (func3 14 12)
      (fn1 19 15)
      (fm 24 20)
      (rm 26 25)
      (func7 31 27)))

  (definstruction faddr_d
    (mnemonic FADDR_D) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 0) (func7 0)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "faddr_d $fd, $fn1, $fm, $rm")
    (semantics "Double-precision under the rounding mode in $rm")
    (formal (fadd_rm f64 rm fn1 fm))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Double-precision under the rounding mode in $rm"))

  (definstruction fsubr_d
    (mnemonic FSUBR_D) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 0) (func7 1)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "fsubr_d $fd, $fn1, $fm, $rm")
    (semantics "Double-precision under the rounding mode in $rm")
    (formal (fsub_rm f64 rm fn1 fm))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Double-precision under the rounding mode in $rm"))

  (definstruction fmulr_d
    (mnemonic FMULR_D) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 0) (func7 2)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "fmulr_d $fd, $fn1, $fm, $rm")
    (semantics "Double-precision under the rounding mode in $rm")
    (formal (fmul_rm f64 rm fn1 fm))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Double-precision under the rounding mode in $rm"))

  (definstruction fdivr_d
    (mnemonic FDIVR_D) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 0) (func7 3)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "fdivr_d $fd, $fn1, $fm, $rm")
    (semantics "Double-precision under the rounding mode in $rm")
    (formal (fdiv_rm f64 rm fn1 fm))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Double-precision under the rounding mode in $rm"))

  (definstruction fsqrtr_d
    (mnemonic FSQRTR_D) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 0) (func7 4) (encoding (fm 0))
    (operands (fd reg i64 out) (fn1 reg i64 in) (rm imm i2 in))
    (asm "fsqrtr_d $fd, $fn1, $rm")
    (semantics "Double-precision square root under the rounding mode in $rm")
    (formal (fsqrt_rm f64 rm fn1))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Double-precision square root under the rounding mode in $rm"))

  (definstruction faddr_s
    (mnemonic FADDR_S) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 1) (func7 0)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "faddr_s $fd, $fn1, $fm, $rm")
    (semantics "Single-precision under the rounding mode in $rm")
    (formal (zext i64 32 (fadd_rm f32 rm fn1 fm)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Single-precision under the rounding mode in $rm"))

  (definstruction fsubr_s
    (mnemonic FSUBR_S) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 1) (func7 1)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "fsubr_s $fd, $fn1, $fm, $rm")
    (semantics "Single-precision under the rounding mode in $rm")
    (formal (zext i64 32 (fsub_rm f32 rm fn1 fm)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Single-precision under the rounding mode in $rm"))

  (definstruction fmulr_s
    (mnemonic FMULR_S) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 1) (func7 2)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "fmulr_s $fd, $fn1, $fm, $rm")
    (semantics "Single-precision under the rounding mode in $rm")
    (formal (zext i64 32 (fmul_rm f32 rm fn1 fm)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Single-precision under the rounding mode in $rm"))

  (definstruction fdivr_s
    (mnemonic FDIVR_S) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 1) (func7 3)
    (operands (fd reg i64 out) (fn1 reg i64 in) (fm reg i64 in) (rm imm i2 in))
    (asm "fdivr_s $fd, $fn1, $fm, $rm")
    (semantics "Single-precision under the rounding mode in $rm")
    (formal (zext i64 32 (fdiv_rm f32 rm fn1 fm)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Single-precision under the rounding mode in $rm"))

  (definstruction fsqrtr_s
    (mnemonic FSQRTR_S) (isa fprm) (category custom) (format FP_R)
    (opcode 11) (func3 1) (func7 4) (encoding (fm 0))
    (operands (fd reg i64 out) (fn1 reg i64 in) (rm imm i2 in))
    (asm "fsqrtr_s $fd, $fn1, $rm")
    (semantics "Single-precision square root under the rounding mode in $rm")
    (formal (zext i64 32 (fsqrt_rm f32 rm fn1)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 5000.0) (power-estimate-mw 8.0) (expected-speedup 1.0)
    (rationale "Single-precision square root under the rounding mode in $rm"))
)
