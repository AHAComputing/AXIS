(axis-module xpce_field
  (version "1.0")
  (target rvmt)
  (description "PCE-field personality example (capsule stage P1)")

  (defisa rv32_axis
    (base rv32im)
    (word-bits 32)
    (registers "x[32]:i32" "pc:i32")
    (features m custom)
    (memory-model rvwmo)
    (endianness little)
  )

  (definstruction fma_i
    (mnemonic FMA_I)
    (description "Integer fused multiply-add.")
    (category arithmetic)
    (format R4)
    (opcode 11)
    (func3 3)
    (func7 0)
    (encoding (func2 0))
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
      (rs3 reg i32 in)
    )
    (asm "fma_i $rd, $rs1, $rs2, $rs3")
    (semantics "rd = rs1 * rs2 + rs3")
    (formal (add i32 (mul i32 rs1 rs2) rs3))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Pure op exercised by the migration round-trip harness.")
  )

  (definstruction xorshift
    (mnemonic XORSHIFT)
    (description "xor with a left-shifted source, a second pure op for programs.")
    (category arithmetic)
    (format R)
    (opcode 11)
    (func3 4)
    (func7 0)
    (operands
      (rd reg i32 out)
      (rs1 reg i32 in)
      (rs2 reg i32 in)
    )
    (asm "xorshift $rd, $rs1, $rs2")
    (semantics "rd = rs1 ^ (rs2 << 1)")
    (formal (xor i32 rs1 (shl i32 rs2 2)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Gives migration programs a second opcode so schedules interleave.")
  )

  (defpersonality scalar1
    (implements rv32_axis)
    (discipline independent (threads 1))
    (capsule "x[32]" "pc")
    (description "single-thread scalar personality")
  )

  (defpersonality simt8
    (implements rv32_axis)
    (discipline lockstep (lanes 8))
    (capsule "x[32]" "pc")
    (description "8-lane lockstep SIMT personality (same capsule as scalar1)")
  )

  (defcore pce_tile0
    (kind rvmt)
    (threads 8)
    (implements rv32_axis)
  )
)
