    (front-end (fetch-width 4) (depth 4) (icache l1i))
    (units
      (alu (count 8) (pipelined true))
      (mul (count 1) (pipelined true))
      (br (count 1) (pipelined true))
      (lsu (count 4) (pipelined true)))
    (timing (micro-ops (IWLA (lsu 2) (alu 1)))))

