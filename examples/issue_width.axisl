      (br (count 1) (pipelined true))
      (lsu (count 2) (pipelined true))))

  ; ⚠️ TRANSLATION BUFFERS (docs/tlb_design.md): a machine remembers only so
  ; many pages. Timing, not translation -- addresses stay the program's. A
  ; first-level hit is in the instruction's latency; a page only the second
  ; level holds costs its latency; a page nothing holds costs the walk too.
  ; `tools/tlb_check.py` builds its own machines; this one is here so the
  ; clause is printed and read back with every other.
  (defcore xpages
    (kind rvmt)
    (implements iw32)
    (issue-width 4)
    (window (rob 32) (issue-queue 32) (commit-width 4))
    (branch (penalty 0) (predictor bimodal) (entries 64))
    (front-end (fetch-width 4) (depth 2))
    (engine execute)
    (tlb (data (entries 16) (ways 4)) (fetch (entries 8))
         (second (entries 64) (ways 4) (latency 3))
         (page-bytes 4096) (walk-cycles 20))
    (units
      (alu (count 4) (pipelined true))
      (mul (count 1) (pipelined true))
      (br (count 1) (pipelined true))
      (lsu (count 1) (pipelined true))))

  (definstruction iwbnz
    (mnemonic IWBNZ)
    (isa iw32)
    (category custom)
    (format B)
    (opcode 0x4b)
    (func3 0)
    (unit br)
    (operands
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "iwbnz $rs1, $rs2, $imm")
    (semantics "Branch when rs1 is not equal rs2")
    (behavior
      (when (icmp_ne rs1 rs2) (setpc (add i32 pc (sext i32 13 imm)))))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 800.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Branch when rs1 is not equal rs2"))

  (definstruction iwadd
    (mnemonic IWADD)
    (isa iw32)
    (category custom)
    (format R)
    (opcode 0x0b)
    (unit alu)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in))
    (asm "iwadd $rd, $rs1, $rs2")
    (semantics "Add, on the adder")
    (formal (add i32 rs1 rs2))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 500.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Add, on the adder"))

  (definstruction iwmul
    (mnemonic IWMUL)
    (isa iw32)
    (category custom)
    (format R)
    (opcode 0x2b)
    (unit mul)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in))
    (asm "iwmul $rd, $rs1, $rs2")
    (semantics "Multiply, on the multiplier")
    (formal (mul i32 rs1 rs2))
    (latency 3)
    (throughput 1.0)
    (area-estimate-um2 4000.0)
    (power-estimate-mw 4.0)
    (expected-speedup 1.0)
    (rationale "Multiply, on the multiplier"))
  ; A load and a store, so a machine has memory traffic to order. Both issue
  ; to `lsu`; what each MEANS is the same on every core above.
  (definstruction iwlw
    (mnemonic IWLW)
    (isa iw32)
    (category custom)
    (format I)
    (opcode 0x5b)
    (func3 2)
    (unit lsu)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "iwlw $rd, $imm($rs1)")
    (semantics "Load a 32-bit word")
    (behavior
      (set rd (load i32 signed (add i32 rs1 (sext i32 12 imm)))))
    (latency 2)
    (throughput 1.0)
    (area-estimate-um2 900.0)
    (power-estimate-mw 1.5)
    (expected-speedup 1.0)
    (rationale "Load a 32-bit word"))

  (definstruction iwsw
    (mnemonic IWSW)
    (isa iw32)
    (category custom)
    (format S)
    (opcode 0x7b)
    (func3 2)
    (unit lsu)
    (operands
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "iwsw $rs2, $imm($rs1)")
    (semantics "Store a 32-bit word")
    (behavior
      (store (add i32 rs1 (sext i32 12 imm)) rs2 i32))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 900.0)
    (power-estimate-mw 1.5)
    (expected-speedup 1.0)
    (rationale "Store a 32-bit word"))

  ; ⚠️ An INDIRECT jump, whose target is a register's value rather than a
  ; field of the word. A branch target buffer predicts the target a branch
  ; went to last time; for a direct branch that never changes, so without an
  ; instruction like this a buffer that ignored the target it stored looked
  ; right -- mutation testing said so.
  (definstruction iwjr
    (mnemonic IWJR)
    (isa iw32)
    (category custom)
    (format I)
    (opcode 0x6b)
    (func3 0)
    (unit br)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (imm imm i32 in))
    (asm "iwjr $rd, $rs1, $imm")
    (semantics "Jump to rs1 plus offset, and link")
    (behavior
      (setpc (and i32 (add i32 rs1 (sext i32 12 imm)) 0xfffffffe))
      (set rd (add i32 pc 4)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 600.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Jump to rs1 plus offset, and link"))

  ; ⚠️ A DIRECT jump, unconditional (D1): its target is its own address plus a
  ; field of the word, so decode knows where it goes without a predictor and
  ; without a register. Every other jump here either asks a predictor (IWBNZ)
  ; or reads a register (IWJR), and a front end that waited for a direct jump
  ; to execute looked no different from one that did not.
  (definstruction iwj
    (mnemonic IWJ)
    (isa iw32)
    (category custom)
    (format J)
    (opcode 0x3b)
    (unit br)
    (operands
      (rd rv_gpr i32 out)
      (imm imm i32 in))
    (asm "iwj $rd, $imm")
    (semantics "Jump to pc plus offset, and link")
    (behavior
      (setpc (add i32 pc (sext i32 21 imm)))
      (set rd (add i32 pc 4)))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 600.0)
    (power-estimate-mw 1.0)
    (expected-speedup 1.0)
    (rationale "Jump to pc plus offset, and link"))

  ; ⚠️ TWO INSTRUCTIONS A CORE MAY CRACK (docs/micro_ops_design.md). A load
  ; whose result is ADDED to a register -- a load and then an add, to a
  ; machine that has no adder behind its load unit -- and a load that moves
  ; its base on afterwards, whose new base depends on no memory at all and so
  ; should be ready long before what was loaded is. Uncracked, each is one
  ; operation on the load unit, as every instruction here was.
  (definstruction iwla
    (mnemonic IWLA)
    (isa iw32)
    (category custom)
    (format R)
    (opcode 0x1b)
    (unit lsu)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 in)
      (rs2 rv_gpr i32 in))
    (asm "iwla $rd, $rs2, ($rs1)")
    (semantics "Load a 32-bit word and add a register to it")
    (behavior
      (set rd (add i32 rs2 (load i32 signed rs1))))
    (latency 3)
    (throughput 1.0)
    (area-estimate-um2 2600.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Load a 32-bit word and add a register to it"))

  (definstruction iwlp
    (mnemonic IWLP)
    (isa iw32)
    (category custom)
    (format I)
    (opcode 0x5b)
    (func3 3)
    (unit lsu)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 inout)
      (imm imm i32 in))
    (asm "iwlp $rd, ($rs1), $imm")
    (semantics "Load a 32-bit word, then move the base on")
    (behavior
      (set rd (load i32 signed rs1))
      (set rs1 (add i32 rs1 (sext i32 12 imm))))
    (latency 2)
    (throughput 1.0)
    (area-estimate-um2 2600.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Load a 32-bit word, then move the base on"))

  ; A load that moves its base on by a REGISTER: the one cracked instruction
  ; here whose second micro-op can be kept waiting -- for that register --
  ; long after its first has finished, with what the first loaded already in
  ; use. An instruction retired in pieces is caught there and nowhere else.
  (definstruction iwlx
    (mnemonic IWLX)
    (isa iw32)
    (category custom)
    (format R)
    (opcode 0x1f)
    (unit lsu)
    (operands
      (rd rv_gpr i32 out)
      (rs1 rv_gpr i32 inout)
      (rs2 rv_gpr i32 in))
    (asm "iwlx $rd, ($rs1), $rs2")
    (semantics "Load a 32-bit word, then move the base on by a register")
    (behavior
      (set rd (load i32 signed rs1))
      (set rs1 (add i32 rs1 rs2)))
    (latency 2)
    (throughput 1.0)
    (area-estimate-um2 2600.0)
    (power-estimate-mw 3.0)
    (expected-speedup 1.0)
    (rationale "Load a 32-bit word, then move the base on by a register"))

  ; ⚠️ A TRAP, so an execution-driven core has an exception to take
  ; precisely: at commit, never on a wrong path, and never mistaken for the
  ; pipeline computing something wrong.
  (definstruction iwtrap
    (mnemonic IWTRAP)
    (isa iw32)
    (category custom)
    (format I)
    (opcode 0x73)
    (func3 0)
    (encoding (rd 0) (rs1 0) (imm 0))
    (operands)
    (asm "iwtrap")
    (semantics "Trap to the host")
    (behavior
      (trap ecall))
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Trap to the host")))
