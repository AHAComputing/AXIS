    (kind rvmt)
    (implements iw32)
    (memory l1d)
    (issue-width 4)
    (window (rob 32) (issue-queue 32) (commit-width 4))
    (branch (penalty 0))
    (units
      (alu (count 4) (pipelined true))
      (mul (count 1) (pipelined true))
      (br (count 1) (pipelined true))
      (lsu (count 4) (pipelined true)))
    (timing (micro-ops (IWLA (lsu 2) (alu 1)) (IWLP (lsu 2) (alu 1)) (IWLX (lsu 2) (alu 1)))))

