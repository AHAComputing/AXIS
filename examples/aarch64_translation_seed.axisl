    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "xtn $rd, $rn, arrangement $size")
    (semantics "Truncate each wide lane into the lower half, the upper cleared")
    (formal
      (select i128 (icmp_eq i2 size 0)
