  ; ⚠️ WIDENING BY ELEMENT, which combines two shapes already in this file. The
  ; destination lane is twice the source lane, so the `vmap` runs at the
  ; DESTINATION shape and the narrow source is taken apart inside the body --
  ; the container arithmetic SHLL2 introduced: destination lane i reads narrow
  ; lane i + n/2 of `rn`, which is half of container i/2 + n/4, and `lane-index
  ; & 1` says which half. And the element of `rm` is an operand, so each index
  ; value is its own arm, as for the non-widening forms -- but there the choice
  ; of container and half is a CONSTANT per arm and is made here, not in the
  ; body.
  ;
  ; With `Q = 1` these are the `2` forms: they read the UPPER half of `rn`. The
  ; saturating accumulates reuse the saturating add and subtract already stated
  ; once above; the doubling product itself overflows only when both operands
  ; are the most negative value, which is named rather than derived.

  (definstruction smull2_elem_h
    (mnemonic SMULL2_ELEM_H) (isa aarch64_base) (category float)
    (format A64_SIMD_ELEM_H)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 15) (size 1) (opcode 10) (zero10 0))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (index imm i3 in)
    )
    (asm "smull2 $rd, $rn, $rm, element $index")
    (semantics "Signed widening multiply of the upper half by the indexed element, 16-bit elements into 32-bit lanes")
    (formal
      (select i128 (icmp_eq i3 index 0) (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 0)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (and i32 bc 0xffff)))
                  (p (mul i32 a b)))
                p))
          (select i128 (icmp_eq i3 index 1) (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 0)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (lshr i32 bc 16)))
                  (p (mul i32 a b)))
                p))
          (select i128 (icmp_eq i3 index 2) (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 1)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (and i32 bc 0xffff)))
                  (p (mul i32 a b)))
                p))
          (select i128 (icmp_eq i3 index 3) (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 1)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (lshr i32 bc 16)))
                  (p (mul i32 a b)))
                p))
          (select i128 (icmp_eq i3 index 4) (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 2)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (and i32 bc 0xffff)))
                  (p (mul i32 a b)))
                p))
          (select i128 (icmp_eq i3 index 5) (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 2)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (lshr i32 bc 16)))
                  (p (mul i32 a b)))
                p))
          (select i128 (icmp_eq i3 index 6) (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 3)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (and i32 bc 0xffff)))
                  (p (mul i32 a b)))
                p))
          (vmap v4i32 ((ac (lane rn (+ (/ lane-index 2) 2))) (bc (lane rm 3)))
               (let ((araw (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                   (and i32 ac 0xffff) (lshr i32 ac 16)))
                  (a (sext i32 16 araw))
                  (b (sext i32 16 (lshr i32 bc 16)))
                  (p (mul i32 a b)))
                p))))))))))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The upper half of rn widened against one element of rm; Q=1 is what makes it the 2 form"))

