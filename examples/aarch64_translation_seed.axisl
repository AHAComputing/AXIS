  ; ⚠️ MULTIPLY, where the encoding says more than the semantics do. MUL is a
  ; lane-local atom and its three formals are one line each; what they could
  ; not say before is that `size = 3` is unallocated -- there is no 64-bit
  ; lanewise multiply, and a decoder answering MUL for that pattern would be
  ; inventing an instruction. MLA and MLS accumulate into `rd`, which is an
  ; `inout` operand and a nested lane-parallel expression, nothing more: the
  ; expansion recurses, so the inner multiply is masked to its lane before the
  ; outer add ever sees it.

  (definstruction mul_v
    (mnemonic MUL_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 19) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "mul $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise multiply, bytes through words")
    (formal
      (select i128 (icmp_eq i2 size 0) (mul v16i8 rn rm)
      (select i128 (icmp_eq i2 size 1) (mul v8i16 rn rm)
        (mul v4i32 rn rm))))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The multiply a compiler reaches for, and the size it cannot encode"))

