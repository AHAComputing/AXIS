  ; --- Scalar floating point, which is what reads FPCR and writes FPSR ------
  ;
  ; The corpus declared both registers and gave MRS/MSR to read and write them,
  ; and had no floating-point arithmetic at all: a mode register nothing
  ; consulted and a flag register nothing set. These five close that, in the
  ; corpus where the registers actually live.
  ;
  ; Two things are worth noticing in the behaviors below. The rounding mode is
  ; an ordinary expression over FPCR, so no operator here knows what an FPCR is.
  ; And the mode field is two bits, so every value of it names a direction --
  ; there is no trap arm, where RISC-V's three-bit `frm` has two reserved values
  ; and its dynamic forms must trap on them.
  (definstruction-family a64-fp-dp2
    ($name $mnemonic $fpop $op $fx $asm $why)
    (
     (fadd_d FADD_D 10 fadd_rm fadd_fx "fadd $rd, $rn, $rm" "The witness that FPCR is read at all")
     (fsub_d FSUB_D 14 fsub_rm fsub_fx "fsub $rd, $rn, $rm" "Infinity minus itself, which is where invalid reaches IOC")
     (fmul_d FMUL_D 2 fmul_rm fmul_fx "fmul $rd, $rn, $rm" "Overflow and underflow, either side of the reversal")
     (fdiv_d FDIV_D 6 fdiv_rm fdiv_fx "fdiv $rd, $rn, $rm" "The only shape that reaches DZC"))
    (definstruction $name
      (mnemonic $mnemonic) (isa aarch64_base) (category float)
      (format A64_FP_DP2)
      (opcode 0) (func3 0) (func7 0)
      (encoding (fixed 243) (fpop $fpop))
      (operands (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in) (rm a64_vreg64 i64 in))
      (asm $asm)
      (semantics "Double arithmetic in FPCR's direction, accruing FPSR")
      (behavior
        (set rd ($op f64 (a64_rmode fpcr) rn rm))
        (setstate fpsr (or i32 fpsr (a64_fpsr_bits ($fx f64 rn rm))) i32))
      (latency 4) (throughput 1.0)
      (area-estimate-um2 8000.0) (power-estimate-mw 9.0) (expected-speedup 1.0)
      (rationale $why)))

  (definstruction fsqrt_d
    (mnemonic FSQRT_D) (isa aarch64_base) (category float)
    (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 112))
