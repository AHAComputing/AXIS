    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (immhb imm i7 in)
    )
    (requires (> immhb 7))
    (asm "sshr $rd, $rn, shift $immhb")
    (semantics "Signed shift right by immediate")
    (formal
      (select i128 (icmp_ult i7 immhb 16) (vmap v16i8 ((a rn))
                 (let ((n (sub i16 16 (zext i16 7 immhb))))
                   (sra i16 (sext i16 8 a) n)))
        (select i128 (icmp_ult i7 immhb 32) (vmap v8i16 ((a rn))
                 (let ((n (sub i32 32 (zext i32 7 immhb))))
                   (sra i32 (sext i32 16 a) n)))
          (select i128 (icmp_ult i7 immhb 64) (vmap v4i32 ((a rn))
                 (let ((n (sub i64 64 (zext i64 7 immhb))))
                   (sra i64 (sext i64 32 a) n)))
            (vmap v2i64 ((a rn))
                 (let ((n (sub i128 128 (zext i128 7 immhb))))
                   (sra i128 (sext i128 64 a) n)))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The arithmetic shift, filling with the sign"))

