  ; ⚠️ HALVING ARITHMETIC, where the answer is the one an infinitely wide adder
  ; would give. SHADD is (a + b) >> 1 -- but the sum of two full-width lanes
  ; does not fit in a lane, so a wrapping add followed by a shift computes the
  ; wrong thing for exactly the inputs that matter.
  ;
  ; A lane body may evaluate at ANY width, not only its lane's, so these say
  ; what they mean: add at twice the lane width, then halve. The expansion's
  ; own mask is what puts the result back in the lane, and that containment is
  ; the property the lane gate proves over every input -- a body computing
  ; wider than its lane must not disturb its neighbour. Written as the bit
  ; identity instead -- `(a & b) + ((a ^ b) >> 1)` -- it would be correct and
  ; unreadable, and a reader could not check it against ARM's one line.
  ;
  ; The rounding forms add one before halving, which is the whole difference,
  ; and the signed forms sign-extend first so `sra` sees a real sign. `size = 3`
  ; is unallocated for all six: there is no 64-bit halving add.

  (definstruction shadd_v
    (mnemonic SHADD_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 0) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "shadd $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise signed halving add, rounding toward negative infinity")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn) (b rm))
                     (sra i16 (add i16 (sext i16 8 a) (sext i16 8 b)) 1))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn) (b rm))
                     (sra i32 (add i32 (sext i32 16 a) (sext i32 16 b)) 1))
        (vmap v4i32 ((a rn) (b rm))
                     (sra i64 (add i64 (sext i64 32 a) (sext i64 32 b)) 1)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The average of two lanes without the overflow an ordinary add would have"))

  (definstruction uhadd_v
    (mnemonic UHADD_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (one21 1) (opcode 0) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "uhadd $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise unsigned halving add")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn) (b rm))
                     (lshr i16 (add i16 a b) 1))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn) (b rm))
                     (lshr i32 (add i32 a b) 1))
        (vmap v4i32 ((a rn) (b rm))
                     (lshr i64 (add i64 a b) 1)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The U bit is the whole difference, as it is for every pair in this group"))

  (definstruction srhadd_v
    (mnemonic SRHADD_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 2) (one10 1))
