  ; ⚠️ THE FLOATING-POINT COMPARISONS AGAINST ZERO, and the two sign
  ; operations. Zero is written as the literal 0, which is the bit pattern of
  ; +0.0 -- and that is not a shortcut: IEEE says -0.0 compares EQUAL to +0.0,
  ; so every one of these five treats both zeros alike without having to say
  ; so. FCMEQ against zero answers all-ones for a negative zero, which is what
  ; the hardware does and what a naive integer comparison against 0 would get
  ; wrong.
  ;
  ; FABS and FNEG are not arithmetic at all. Clearing the sign bit is the
  ; absolute value of an IEEE float including its NaNs and infinities, and
  ; flipping it is the negation -- which is why neither needs a floating-point
  ; operator, and why both are exact for every input including the ones
  ; arithmetic would trap on.

  (definstruction fcmgt_zero_v
    (mnemonic FCMGT_ZERO_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 1) (fixed21 16) (opcode 12) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (sz imm i1 in)
    )
    (asm "fcmgt $rd, $rn, arrangement $sz")
    (semantics "All-ones in each lane greater than zero")
    (formal
      (select i128 (icmp_eq i1 sz 0) (vmap v4f32 ((a rn))
                 (mul i32 (fcmp_olt f32 0 a) 0xffffffff))
        (vmap v2f64 ((a rn))
                 (mul i64 (fcmp_olt f64 0 a) 0xffffffffffffffff))))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Zero on the left of an ordered less-than is how greater-than is spelled"))

  (definstruction fcmeq_zero_v
    (mnemonic FCMEQ_ZERO_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 1) (fixed21 16) (opcode 13) (fixed11 2))
