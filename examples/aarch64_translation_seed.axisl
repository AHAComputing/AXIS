  ; ⚠️ FSQRT, which is a lane-parallel atom and therefore one line. It is the
  ; only exactly-defined floating-point function in this half of the format:
  ; IEEE specifies a correctly-rounded square root, where the two ESTIMATE
  ; instructions next to it -- FRECPE and FRSQRTE at opcode 29 -- are defined
  ; by a table and deliberately are not.
  (definstruction fsqrt_v
    (mnemonic FSQRT_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed23 1) (fixed21 16) (opcode 31) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (sz imm i1 in)
    )
    (asm "fsqrt $rd, $rn, arrangement $sz")
    (semantics "Lanewise floating-point square root, correctly rounded")
    (formal
      (select i128 (icmp_eq i1 sz 0) (fsqrt v4f32 rn)
        (fsqrt v2f64 rn)))
    (latency 12) (throughput 0.25)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The one exactly-specified function here, beside two that are estimates"))

  ; ⚠️ THE ESTIMATE INSTRUCTIONS, which look like table lookups and are not.
  ; ARM specifies FRECPE and friends through a 256-entry table, and that table
  ; is itself specified by a formula -- `RecipEstimate(a) = ((2^19 DIV (2a+1))
  ; + 1) DIV 2` over `256 <= a < 512` -- so the "table" is a closed form and
  ; the description can be the formula rather than 256 constants. Checked
  ; EXHAUSTIVELY against the silicon over all 512 values the index can take,
  ; which is every answer the table has.
  ;
  ; URECPE is the whole construction with no floating point anywhere: the top
  ; nine bits are the index, the estimate is nine bits, and it goes back in the
  ; top. An operand below one half has no estimate in range and answers
  ; all-ones -- which is the saturation, not an error.
  ;
  ; `sz` must be zero. There is no 64-bit unsigned reciprocal estimate.
  (definstruction urecpe_v
    (mnemonic URECPE_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 1) (fixed21 16) (opcode 28) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (sz imm i1 in)
    )
    (requires (= sz 0))
    (asm "urecpe $rd, $rn, arrangement $sz")
    (semantics "Unsigned reciprocal estimate of each 32-bit lane")
    (formal
      (vmap v4i32 ((a rn))
        (let ((index (lshr i32 a 23))
              (odd (add i32 (mul i32 index 2) 1))
              (quotient (udiv i32 0x80000 odd))
              (estimate (lshr i32 (add i32 quotient 1) 1)))
          (select i32 (icmp_ult i32 a 0x80000000) 0xffffffff
                      (shl i32 estimate 23)))))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A table ARM specifies by a formula, so the description is the formula"))

  ; ⚠️ URSQRTE, whose table ARM specifies with a SEARCH rather than a formula:
  ; the smallest m past 512 with `a * m * m >= 2^28`, and the estimate is m
  ; halved. A search is not an expression, but the thing it searches for is --
  ; m is the ceiling of the square root of 2^28 / a, and a square root is
  ; available.
  ;
  ; So the body computes that root in DOUBLE and then CORRECTS IT EXACTLY. The
  ; approximation only has to land within one of the answer; four candidates
  ; are then tested with integer multiplication, which is exact because
  ; `a * m * m` stays under 2^39. The floating-point step chooses where to
  ; look and the integer step decides, so no rounding of the root can make the
  ; answer wrong -- only slower to find, and it is not searching.
  ;
  ; Two bits decide the saturation here rather than one: an operand below a
  ; quarter has no estimate in range.
  (definstruction ursqrte_v
    (mnemonic URSQRTE_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed23 1) (fixed21 16) (opcode 28) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (sz imm i1 in)
    )
    (requires (= sz 0))
    (asm "ursqrte $rd, $rn, arrangement $sz")
    (semantics "Unsigned reciprocal square-root estimate of each 32-bit lane")
    (formal
      (vmap v4i32 ((a rn))
        (let ((index (lshr i32 a 23))
              (below-half (icmp_ult i32 index 256))
              (base (select i64 below-half
                            (add i64 (mul i64 index 2) 1)
                            (mul i64 (add i64 (and i64 index 0x1fe) 1) 2)))
              (root (fsqrt f64 (fdiv f64 0x41b0000000000000 (fcvt_u2f f64 64 base))))
              (guess (fcvt_f2u i64 64 root))
              (start (maxu i64 513 (sub i64 guess 1)))
              (c1 (add i64 start 1))
              (c2 (add i64 start 2))
              (fits0 (icmp_uge i64 (mul i64 (mul i64 base start) start) 0x10000000))
              (fits1 (icmp_uge i64 (mul i64 (mul i64 base c1) c1) 0x10000000))
              (fits2 (icmp_uge i64 (mul i64 (mul i64 base c2) c2) 0x10000000))
              (m (select i64 fits0 start
                   (select i64 fits1 c1
                     (select i64 fits2 c2 (add i64 start 3)))))
              (estimate (lshr i64 m 1)))
          (select i32 (icmp_ult i32 a 0x40000000) 0xffffffff
                      (shl i32 estimate 23)))))
    (latency 6) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A search ARM writes as a loop, said as the value the loop finds"))

  ; ⚠️ THE FLOATING-POINT ESTIMATES, which are the integer ones with an
  ; exponent wrapped around them. The table is the same closed form URECPE
  ; uses; what these add is unpacking a float and putting one back together.
  ;
  ; Three details are where a plausible description goes wrong, and each was
  ; the silicon correcting me rather than the pseudocode convincing me:
  ;
  ;   * a NaN is REPLACED by the default NaN, because this corpus is
  ;     FPCR.DN=1. The silicon runs with DN=0 and QUIETS the operand instead,
  ;     keeping its payload -- which is what this said, and what the checks
  ;     against the silicon enforced, before the corpus chose a NaN policy;
  ;   * there is no flush to zero. A large operand's reciprocal is a
  ;     SUBNORMAL, produced by the `result-exp` of zero and minus-one arms,
  ;     and flushing it lost 1534 more;
  ;   * FRSQRTE's subnormal normalisation shifts once more after the loop
  ;     WITHOUT decrementing the exponent again -- an off-by-one that moved
  ;     every subnormal answer.
  ;
  ; The normalisation loop itself is `clz`: shifting until the leading bit is
  ; set is counting the zeros in front of it, which is an operator rather than
  ; a loop.

  (definstruction frecpe_v
    (mnemonic FRECPE_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 1) (fixed21 16) (opcode 29) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (sz imm i1 in)
    )
    (asm "frecpe $rd, $rn, arrangement $sz")
    (semantics "Reciprocal estimate of each lane")
    (formal
      (select i128 (icmp_eq i1 sz 0)
        (vmap v4f32 ((a rn))
          (let ((sign (and i32 a 0x80000000))
              (exponent (and i32 (lshr i32 a 23) 0xff))
              (frac (and i32 a 0x7fffff))
              (nan-or-inf (icmp_eq i32 exponent 0xff))
              (is-nan (and i32 nan-or-inf (icmp_ne i32 frac 0)))
              (subnormal (icmp_eq i32 exponent 0))
              (tiny (and i32 subnormal (icmp_ult i32 frac 0x200000)))
              (leading (icmp_ne i32 (and i32 frac 0x400000) 0))
              (e (select i32 subnormal (select i32 leading 0 0xffffffff) exponent))
              (f (select i32 subnormal
                         (select i32 leading (and i32 (shl i32 frac 1) 0x7fffff)
                                              (and i32 (shl i32 frac 2) 0x7fffff))
                         frac))
              (scaled (or i32 0x100 (lshr i32 f 15)))
              (odd (add i32 (mul i32 scaled 2) 1))
              (estimate (lshr i32 (add i32 (udiv i32 0x80000 odd) 1) 1))
              (result-exp (sub i32 253 e))
              (placed (shl i32 (and i32 estimate 0xff) 15))
              (fraction (select i32 (icmp_eq i32 result-exp 0)
                                (or i32 0x400000 (lshr i32 placed 1))
                          (select i32 (icmp_eq i32 result-exp 0xffffffff)
                                (or i32 0x200000 (lshr i32 placed 2)) placed)))
              (biased (select i32 (icmp_eq i32 result-exp 0xffffffff) 0 result-exp))
              (normal (or i32 sign (or i32 (shl i32 (and i32 biased 0xff) 23)
                                             (and i32 fraction 0x7fffff)))))
          (select i32 is-nan 0x7fc00000
            (select i32 nan-or-inf sign
              (select i32 tiny (or i32 sign 0x7f800000)
                normal)))))
        (vmap v2f64 ((a rn))
          (let ((sign (and i64 a 0x8000000000000000))
              (exponent (and i64 (lshr i64 a 52) 0x7ff))
              (frac (and i64 a 0xfffffffffffff))
              (nan-or-inf (icmp_eq i64 exponent 0x7ff))
              (is-nan (and i64 nan-or-inf (icmp_ne i64 frac 0)))
              (subnormal (icmp_eq i64 exponent 0))
              (tiny (and i64 subnormal (icmp_ult i64 frac 0x4000000000000)))
              (leading (icmp_ne i64 (and i64 frac 0x8000000000000) 0))
              (e (select i64 subnormal (select i64 leading 0 0xffffffffffffffff) exponent))
              (f (select i64 subnormal
                         (select i64 leading (and i64 (shl i64 frac 1) 0xfffffffffffff)
                                              (and i64 (shl i64 frac 2) 0xfffffffffffff))
                         frac))
              (scaled (or i64 0x100 (lshr i64 f 44)))
              (odd (add i64 (mul i64 scaled 2) 1))
              (estimate (lshr i64 (add i64 (udiv i64 0x80000 odd) 1) 1))
              (result-exp (sub i64 2045 e))
              (placed (shl i64 (and i64 estimate 0xff) 44))
              (fraction (select i64 (icmp_eq i64 result-exp 0)
                                (or i64 0x8000000000000 (lshr i64 placed 1))
                          (select i64 (icmp_eq i64 result-exp 0xffffffffffffffff)
                                (or i64 0x4000000000000 (lshr i64 placed 2)) placed)))
              (biased (select i64 (icmp_eq i64 result-exp 0xffffffffffffffff) 0 result-exp))
              (normal (or i64 sign (or i64 (shl i64 (and i64 biased 0x7ff) 52)
                                             (and i64 fraction 0xfffffffffffff)))))
          (select i64 is-nan 0x7ff8000000000000
            (select i64 nan-or-inf sign
              (select i64 tiny (or i64 sign 0x7ff0000000000000)
                normal)))))))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The integer table with an exponent around it, and the exponent is the hard part"))

  (definstruction frsqrte_v
    (mnemonic FRSQRTE_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed23 1) (fixed21 16) (opcode 29) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (sz imm i1 in)
    )
    (asm "frsqrte $rd, $rn, arrangement $sz")
    (semantics "Reciprocal square-root estimate of each lane")
    (formal
      (select i128 (icmp_eq i1 sz 0)
        (vmap v4f32 ((a rn))
          (let ((sign (and i32 a 0x80000000))
              (exponent (and i32 (lshr i32 a 23) 0xff))
              (frac (and i32 a 0x7fffff))
              (nan-or-inf (icmp_eq i32 exponent 0xff))
              (is-nan (and i32 nan-or-inf (icmp_ne i32 frac 0)))
              (subnormal (icmp_eq i32 exponent 0))
              (is-zero (and i32 subnormal (icmp_eq i32 frac 0)))
              (negative (icmp_ne i32 sign 0))
              (shift (sub i32 (clz i32 frac) 9))
              (e (select i32 subnormal (sub i32 0 shift) exponent))
              (f (select i32 subnormal
                         (and i32 (shl i32 frac (add i32 shift 1)) 0x7fffff) frac))
              (even (icmp_eq i32 (and i32 e 1) 0))
              (scaled (select i32 even (or i32 0x100 (lshr i32 f 15))
                                        (or i32 0x80 (lshr i32 f 16))))
              (base (select i64 (icmp_ult i32 scaled 256)
                            (add i64 (mul i64 scaled 2) 1)
                            (mul i64 (add i64 (and i64 scaled 0x1fe) 1) 2)))
              (root (fsqrt f64 (fdiv f64 0x41b0000000000000 (fcvt_u2f f64 64 base))))
              (guess (fcvt_f2u i64 64 root))
              (start (maxu i64 513 (sub i64 guess 1)))
              (c1 (add i64 start 1))
              (c2 (add i64 start 2))
              (fits0 (icmp_uge i64 (mul i64 (mul i64 base start) start) 0x10000000))
              (fits1 (icmp_uge i64 (mul i64 (mul i64 base c1) c1) 0x10000000))
              (fits2 (icmp_uge i64 (mul i64 (mul i64 base c2) c2) 0x10000000))
              (m (select i64 fits0 start
                   (select i64 fits1 c1 (select i64 fits2 c2 (add i64 start 3)))))
              (estimate (lshr i64 m 1))
              (result-exp (lshr i32 (sub i32 380 e) 1))
              (normal (or i32 (shl i32 (and i32 result-exp 0xff) 23)
                               (and i32 (shl i32 (and i32 estimate 0xff) 15)
                                         0x7fffff))))
          (select i32 is-nan 0x7fc00000
            (select i32 is-zero (or i32 sign 0x7f800000)
              (select i32 negative 0x7fc00000
                (select i32 nan-or-inf 0 normal))))))
        (vmap v2f64 ((a rn))
          (let ((sign (and i64 a 0x8000000000000000))
              (exponent (and i64 (lshr i64 a 52) 0x7ff))
              (frac (and i64 a 0xfffffffffffff))
              (nan-or-inf (icmp_eq i64 exponent 0x7ff))
              (is-nan (and i64 nan-or-inf (icmp_ne i64 frac 0)))
              (subnormal (icmp_eq i64 exponent 0))
              (is-zero (and i64 subnormal (icmp_eq i64 frac 0)))
              (negative (icmp_ne i64 sign 0))
              (shift (sub i64 (clz i64 frac) 12))
              (e (select i64 subnormal (sub i64 0 shift) exponent))
              (f (select i64 subnormal
                         (and i64 (shl i64 frac (add i64 shift 1)) 0xfffffffffffff) frac))
              (even (icmp_eq i64 (and i64 e 1) 0))
              (scaled (select i64 even (or i64 0x100 (lshr i64 f 44))
                                        (or i64 0x80 (lshr i64 f 45))))
              (base (select i64 (icmp_ult i64 scaled 256)
                            (add i64 (mul i64 scaled 2) 1)
                            (mul i64 (add i64 (and i64 scaled 0x1fe) 1) 2)))
              (root (fsqrt f64 (fdiv f64 0x41b0000000000000 (fcvt_u2f f64 64 base))))
              (guess (fcvt_f2u i64 64 root))
              (start (maxu i64 513 (sub i64 guess 1)))
              (c1 (add i64 start 1))
              (c2 (add i64 start 2))
              (fits0 (icmp_uge i64 (mul i64 (mul i64 base start) start) 0x10000000))
              (fits1 (icmp_uge i64 (mul i64 (mul i64 base c1) c1) 0x10000000))
              (fits2 (icmp_uge i64 (mul i64 (mul i64 base c2) c2) 0x10000000))
              (m (select i64 fits0 start
                   (select i64 fits1 c1 (select i64 fits2 c2 (add i64 start 3)))))
              (estimate (lshr i64 m 1))
              (result-exp (lshr i64 (sub i64 3068 e) 1))
              (normal (or i64 (shl i64 (and i64 result-exp 0x7ff) 52)
                               (and i64 (shl i64 (and i64 estimate 0xff) 44)
                                         0xfffffffffffff))))
          (select i64 is-nan 0x7ff8000000000000
            (select i64 is-zero (or i64 sign 0x7ff0000000000000)
              (select i64 negative 0x7ff8000000000000
                (select i64 nan-or-inf 0 normal))))))))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Completes the opcode, and the only one whose normalisation needs a leading-zero count"))

  (definstruction mul_elem_v
    (mnemonic MUL_ELEM_V) (isa aarch64_base) (category float)
    (format A64_SIMD_ELEM)
