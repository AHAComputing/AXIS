  ;; Reference bodies for the built-in `a64_*` operators.
  ;;
  ;; Those operators are implemented natively by every software backend and
  ;; mean what the golden model's evaluator says. A backend that has no native
  ;; implementation -- the netlist lowering -- needs their meaning stated in
  ;; the description's own operators, and this is where it is stated:
  ;; `<operator>_ref_i<W>` is the operator at width W. Nothing here is called
  ;; by an instruction. `tools/hw_reference_check.py` holds each body to the
  ;; built-in it describes, and the lowering inlines it wherever the built-in
  ;; is used.

  (deffun a64_shift_reg_ref_i64 ((value i64) (shift i64) (amount i64)) i64
    (let ((kind (and i64 shift 3)) (n (and i64 amount 63)))
      (select i64 (icmp_eq i64 kind 0) (shl i64 value n)
        (select i64 (icmp_eq i64 kind 1) (lshr i64 value n)
          (select i64 (icmp_eq i64 kind 2) (ashr i64 value n) (ror i64 value n))))))

  (deffun a64_shift_reg_ref_i32 ((value i32) (shift i32) (amount i32)) i32
    (let ((kind (and i32 shift 3)) (n (and i32 amount 31)))
      (select i32 (icmp_eq i32 kind 0) (shl i32 value n)
        (select i32 (icmp_eq i32 kind 1) (lshr i32 value n)
          (select i32 (icmp_eq i32 kind 2) (ashr i32 value n) (ror i32 value n))))))

  (deffun a64_extend_reg_ref_i64 ((value i64) (option i64) (amount i64)) i64
    (let ((size (and i64 option 3))
          (unsigned (select i64 (icmp_eq i64 size 0) (zext i64 8 value)
              (select i64 (icmp_eq i64 size 1) (zext i64 16 value)
                (select i64 (icmp_eq i64 size 2) (zext i64 32 value) value))))
          (signed (select i64 (icmp_eq i64 size 0) (sext i64 8 value)
              (select i64 (icmp_eq i64 size 1) (sext i64 16 value)
                (select i64 (icmp_eq i64 size 2) (sext i64 32 value) value)))))
      (shl i64 (select i64 (icmp_eq i64 (and i64 option 4) 0) unsigned signed)
               (and i64 amount 7))))

  (deffun a64_extend_reg_ref_i32 ((value i32) (option i32) (amount i32)) i32
    (let ((size (and i32 option 3))
          (unsigned (select i32 (icmp_eq i32 size 0) (zext i32 8 value)
              (select i32 (icmp_eq i32 size 1) (zext i32 16 value) value)))
          (signed (select i32 (icmp_eq i32 size 0) (sext i32 8 value)
              (select i32 (icmp_eq i32 size 1) (sext i32 16 value) value))))
      (shl i32 (select i32 (icmp_eq i32 (and i32 option 4) 0) unsigned signed)
               (and i32 amount 7))))

  (deffun a64_add_nzcv_ref_i64 ((a i64) (b i64)) i4
    (let ((r (add i64 a b)))
      (and i4 (or i64 (shl i64 (lshr i64 r 63) 3)
              (shl i64 (icmp_eq i64 r 0) 2)
              (shl i64 (icmp_ult i64 r a) 1)
              (lshr i64 (and i64 (not i64 (xor i64 a b)) (xor i64 a r)) 63)) 15)))

  (deffun a64_sub_nzcv_ref_i64 ((a i64) (b i64)) i4
    (let ((r (sub i64 a b)))
      (and i4 (or i64 (shl i64 (lshr i64 r 63) 3)
              (shl i64 (icmp_eq i64 r 0) 2)
              (shl i64 (icmp_uge i64 a b) 1)
              (lshr i64 (and i64 (xor i64 a b) (xor i64 a r)) 63)) 15)))

  (deffun a64_adc_nzcv_ref_i64 ((a i64) (b i64) (carry i64)) i4
    (let ((s (add i64 a b)) (r (add i64 s (and i64 carry 1))))
      (and i4 (or i64 (shl i64 (lshr i64 r 63) 3)
              (shl i64 (icmp_eq i64 r 0) 2)
              (shl i64 (or i64 (icmp_ult i64 s a) (icmp_ult i64 r s)) 1)
              (lshr i64 (and i64 (not i64 (xor i64 a b)) (xor i64 a r)) 63)) 15)))

  (deffun a64_sbc_nzcv_ref_i64 ((a i64) (b i64) (carry i64)) i4
    (let ((nb (not i64 b)) (s (add i64 a nb)) (r (add i64 s (and i64 carry 1))))
      (and i4 (or i64 (shl i64 (lshr i64 r 63) 3)
              (shl i64 (icmp_eq i64 r 0) 2)
              (shl i64 (or i64 (icmp_ult i64 s a) (icmp_ult i64 r s)) 1)
              (lshr i64 (and i64 (not i64 (xor i64 a nb)) (xor i64 a r)) 63)) 15)))

  (deffun a64_logic_nzcv_ref_i64 ((r i64)) i4
    (and i4 (or i64 (shl i64 (lshr i64 r 63) 3) (shl i64 (icmp_eq i64 r 0) 2)) 15))

  (deffun a64_add_nzcv_ref_i32 ((a i32) (b i32)) i4
    (let ((r (add i32 a b)))
      (and i4 (or i32 (shl i32 (lshr i32 r 31) 3)
              (shl i32 (icmp_eq i32 r 0) 2)
              (shl i32 (icmp_ult i32 r a) 1)
              (lshr i32 (and i32 (not i32 (xor i32 a b)) (xor i32 a r)) 31)) 15)))

  (deffun a64_sub_nzcv_ref_i32 ((a i32) (b i32)) i4
    (let ((r (sub i32 a b)))
      (and i4 (or i32 (shl i32 (lshr i32 r 31) 3)
              (shl i32 (icmp_eq i32 r 0) 2)
              (shl i32 (icmp_uge i32 a b) 1)
              (lshr i32 (and i32 (xor i32 a b) (xor i32 a r)) 31)) 15)))

  (deffun a64_adc_nzcv_ref_i32 ((a i32) (b i32) (carry i32)) i4
    (let ((s (add i32 a b)) (r (add i32 s (and i32 carry 1))))
      (and i4 (or i32 (shl i32 (lshr i32 r 31) 3)
              (shl i32 (icmp_eq i32 r 0) 2)
              (shl i32 (or i32 (icmp_ult i32 s a) (icmp_ult i32 r s)) 1)
              (lshr i32 (and i32 (not i32 (xor i32 a b)) (xor i32 a r)) 31)) 15)))

  (deffun a64_sbc_nzcv_ref_i32 ((a i32) (b i32) (carry i32)) i4
    (let ((nb (not i32 b)) (s (add i32 a nb)) (r (add i32 s (and i32 carry 1))))
      (and i4 (or i32 (shl i32 (lshr i32 r 31) 3)
              (shl i32 (icmp_eq i32 r 0) 2)
              (shl i32 (or i32 (icmp_ult i32 s a) (icmp_ult i32 r s)) 1)
              (lshr i32 (and i32 (not i32 (xor i32 a nb)) (xor i32 a r)) 31)) 15)))

  (deffun a64_logic_nzcv_ref_i32 ((r i32)) i4
    (and i4 (or i32 (shl i32 (lshr i32 r 31) 3) (shl i32 (icmp_eq i32 r 0) 2)) 15))

  (deffun a64_cond_holds_ref_i4 ((nzcv i4) (cond i4)) i4
    (let ((n (and i4 (lshr i4 nzcv 3) 1)) (z (and i4 (lshr i4 nzcv 2) 1))
          (c (and i4 (lshr i4 nzcv 1) 1)) (v (and i4 nzcv 1))
          (base (lshr i4 cond 1))
          (holds (select i4 (icmp_eq i4 base 0) z
                   (select i4 (icmp_eq i4 base 1) c
                     (select i4 (icmp_eq i4 base 2) n
                       (select i4 (icmp_eq i4 base 3) v
                         (select i4 (icmp_eq i4 base 4) (and i4 c (xor i4 z 1))
                           (select i4 (icmp_eq i4 base 5) (icmp_eq i4 n v)
                             (select i4 (icmp_eq i4 base 6)
                               (and i4 (icmp_eq i4 n v) (xor i4 z 1))
                               1)))))))))
      (select i4 (and i4 (and i4 cond 1) (icmp_ne i4 base 7)) (xor i4 holds 1) holds)))

  ; A run of `count` ones is `(1 << count) - 1`: a shift at or past the width is
  ; zero, so a full run comes out as every bit. Written out rather than with
  ; `ones` because the Rust backend's widest tier cannot emit that operator.
  (deffun a64_replicate_32 ((x i64)) i64
    (or i64 x (shl i64 x 32)))

  (deffun a64_replicate_16 ((x i64)) i64
    (a64_replicate_32 (or i64 x (shl i64 x 16))))

  (deffun a64_replicate_8 ((x i64)) i64
    (a64_replicate_16 (or i64 x (shl i64 x 8))))

  (deffun a64_replicate_4 ((x i64)) i64
    (a64_replicate_8 (or i64 x (shl i64 x 4))))

  (deffun a64_replicate_2 ((x i64)) i64
    (a64_replicate_4 (or i64 x (shl i64 x 2))))

  (deffun a64_wmask_ref_i64 ((n i64) (immr i64) (imms i64)) i64
    (select i64 (and i64 n 1)
      (ror i64 (sub i64 (shl i64 1 (add i64 (and i64 imms 63) 1)) 1) (and i64 immr 63))
      (select i64 (icmp_eq i64 (and i64 imms 32) 0)
          (a64_replicate_32 (zext i64 32 (ror i32 (sub i32 (shl i32 1 (add i32 (and i32 imms 31) 1)) 1) (and i32 immr 31))))
          (select i64 (icmp_eq i64 (and i64 imms 16) 0)
          (a64_replicate_16 (zext i64 16 (ror i16 (sub i16 (shl i16 1 (add i16 (and i16 imms 15) 1)) 1) (and i16 immr 15))))
          (select i64 (icmp_eq i64 (and i64 imms 8) 0)
          (a64_replicate_8 (zext i64 8 (ror i8 (sub i8 (shl i8 1 (add i8 (and i8 imms 7) 1)) 1) (and i8 immr 7))))
          (select i64 (icmp_eq i64 (and i64 imms 4) 0)
          (a64_replicate_4 (zext i64 4 (ror i4 (sub i4 (shl i4 1 (add i4 (and i4 imms 3) 1)) 1) (and i4 immr 3))))
          (select i64 (icmp_eq i64 (and i64 imms 2) 0)
          (a64_replicate_2 (zext i64 2 (ror i2 (sub i2 (shl i2 1 (add i2 (and i2 imms 1) 1)) 1) (and i2 immr 1))))
          0)))))))

  (deffun a64_tmask_64 ((n i64) (immr i64) (imms i64)) i64
    (select i64 (and i64 n 1)
      (sub i64 (shl i64 1 (add i64 (and i64 (sub i64 (and i64 imms 63) (and i64 immr 63)) 63) 1)) 1)
      (select i64 (icmp_eq i64 (and i64 imms 32) 0)
          (a64_replicate_32 (zext i64 32 (sub i32 (shl i32 1 (add i32 (and i32 (sub i32 (and i32 imms 31) (and i32 immr 31)) 31) 1)) 1)))
          (select i64 (icmp_eq i64 (and i64 imms 16) 0)
          (a64_replicate_16 (zext i64 16 (sub i16 (shl i16 1 (add i16 (and i16 (sub i16 (and i16 imms 15) (and i16 immr 15)) 15) 1)) 1)))
          (select i64 (icmp_eq i64 (and i64 imms 8) 0)
          (a64_replicate_8 (zext i64 8 (sub i8 (shl i8 1 (add i8 (and i8 (sub i8 (and i8 imms 7) (and i8 immr 7)) 7) 1)) 1)))
          (select i64 (icmp_eq i64 (and i64 imms 4) 0)
          (a64_replicate_4 (zext i64 4 (sub i4 (shl i4 1 (add i4 (and i4 (sub i4 (and i4 imms 3) (and i4 immr 3)) 3) 1)) 1)))
          (select i64 (icmp_eq i64 (and i64 imms 2) 0)
          (a64_replicate_2 (zext i64 2 (sub i2 (shl i2 1 (add i2 (and i2 (sub i2 (and i2 imms 1) (and i2 immr 1)) 1) 1)) 1)))
          0)))))))

  ; The element's index mask: one less than the element size `n:~imms` names.
  (deffun a64_levels_64 ((n i64) (imms i64)) i64
    (select i64 (and i64 n 1) 63
      (select i64 (icmp_eq i64 (and i64 imms 32) 0) 31
        (select i64 (icmp_eq i64 (and i64 imms 16) 0) 15
          (select i64 (icmp_eq i64 (and i64 imms 8) 0) 7
            (select i64 (icmp_eq i64 (and i64 imms 4) 0) 3
              (select i64 (icmp_eq i64 (and i64 imms 2) 0) 1 0)))))))

  (deffun a64_wmask_ref_i32 ((n i64) (immr i64) (imms i64)) i64
    ; Declared at 64 bits because it calls 64-bit functions; its value is the
    ; low 32.
    (and i64
      (and i32 (a64_wmask_ref_i64 (zext i64 32 n) (zext i64 32 immr) (zext i64 32 imms))
               0xffffffff)
      0xffffffff))

  (deffun a64_ubfm_ref_i64 ((src i64) (immr i64) (imms i64)) i64
    (and i64 (ror i64 src (and i64 immr 63))
             (and i64 (a64_wmask_ref_i64 1 immr imms) (a64_tmask_64 1 immr imms))))

  (deffun a64_ubfm_ref_i32 ((src i64) (immr i64) (imms i64)) i64
    ; Declared at 64 bits because it calls 64-bit functions; its value is the
    ; low 32.
    (and i64
      (and i32 (ror i32 src (and i32 immr 31))
               (and i64 (a64_wmask_ref_i64 0 (zext i64 32 immr) (zext i64 32 imms))
                        (a64_tmask_64 0 (zext i64 32 immr) (zext i64 32 imms))))
      0xffffffff))

  (deffun a64_sbfm_ref_i64 ((src i64) (immr i64) (imms i64)) i64
    (let ((tmask (a64_tmask_64 1 immr imms))
          (bot (and i64 (ror i64 src (and i64 immr 63)) (a64_wmask_ref_i64 1 immr imms)))
          (top (sub i64 0 (and i64 (lshr i64 src (and i64 imms 63)) 1))))
      (or i64 (and i64 top (not i64 tmask)) (and i64 bot tmask))))

  (deffun a64_sbfm_ref_i32 ((src i64) (immr i64) (imms i64)) i64
    ; Declared at 64 bits because it calls 64-bit functions; its value is the
    ; low 32.
    (and i64
      (let ((tmask (a64_tmask_64 0 (zext i64 32 immr) (zext i64 32 imms)))
            (bot (and i32 (ror i32 src (and i32 immr 31))
                          (a64_wmask_ref_i64 0 (zext i64 32 immr) (zext i64 32 imms))))
            ; The sign is the source's bit `s`, and `s` is counted within the
