  (definstruction accel_pssbb
    (mnemonic ACCEL_PSSBB) (isa accelerator_scalar64) (category custom)
    (format ACCEL_STATE_IMM4)
    (opcode 0) (func3 0) (func7 0)
    (encoding (opcode 122) (fixed_hi 0) (option 0) (fixed_lo 7))
    (operands) (asm "accel.pssbb") (semantics "Accelerator physical store-bypass barrier")
    (behavior (barrier pssbb 0))
