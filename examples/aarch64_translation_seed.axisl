  ; The moves are what make the file reachable: without them a V register could
  ; only ever be written by the arithmetic that reads it.


  ; The moves are what make the file reachable: without them a V register could
  ; only ever be written by the arithmetic that reads it. They are also the only
  ; pair in this corpus that differs by nothing but which file its operands live
  ; in, which is why they cost more than they look -- see the class and slot
  ; notes in src/emit/translation.rs.
  (definstruction fmov_d_from_x
    (mnemonic FMOV_D_FROM_X) (isa aarch64_base) (category float)
    (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 1267) (fpop 448))
    (operands (rd a64_vreg64 i64 out) (rn a64_gpr64 i64 in))
    (asm "fmov $rd, $rn")
    (semantics "Move a general register's bits into a vector register")
    (formal rn)
    (latency 1) (throughput 1.0)
    (area-estimate-um2 200.0) (power-estimate-mw 1.0) (expected-speedup 1.0)
    (rationale "A bit pattern crossing files, signalling nothing"))

