  (defformat A64_SIMD_MODIMM
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (op 29 29)
      (fixed 28 19)
      (imm 18 16 7 5)
      (cmode 15 12)
      (o2 11 11)
      (one 10 10)
      (imm 9 5 4 0)
      (rd 4 0)
    )
  )

  ; ⚠️ The shifted modified immediates, where `cmode` carries the shift. For
  ; 32-bit lanes it is `0 ss x`: the byte goes `8 * ss` bits up, and `x`
  ; picks move (MOVI/MVNI) or combine (ORR/BIC) -- so `ss` is an operand
  ; and the rest of `cmode` is fixed, one format per place the shift sits.
  (defformat A64_SIMD_MODIMM_S32
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (op 29 29)
      (fixed 28 19)
      (imm 18 16 7 5)
      (cmode3 15 15)
      (sh 14 13)
      (cmode0 12 12)
      (o2 11 11)
      (one 10 10)
      (imm 9 5 4 0)
      (rd 4 0)
    )
  )

  ; 16-bit lanes: `cmode = 10 s x`, a shift of 0 or 8.
  (defformat A64_SIMD_MODIMM_S16
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (op 29 29)
      (fixed 28 19)
      (imm 18 16 7 5)
      (cmode32 15 14)
      (sh 13 13)
      (cmode0 12 12)
      (o2 11 11)
      (one 10 10)
      (imm 9 5 4 0)
      (rd 4 0)
    )
  )

  ; MSL, the shift that fills with ONES: `cmode = 110 s`, `imm << 8 | 0xff`
  ; or `imm << 16 | 0xffff`.
  (defformat A64_SIMD_MODIMM_MSL
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (op 29 29)
      (fixed 28 19)
      (imm 18 16 7 5)
      (cmode31 15 13)
      (sh 12 12)
      (o2 11 11)
      (one 10 10)
      (imm 9 5 4 0)
      (rd 4 0)
    )
  )

  ; INS (element): `imm5` names the size and the destination element as for
  ; every copy, and `imm4` -- the opcode field of the other copies -- is the
  ; source element, its bits below the size ignored.
  (defformat A64_SIMD_COPY_ELEM
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (fixed 29 21)
      (imm5 20 16)
      (zero15 15 15)
      (imm4 14 11)
      (one10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  (defformat A64_SIMD_3SAME_H
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (a 23 23)
      (fixed22 22 21)
      (rm 20 16)
      (fixed15 15 14)
      (opcode 13 11)
      (one10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )
  (defformat A64_SIMD_2MISC_H
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (a 23 23)
      (fixed22 22 17)
      (opcode 16 12)
      (fixed11 11 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ The half-precision fixed-point conversions' own format. Their `immh`
  ; is `001x`, so bits 22-20 are FIXED and only the low four vary -- and
  ; saying so in the format is what lets a decoder that sees only fixed bits
  ; (LLVM's TableGen) tell them from the single-precision forms, whose `immh`
  ; is `01xx`: over one seven-bit operand the two differed only by a range a
  ; `requires` states, and TableGen reported the pair as a conflict.
  ; `fbits` is 16 - imm4.
  (defformat A64_SIMD_SHIFT_IMM_H
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 23)
      (immh3 22 20)
      (imm4 19 16)
      (opcode 15 11)
      (one10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  (defformat A64_SIMD_PERMUTE
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (fixed 29 24)
      (size 23 22)
      (zero21 21 21)
      (rm 20 16)
      (zero15 15 15)
      (opcode 14 12)
      (two10 11 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ The floating-point half of 3SAME needs its own format, and the decode
  ; gate is what said so. `size` is one two-bit field for the integer
  ; instructions, but in the floating-point encodings its two bits have
  ; different jobs: bit 23 selects WHICH instruction an opcode names and bit 22
  ; is `sz`, four singles or two doubles. Described as one field with a
  ; `requires` narrowing it, FADD and FSUB have identical fixed bits and
  ; identical masks -- which is exactly what the decode-overlap check refuses,
  ; and it refused it here before anything else ran.
  (defformat A64_SIMD_3SAME_FP
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (fixed23 23 23)
      (sz 22 22)
      (one21 21 21)
      (rm 20 16)
      (opcode 15 11)
      (one10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ The two-register floating-point encodings split `size` as well, but NOT
  ; the way the three-register ones do, and assuming they matched cost me a
  ; round of this. In 3SAME bit 23 selects which instruction an opcode names.
  ; Here, for the comparisons against zero and the two sign operations, bit 23
  ; is simply PINNED TO ONE -- `size` is `1x` for every one of them -- and only
  ; bit 22 is `sz`. Splitting the field is still right, because `sz` must vary
  ; while bit 23 must not; what is different is which value bit 23 takes.
  ;
  ; The reference assembler is what said so. With bit 23 clear, all seven
  ; encodings decoded to nothing at all -- not to the wrong instruction, to no
  ; instruction -- which is the cheapest possible failure and one no amount of
  ; differential testing against AXIS itself could have produced.
  (defformat A64_SIMD_2MISC_FP
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (fixed23 23 23)
      (sz 22 22)
      (fixed21 21 17)
      (opcode 16 12)
      (fixed11 11 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ BY-ELEMENT, where one lane of `rm` multiplies every lane of `rn`. The
  ; awkward part is the encoding: the element index is SPLIT across the word,
  ; `H` at bit 11 and `L` at bit 21, with `Rm` between them -- and how it is
  ; split depends on the arrangement, because a 16-bit element needs three
  ; index bits and borrows `M` at bit 20, leaving `Rm` only four.
  ;
  ; A split field is something the format language can already say, so `index`
  ; is one operand spanning two single-bit ranges rather than two operands the
  ; semantics would have to reassemble. This format is the 32-bit-element one,
  ; where `Rm` keeps all five bits; the 16-bit forms carve the same word
  ; differently and are a different format, which is what they are.
  (defformat A64_SIMD_ELEM
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (size 23 22)
      (index 11 11 1 1)
      (index 21 21 0 0)
      (rm 20 16)
      (opcode 15 12)
      (zero10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ The 16-bit by-element format, which carves the same word differently.
  ; A halfword element needs THREE index bits, so the index takes `M` at bit 20
  ; as well as `H` and `L` -- and `Rm` is left with four bits, which is why
  ; these can only name v0 through v15. That restriction lives in the encoding
  ; rather than in a rule written beside it.
  ;
  ; The index is declared as two slices of one operand: `H` carries the top
  ; bit, `L:M` the low two. A field entry maps INSTRUCTION bits to OPERAND
  ; bits, which is worth saying because reading it the other way round is what
  ; made the word-sized format place its index nowhere at all.
  (defformat A64_SIMD_ELEM_H
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (size 23 22)
      (index 11 11 2 2)
      (index 21 20 1 0)
      (rm 19 16)
      (opcode 15 12)
      (zero10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; The doubleword by-element format. A 64-bit element leaves room for only two
  ; in a register, so the index is `H` ALONE; `L` is pinned to zero rather than
  ; borrowed, and `Rm` keeps all five bits. Three formats for one idea, because
  ; the index grows by a bit each time the element halves, and each bit has to
  ; come from somewhere in the same word.
  (defformat A64_SIMD_ELEM_D
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (size 23 22)
      (zero21 21 21)
      (rm 20 16)
      (opcode 15 12)
      (index 11 11 0 0)
      (zero10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ SHIFT BY IMMEDIATE, where one field says two things. `immh:immb` is a
  ; single seven-bit value whose LEADING ONE names the element size -- 8..15
  ; bytes, 16..31 halves, 32..63 words, 64..127 doublewords -- and whose value
  ; relative to that size is the shift: `2 * esize - immhb` to the right,
  ; `immhb - esize` to the left. So the field is one operand, the arrangement
  ; is a select over its ranges, and the shift is arithmetic on it inside the
  ; lane body. `immh = 0` is the modified-immediate space and not these.
  (defformat A64_SIMD_SHIFT_IMM
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 23)
      (immhb 22 16)
      (opcode 15 11)
      (one10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ ACROSS LANES: one result from every lane of `rn`, written to the low
  ; element of `rd` with the rest of the register zeroed. Arm's `Reduce`
  ; pairs the lanes as a balanced tree -- the halves are reduced and then
  ; combined -- and the tree is spelled out here rather than a chain, because
  ; for the floating-point forms the order is architectural.
  (defformat A64_SIMD_ACROSS
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (size 23 22)
      (fixed21 21 17)
      (opcode 16 12)
      (fixed11 11 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; EXT: the byte-aligned window `imm4` bytes into the concatenation `rm:rn`.
  (defformat A64_SIMD_EXT
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (fixed 29 24)
      (op2 23 22)
      (zero21 21 21)
      (rm 20 16)
      (zero15 15 15)
      (imm4 14 11)
      (zero10 10 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; TBL/TBX: `len` is the number of table registers less one. The corpus
  ; carries the one-register table; longer ones read V(n+1)..V(n+3), which
  ; an operand list cannot yet name.
  (defformat A64_SIMD_TBL
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (fixed 29 24)
      (op2 23 22)
      (zero21 21 21)
      (rm 20 16)
      (zero15 15 15)
      (len 14 13)
      (op 12 12)
      (zero11 11 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; ⚠️ THREE DIFFERENT: operands and result of different widths. The `L`
  ; forms widen both sources, the `W` forms only the second, the `HN` forms
  ; narrow the result to the high half of each wide lane. The corpus carries
  ; the `2` forms, as it does for XTN2: a widening source is the UPPER half
  ; of its register, and a narrowing result is written to the upper half of
  ; `rd` with the lower kept. `size` names the NARROW element.
  (defformat A64_SIMD_3DIFF
    (bits 32)
    (fields
      (fixed_hi 31 31)
      (q 30 30)
      (u 29 29)
      (fixed 28 24)
      (size 23 22)
      (one21 21 21)
      (rm 20 16)
      (opcode 15 12)
      (zero11 11 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  (defformat A64_PAC_DP1
    (bits 32)
    (fields
      (fixed 31 5)
      (rd 4 0)
    )
  )

