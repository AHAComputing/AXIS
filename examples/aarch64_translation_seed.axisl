    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "smaxp $rd, $rn, $rm, arrangement $size")
    (semantics "Pairwise signed maximum across the concatenation of rn and rm")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((lo (lane rn (% (* lane-index 2) 16)))
