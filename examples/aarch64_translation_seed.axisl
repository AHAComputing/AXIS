  ; ⚠️ ABSOLUTE DIFFERENCE, which is a subtraction that must not wrap. |a - b|
  ; fits in a lane for every input, but `a - b` does not, so the difference is
  ; taken at twice the lane width and the comparison that picks the order is
  ; taken there too. The accumulating forms add the running total in the same
  ; body -- `rd` is a third lane operand, read and written, which is what
  ; `inout` already meant and what a lane body needed no new mechanism to say.
  ;
  ; SABD is the inner loop of every sum-of-absolute-differences kernel there
  ; is, which is to say of motion estimation. `size = 3` is unallocated.

  (definstruction sabd_v
    (mnemonic SABD_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 14) (one10 1))
    (operands
