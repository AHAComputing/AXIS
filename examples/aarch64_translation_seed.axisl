      (index imm i2 in)
    )
    (asm "mla $rd, $rn, $rm, element $index")
    (semantics "Multiply by the indexed lane and accumulate into rd")
    (formal
      (select i128 (icmp_eq i2 index 0) (vmap v4i32 ((d rd) (a rn) (b (lane rm 0))) (add i32 d (mul i32 a b)))
