  ; ⚠️ ACCUMULATE ACROSS A SIGN, which is the rarest shape in the instruction
  ; set: the destination and the source are read at OPPOSITE signednesses.
  ; SUQADD adds an unsigned source into a signed destination and saturates
  ; signed; USQADD adds a signed source into an unsigned destination and
  ; saturates unsigned, which is the only accumulate here that can clamp at
  ; ZERO as well as at the top.
  ;
  ; Both sums are taken at twice the lane width, where neither the carry nor
  ; the sign can be lost, and the clamp happens there -- which is the same
  ; shape every saturating operation in this file has, and the reason it is
  ; worth having said it once.

  (definstruction suqadd_v
    (mnemonic SUQADD_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 3) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "suqadd $rd, $rn, arrangement $size")
    (semantics "Unsigned source accumulated into a signed destination, saturating")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((d rd) (a rn))
                   (let ((sum (add i16 (sext i16 8 d) a)))
                     (select i16 (icmp_slt i16 0x7f sum) 0x7f
                       (select i16 (icmp_slt i16 sum 0xff80) 0x80 sum))))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((d rd) (a rn))
                   (let ((sum (add i32 (sext i32 16 d) a)))
                     (select i32 (icmp_slt i32 0x7fff sum) 0x7fff
                       (select i32 (icmp_slt i32 sum 0xffff8000) 0x8000 sum))))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((d rd) (a rn))
                   (let ((sum (add i64 (sext i64 32 d) a)))
                     (select i64 (icmp_slt i64 0x7fffffff sum) 0x7fffffff
                       (select i64 (icmp_slt i64 sum 0xffffffff80000000) 0x80000000 sum))))
        (vmap v2i64 ((d rd) (a rn))
                   (let ((sum (add i128 (sext i128 64 d) a)))
                     (select i128 (icmp_slt i128 0x7fffffffffffffff sum) 0x7fffffffffffffff
                       (select i128 (icmp_slt i128 sum 0xffffffffffffffff8000000000000000) 0x8000000000000000 sum))))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Reading two registers at different signednesses is the whole point of the opcode"))

  (definstruction usqadd_v
    (mnemonic USQADD_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 3) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "usqadd $rd, $rn, arrangement $size")
    (semantics "Signed source accumulated into an unsigned destination, saturating")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((d rd) (a rn))
                   (let ((sum (add i16 d (sext i16 8 a))))
                     (select i16 (icmp_slt i16 sum 0) 0
                       (select i16 (icmp_slt i16 0xff sum) 0xff sum))))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((d rd) (a rn))
                   (let ((sum (add i32 d (sext i32 16 a))))
                     (select i32 (icmp_slt i32 sum 0) 0
                       (select i32 (icmp_slt i32 0xffff sum) 0xffff sum))))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((d rd) (a rn))
                   (let ((sum (add i64 d (sext i64 32 a))))
                     (select i64 (icmp_slt i64 sum 0) 0
                       (select i64 (icmp_slt i64 0xffffffff sum) 0xffffffff sum))))
        (vmap v2i64 ((d rd) (a rn))
                   (let ((sum (add i128 d (sext i128 64 a))))
                     (select i128 (icmp_slt i128 sum 0) 0
                       (select i128 (icmp_slt i128 0xffffffffffffffff sum) 0xffffffffffffffff sum))))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The only accumulate in this file that can clamp at zero as well as at the top"))

  ; ⚠️ THE NARROWING FAMILY, which is where `Q` stops being a size and becomes
  ; a DESTINATION HALF. Every one of these takes a full register of wide lanes
  ; and produces half a register of narrow ones, so with `Q = 1` -- which is
  ; what this corpus pins -- they are the `2` forms: they write the UPPER 64
  ; bits and leave the lower 64 exactly as they found them. `rd` is therefore
  ; `inout`, and every destination lane below the halfway point answers with
  ; the lane it already held.
  ;
  ; The source lane for destination lane j is the wide lane j - n/2, and the
  ; two narrow lanes that wide lane occupies are `2j mod n` and `2j + 1 mod n`.
  ; The `mod` is what keeps the index inside the vector for the lanes that do
  ; not use it -- the expansion evaluates every binding for every lane, and an
  ; index that left the register would be refused rather than ignored.
  ;
  ; XTN keeps the low half and is therefore just that lane; the three
  ; saturating forms reassemble the wide lane from its two halves and clamp it.
  ; SQXTUN is the odd one: a SIGNED source into an UNSIGNED destination, so it
  ; clamps at zero and at all-ones rather than at the signed bounds.

  (definstruction xtn2_v
    (mnemonic XTN2_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 18) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "xtn2 $rd, $rn, arrangement $size")
    (semantics "Truncate each wide lane into the upper half of the destination")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 16)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 16))))
                 (select i8 (icmp_ult i8 lane-index 8) d
                       lo))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 8)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 8))))
                 (select i16 (icmp_ult i16 lane-index 4) d
                       lo))
        (vmap v4i32 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 4)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 4))))
                 (select i32 (icmp_ult i32 lane-index 2) d
                       lo)))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Narrowing without saturation, which is a choice the other three do not make"))

  (definstruction sqxtun2_v
    (mnemonic SQXTUN2_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 18) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "sqxtun2 $rd, $rn, arrangement $size")
    (semantics "Signed saturating extract into an unsigned narrow upper half")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 16)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 16))))
                 (let ((v (or i16 lo (shl i16 hi 8))))
                   (select i8 (icmp_ult i8 lane-index 8) d
                       (select i16 (icmp_slt i16 v 0) 0
                          (select i16 (icmp_slt i16 0xff v) 0xff v)))))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 8)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 8))))
                 (let ((v (or i32 lo (shl i32 hi 16))))
                   (select i16 (icmp_ult i16 lane-index 4) d
                       (select i32 (icmp_slt i32 v 0) 0
                          (select i32 (icmp_slt i32 0xffff v) 0xffff v)))))
        (vmap v4i32 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 4)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 4))))
                 (let ((v (or i64 lo (shl i64 hi 32))))
                   (select i32 (icmp_ult i32 lane-index 2) d
                       (select i64 (icmp_slt i64 v 0) 0
                          (select i64 (icmp_slt i64 0xffffffff v) 0xffffffff v))))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The only narrow that changes signedness, clamping at zero and all-ones"))

  (definstruction sqxtn2_v
    (mnemonic SQXTN2_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 20) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "sqxtn2 $rd, $rn, arrangement $size")
    (semantics "Signed saturating extract narrow into the upper half")
    (formal
