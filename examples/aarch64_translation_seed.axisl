  (definstruction mrs_nzcv
    (mnemonic MRS_NZCV) (isa aarch64_base) (category custom)
    (format A64_SYSTEM_RT)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 111794704))
    (operands (rt a64_gpr64 i64 out))
    (asm "mrs $rt, nzcv")
    (semantics "Read PSTATE condition flags through the NZCV system register")
    (behavior (set rt (shl i64 nzcv 28)))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Expose NZCV in architectural Xt bits 31 through 28"))

  (definstruction msr_nzcv
    (mnemonic MSR_NZCV) (isa aarch64_base) (category custom)
    (format A64_SYSTEM_RT)
    (opcode 0) (func3 0) (func7 0)
