  (definstruction-family a64-casp
    ($name $mnemonic $size $reg-kind $reg-type $stride $acquire $release $load-order $store-order $asm)
    (
     (casp_w CASP_W 0 a64_gpr32 i32 4 0 0 relaxed relaxed "casp $rs, $rs2, $rt, $rt2, [$rn]")
     (caspa_w CASPA_W 0 a64_gpr32 i32 4 1 0 acquire relaxed "caspa $rs, $rs2, $rt, $rt2, [$rn]")
     (caspl_w CASPL_W 0 a64_gpr32 i32 4 0 1 relaxed release "caspl $rs, $rs2, $rt, $rt2, [$rn]")
     (caspal_w CASPAL_W 0 a64_gpr32 i32 4 1 1 acquire release "caspal $rs, $rs2, $rt, $rt2, [$rn]")
     (casp_x CASP_X 1 a64_gpr64 i64 8 0 0 relaxed relaxed "casp $rs, $rs2, $rt, $rt2, [$rn]")
     (caspa_x CASPA_X 1 a64_gpr64 i64 8 1 0 acquire relaxed "caspa $rs, $rs2, $rt, $rt2, [$rn]")
     (caspl_x CASPL_X 1 a64_gpr64 i64 8 0 1 relaxed release "caspl $rs, $rs2, $rt, $rt2, [$rn]")
     (caspal_x CASPAL_X 1 a64_gpr64 i64 8 1 1 acquire release "caspal $rs, $rs2, $rt, $rt2, [$rn]"))
    (definstruction $name
      (mnemonic $mnemonic) (isa aarch64_base) (category custom) (format A64_LDST_CAS)
      (opcode 0) (func3 0) (func7 0)
      (encoding (size $size) (fixed 16) (acquire $acquire) (fixed21 1)
        (release $release) (fixed14 31))
      (operands
        (rs $reg-kind $reg-type inout)
        (rs2 $reg-kind $reg-type inout (derive rs 1))
        (rt $reg-kind $reg-type in)
        (rt2 $reg-kind $reg-type in (derive rt 1))
        (rn a64_gpr64sp i64 in))
      (requires (and (masked-eq rs 1 0) (masked-eq rt 1 0)))
      (asm $asm) (semantics "Paired atomic compare-and-swap returning the old memory pair")
      (behavior
        (atomic-group 1
          (set rs (atomic_load $reg-type unsigned $load-order rn))
          (set rs2 (atomic_load $reg-type unsigned $load-order (add i64 rn $stride)))
          (when (and
                  (icmp_eq (or $reg-type rs 0) (or $reg-type (input rs) 0))
                  (icmp_eq (or $reg-type rs2 0) (or $reg-type (input rs2) 0)))
            (atomic_store rn rt $reg-type $store-order))
          (when (and
                  (icmp_eq (or $reg-type rs 0) (or $reg-type (input rs) 0))
                  (icmp_eq (or $reg-type rs2 0) (or $reg-type (input rs2) 0)))
            (atomic_store (add i64 rn $stride) rt2 $reg-type $store-order))))
      (latency 8) (throughput 0.25)
      (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 3.0)
      (rationale "AArch64 paired compare-and-swap with even-register legality and one transaction")))

