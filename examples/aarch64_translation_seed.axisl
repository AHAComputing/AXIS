  (definstruction shsub_v
    (mnemonic SHSUB_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 4) (one10 1))
