  ; The narrowing and widening shifts, in the same format: here `immh:immb`
  ; names the NARROW element (8..15 bytes, 16..31 halves, 32..63 words; a
  ; leading one in bit 6 is unallocated, there being no 128-bit lane to narrow
  ; from). As with XTN2, the corpus carries the `2` forms, which write the
  ; upper half of `rd` and keep the lower -- or, widening, read the upper half
  ; of `rn`. The narrowing bodies work at four times the narrow width, so the
  ; rounding increment of a shift by the whole wide element cannot carry out
  ; and saturation compares against the true value.

  (definstruction shrn2_v
    (mnemonic SHRN2_V) (isa aarch64_base) (category float)
    (format A64_SIMD_SHIFT_IMM)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 30) (opcode 16) (one10 1))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in) (immhb imm i7 in)
    )
    (requires (and (> immhb 7) (< immhb 64)))
    (asm "shrn2 $rd, $rn, shift $immhb")
    (semantics "Shift right narrow into the upper half")
    (formal
      (select i128 (icmp_ult i7 immhb 16) (vmap v16i8 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 16)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 16))))
                 (let ((v (or i16 lo (shl i16 hi 8)))
                       (n (sub i32 16 (zext i32 7 immhb))))
                   (select i8 (icmp_ult i8 lane-index 8) d
