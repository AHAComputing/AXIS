    (asm "trn1 $rd, $rn, $rm, arrangement $size")
    (semantics "Transpose, taking the even lanes")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((x (lane rn (- lane-index (% lane-index 2))))
                             (y (lane rm (- lane-index (% lane-index 2)))))
