                   (left (select i16 (icmp_ult i16 amount 16)
                     (select i32 (icmp_ult i32 0xffff (shl i32 a amount)) 0xffff (shl i32 a amount))
                     (select i16 (icmp_eq i16 a 0) 0 0xffff)))
                   (right (select i16 (icmp_ult i16 n 17) (lshr i32 (add i32 a (shl i32 1 (sub i16 n 1))) n) 0)))
               (select i16 negative right left)))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((a rn) (b rm))
             (let ((amount (and i32 b 0xff))
                   (negative (icmp_ne i32 (and i32 b 0x80) 0))
                   (n (and i32 (sub i32 0 amount) 0xff))
                   (left (select i32 (icmp_ult i32 amount 32)
                     (select i64 (icmp_ult i64 0xffffffff (shl i64 a amount)) 0xffffffff (shl i64 a amount))
                     (select i32 (icmp_eq i32 a 0) 0 0xffffffff)))
                   (right (select i32 (icmp_ult i32 n 33) (lshr i64 (add i64 a (shl i64 1 (sub i32 n 1))) n) 0)))
               (select i32 negative right left)))
        (vmap v2i64 ((a rn) (b rm))
             (let ((amount (and i64 b 0xff))
                   (negative (icmp_ne i64 (and i64 b 0x80) 0))
                   (n (and i64 (sub i64 0 amount) 0xff))
                   (left (select i64 (icmp_ult i64 amount 64)
                     (select i128 (icmp_ult i128 0xffffffffffffffff (shl i128 a amount)) 0xffffffffffffffff (shl i128 a amount))
                     (select i64 (icmp_eq i64 a 0) 0 0xffffffffffffffff)))
                   (right (select i64 (icmp_ult i64 n 65) (lshr i128 (add i128 a (shl i128 1 (sub i64 n 1))) n) 0)))
               (select i64 negative right left)))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The last of the six, so the family is complete rather than sampled"))

  ; ⚠️ TWO-REGISTER MISCELLANEOUS -- one source, one destination, and the half
  ; of NEON that is not arithmetic on pairs. Three things here are only
  ; describable because a lane operator has a body: `clz` and `cpop` are
  ; lane-local but are NOT on the lane-parallel list, so before `vmap` there
  ; was no way to apply them per lane at all; and the saturating absolute value
  ; is a two-step test that no single atom spells.
  ;
  ; The comparisons against zero go the other way and use the closed list on
  ; purpose: a lane compare writes a MASK rather than the 1 or 0 a scalar
  ; compare answers, and `LANE_COMPARE` is what knows that. Only two signed
  ; spellings exist there -- `icmp_slt` and `icmp_sge` -- so the four
  ; comparisons are the two of them with their operands either way round, which
  ; is exactly how the redundant pairs were meant to be used.
  ;
  ; ABS and NEG WRAP at the most negative lane, where SQABS and SQNEG saturate;
  ; that pair of opcodes is the whole difference between them and is the reason
  ; both exist.

  (definstruction abs_v
    (mnemonic ABS_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 11) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "abs $rd, $rn, arrangement $size")
    (semantics "Lanewise absolute value, wrapping at the most negative lane")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn))
                   (select i8 (icmp_slt i8 a 0) (sub i8 0 a) a))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn))
                   (select i16 (icmp_slt i16 a 0) (sub i16 0 a) a))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((a rn))
                   (select i32 (icmp_slt i32 a 0) (sub i32 0 a) a))
        (vmap v2i64 ((a rn))
                   (select i64 (icmp_slt i64 a 0) (sub i64 0 a) a))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The absolute value that does not saturate, which is a choice and not an oversight"))

  (definstruction neg_v
    (mnemonic NEG_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 11) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "neg $rd, $rn, arrangement $size")
    (semantics "Lanewise negate, wrapping at the most negative lane")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn))
                   (sub i8 0 a))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn))
                   (sub i16 0 a))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((a rn))
                   (sub i32 0 a))
        (vmap v2i64 ((a rn))
                   (sub i64 0 a))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The U bit's half of the same opcode"))

  (definstruction sqabs_v
    (mnemonic SQABS_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 7) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "sqabs $rd, $rn, arrangement $size")
    (semantics "Lanewise saturating absolute value")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn))
                   (select i8 (icmp_eq i8 a 0x80) 0x7f
                     (select i8 (icmp_slt i8 a 0) (sub i8 0 a) a)))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn))
                   (select i16 (icmp_eq i16 a 0x8000) 0x7fff
                     (select i16 (icmp_slt i16 a 0) (sub i16 0 a) a)))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((a rn))
                   (select i32 (icmp_eq i32 a 0x80000000) 0x7fffffff
                     (select i32 (icmp_slt i32 a 0) (sub i32 0 a) a)))
        (vmap v2i64 ((a rn))
                   (select i64 (icmp_eq i64 a 0x8000000000000000) 0x7fffffffffffffff
                     (select i64 (icmp_slt i64 a 0) (sub i64 0 a) a)))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Where ABS wraps, this clamps -- the pair is why both opcodes exist"))

  (definstruction sqneg_v
    (mnemonic SQNEG_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 7) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "sqneg $rd, $rn, arrangement $size")
    (semantics "Lanewise saturating negate")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn))
                   (select i8 (icmp_eq i8 a 0x80) 0x7f (sub i8 0 a)))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn))
                   (select i16 (icmp_eq i16 a 0x8000) 0x7fff (sub i16 0 a)))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((a rn))
                   (select i32 (icmp_eq i32 a 0x80000000) 0x7fffffff (sub i32 0 a)))
        (vmap v2i64 ((a rn))
                   (select i64 (icmp_eq i64 a 0x8000000000000000) 0x7fffffffffffffff (sub i64 0 a)))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Negating the most negative lane is the one case that cannot be represented"))

  (definstruction cmgt_zero_v
    (mnemonic CMGT_ZERO_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 8) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "cmgt $rd, $rn, arrangement $size")
    (semantics "All-ones in each lane greater than zero")
    (formal
      (select i128 (icmp_eq i2 size 0) (icmp_slt v16i8 0 rn)
      (select i128 (icmp_eq i2 size 1) (icmp_slt v8i16 0 rn)
      (select i128 (icmp_eq i2 size 2) (icmp_slt v4i32 0 rn)
        (icmp_slt v2i64 0 rn)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Zero on the left of `icmp_slt` is how the greater-than is spelled"))

  (definstruction cmge_zero_v
    (mnemonic CMGE_ZERO_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 8) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "cmge $rd, $rn, arrangement $size")
    (semantics "All-ones in each lane greater than or equal to zero")
    (formal
      (select i128 (icmp_eq i2 size 0) (icmp_sge v16i8 rn 0)
      (select i128 (icmp_eq i2 size 1) (icmp_sge v8i16 rn 0)
      (select i128 (icmp_eq i2 size 2) (icmp_sge v4i32 rn 0)
        (icmp_sge v2i64 rn 0)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The U bit relaxes the comparison, and completes the opcode"))

  (definstruction cmle_zero_v
    (mnemonic CMLE_ZERO_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 9) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "cmle $rd, $rn, arrangement $size")
    (semantics "All-ones in each lane less than or equal to zero")
    (formal
      (select i128 (icmp_eq i2 size 0) (icmp_sge v16i8 0 rn)
      (select i128 (icmp_eq i2 size 1) (icmp_sge v8i16 0 rn)
      (select i128 (icmp_eq i2 size 2) (icmp_sge v4i32 0 rn)
        (icmp_sge v2i64 0 rn)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Completes the opcode CMEQ against zero already half occupied"))

  (definstruction cmlt_zero_v
    (mnemonic CMLT_ZERO_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 10) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "cmlt $rd, $rn, arrangement $size")
    (semantics "All-ones in each lane less than zero")
    (formal
      (select i128 (icmp_eq i2 size 0) (icmp_slt v16i8 rn 0)
      (select i128 (icmp_eq i2 size 1) (icmp_slt v8i16 rn 0)
      (select i128 (icmp_eq i2 size 2) (icmp_slt v4i32 rn 0)
        (icmp_slt v2i64 rn 0)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A sign-bit broadcast, and the only instruction at its opcode"))

  (definstruction cls_v
    (mnemonic CLS_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 4) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "cls $rd, $rn, arrangement $size")
    (semantics "Lanewise count of leading sign bits")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn))
                   (sub i8 (clz i8 (xor i8 a (sra i8 a 1))) 1))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn))
                   (sub i16 (clz i16 (xor i16 a (sra i16 a 1))) 1))
        (vmap v4i32 ((a rn))
                   (sub i32 (clz i32 (xor i32 a (sra i32 a 1))) 1)))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Leading sign bits are the leading zeros of the lane xored with itself shifted"))

  (definstruction clz_v
    (mnemonic CLZ_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 4) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "clz $rd, $rn, arrangement $size")
    (semantics "Lanewise count of leading zeros")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn))
                   (clz i8 a))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn))
                   (clz i16 a))
        (vmap v4i32 ((a rn))
                   (clz i32 a)))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Not a lane-parallel atom, so it had no per-lane form before a lane had a body"))

  (definstruction cnt_v
    (mnemonic CNT_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (size 0) (fixed21 16) (opcode 5) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in)
    )
    (asm "cnt $rd, $rn")
    (semantics "Population count of each byte")
    (formal (vmap v16i8 ((a rn)) (cpop i8 a)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Popcount is lane-local and was not on the lane-parallel list, so it needed a body"))

  (definstruction not_v
    (mnemonic NOT_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (size 0) (fixed21 16) (opcode 5) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in)
    )
    (asm "not $rd, $rn")
    (semantics "Bitwise complement of the whole register")
    (formal (not i128 rn))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "No lane structure at all: complementing every bit is the same at any arrangement"))

  (definstruction rbit_v
    (mnemonic RBIT_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (size 1) (fixed21 16) (opcode 5) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in)
    )
    (asm "rbit $rd, $rn")
    (semantics "Reverse the bits within each byte")
    (formal (vmap v16i8 ((a rn))
        (let ((pairs (or i8 (and i8 (shl i8 a 1) 0xaa) (and i8 (lshr i8 a 1) 0x55)))
              (quads (or i8 (and i8 (shl i8 pairs 2) 0xcc) (and i8 (lshr i8 pairs 2) 0x33)))
              (bytes (or i8 (and i8 (shl i8 quads 4) 0xf0) (and i8 (lshr i8 quads 4) 0x0f))))
          bytes)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Three swaps of halves, each naming the one above it -- the shape sequential bindings buy"))

  ; ⚠️ THE REVERSALS, which are permutations with a CONTAINER. REV64 reverses
  ; the elements inside each doubleword, REV32 inside each word, REV16 inside
  ; each halfword -- so the source of output lane i is not a function of i
  ; alone but of i's position within its group, and the groups do not move.
  ;
  ;   source(i) = (i / c) * c + (c - 1) - (i % c)
  ;
  ; where c is how many lanes fit in the container. That is one formula for
  ; all six (instruction, arrangement) combinations below, and it is arithmetic
  ; the expansion evaluates while the lane number is still a constant -- so
  ; what reaches a backend is the constant shift it already understood, and
  ; nothing downstream learns what a byte-swap is.
  ;
  ; Which arrangements exist follows from the container having to hold more
  ; than one element: REV64 reverses bytes, halfwords or words; REV32 reverses
  ; bytes or halfwords; REV16 reverses bytes only. The `requires` says exactly
  ; that, and it is the reason the three have different size bounds rather than
  ; one shared one.

  (definstruction rev64_v
    (mnemonic REV64_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 0) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "rev64 $rd, $rn, arrangement $size")
    (semantics "Reverse the elements within each doubleword")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((x (lane rn (- (+ (* (/ lane-index 8) 8) 7) (% lane-index 8)))))
                   x)
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((x (lane rn (- (+ (* (/ lane-index 4) 4) 3) (% lane-index 4)))))
                   x)
        (vmap v4i32 ((x (lane rn (- (+ (* (/ lane-index 2) 2) 1) (% lane-index 2)))))
                   x))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Endian conversion of a vector, which is a permutation and not arithmetic"))

  (definstruction rev32_v
    (mnemonic REV32_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 0) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 2))
    (asm "rev32 $rd, $rn, arrangement $size")
    (semantics "Reverse the elements within each word")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((x (lane rn (- (+ (* (/ lane-index 4) 4) 3) (% lane-index 4)))))
                   x)
        (vmap v8i16 ((x (lane rn (- (+ (* (/ lane-index 2) 2) 1) (% lane-index 2)))))
                   x)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The U bit halves the container, which is the whole difference"))

  (definstruction rev16_v
    (mnemonic REV16_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 1) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (= size 0))
    (asm "rev16 $rd, $rn, arrangement $size")
    (semantics "Reverse the bytes within each halfword")
    (formal
        (vmap v16i8 ((x (lane rn (- (+ (* (/ lane-index 2) 2) 1) (% lane-index 2)))))
                   x))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The smallest container that can hold two elements, so bytes only"))

  ; ⚠️ WIDENING PAIRWISE ADD, where the geometry does the work. An output lane
  ; is twice an input lane, which means one output lane is EXACTLY the
  ; container holding the two input lanes it sums -- so the `vmap` runs at the
  ; OUTPUT shape, binds `rn`'s lane at that shape, and takes the pair apart
  ; inside the body with a mask and a shift. No cross-lane index is needed at
  ; all: the pairing is what the two widths already mean.
  ;
  ; That is why the accumulating forms need nothing further either. `rd` is
  ; already at the output shape, so it binds like any other lane operand.

  (definstruction saddlp_v
    (mnemonic SADDLP_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 2) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "saddlp $rd, $rn, arrangement $size")
    (semantics "Signed widening pairwise add into lanes of twice the width")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v8i16 ((p rn))
                   (add i16 (sext i16 8 (and i16 p 0xff)) (sext i16 8 (lshr i16 p 8))))
      (select i128 (icmp_eq i2 size 1) (vmap v4i32 ((p rn))
                   (add i32 (sext i32 16 (and i32 p 0xffff)) (sext i32 16 (lshr i32 p 16))))
        (vmap v2i64 ((p rn))
                   (add i64 (sext i64 32 (and i64 p 0xffffffff)) (sext i64 32 (lshr i64 p 32)))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A reduction that keeps every bit, which is what makes it safe to chain"))

  (definstruction uaddlp_v
    (mnemonic UADDLP_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 2) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "uaddlp $rd, $rn, arrangement $size")
    (semantics "Unsigned widening pairwise add")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v8i16 ((p rn))
                   (add i16 (and i16 p 0xff) (lshr i16 p 8)))
      (select i128 (icmp_eq i2 size 1) (vmap v4i32 ((p rn))
                   (add i32 (and i32 p 0xffff) (lshr i32 p 16)))
        (vmap v2i64 ((p rn))
                   (add i64 (and i64 p 0xffffffff) (lshr i64 p 32))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The U bit picks how each half of the container is extended"))

  (definstruction sadalp_v
    (mnemonic SADALP_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 6) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "sadalp $rd, $rn, arrangement $size")
    (semantics "Signed widening pairwise add, accumulated into rd")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v8i16 ((d rd) (p rn))
                   (add i16 d (add i16 (sext i16 8 (and i16 p 0xff)) (sext i16 8 (lshr i16 p 8)))))
      (select i128 (icmp_eq i2 size 1) (vmap v4i32 ((d rd) (p rn))
                   (add i32 d (add i32 (sext i32 16 (and i32 p 0xffff)) (sext i32 16 (lshr i32 p 16)))))
        (vmap v2i64 ((d rd) (p rn))
                   (add i64 d (add i64 (sext i64 32 (and i64 p 0xffffffff)) (sext i64 32 (lshr i64 p 32))))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The accumulating form, where rd is already at the destination shape"))

  (definstruction uadalp_v
    (mnemonic UADALP_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 6) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in)
