  ; ⚠️ THE THREE OPCODES WHERE A FLOAT IS NOT JUST A NUMBER. Everything here
  ; reads its operands as BIT PATTERNS as well as as floats, and that is not a
  ; trick -- it is what the architecture specifies.
  ;
  ; FMULX exists because 0 times infinity is a NaN and a reciprocal-estimate
  ; loop needs it to be 2.0. FRECPS and FRSQRTS are the Newton-Raphson steps
  ; that loop is built from, and they carry the same exception for the same
  ; reason. All three test magnitude by CLEARING THE SIGN BIT and comparing
  ; against the exponent pattern for infinity, which is one `and` and one
  ; integer compare -- where asking "is this infinite" as floating-point
  ; arithmetic would need an operator AXIS does not have.
  ;
  ; The absolute comparisons are the same idea and nothing more: |a| against
  ; |b| is a float compare of the two patterns with their sign bits cleared,
  ; which is why FACGE needs no absolute-value operator either.
  ;
  ; FRECPS is written as a FUSED multiply-add -- 2.0 + (-a) * b, one rounding
  ; -- because that is what the architecture says and an `fsub` of an `fmul`
  ; would round twice. FRSQRTS halves `a` before the fusion, which is exact
  ; for every operand whose exponent can be decremented.

  (definstruction fmulx_v
    (mnemonic FMULX_V) (isa aarch64_base) (category float)
    (format A64_SIMD_3SAME_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 0) (one21 1) (opcode 27) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (sz imm i1 in)
    )
    (asm "fmulx $rd, $rn, $rm, arrangement $sz")
    (semantics "Lanewise multiply where zero times infinity is two")
    (formal
      (select i128 (icmp_eq i1 sz 0) (vmap v4f32 ((a rn) (b rm))
                 (let ((amag (and i32 a 0x7fffffff))
                       (bmag (and i32 b 0x7fffffff))
                       (special (or i32
                          (and i32 (icmp_eq i32 amag 0) (icmp_eq i32 bmag 0x7f800000))
                          (and i32 (icmp_eq i32 amag 0x7f800000) (icmp_eq i32 bmag 0))))
                       (signed-two (or i32 (and i32 (xor i32 a b) 0x80000000) 0x40000000)))
                   (select i32 special signed-two (fmul f32 a b))))
        (vmap v2f64 ((a rn) (b rm))
                 (let ((amag (and i64 a 0x7fffffffffffffff))
                       (bmag (and i64 b 0x7fffffffffffffff))
                       (special (or i64
                          (and i64 (icmp_eq i64 amag 0) (icmp_eq i64 bmag 0x7ff0000000000000))
                          (and i64 (icmp_eq i64 amag 0x7ff0000000000000) (icmp_eq i64 bmag 0))))
                       (signed-two (or i64 (and i64 (xor i64 a b) 0x8000000000000000) 0x4000000000000000)))
                   (select i64 special signed-two (fmul f64 a b))))))
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The multiply a reciprocal-estimate loop needs, which is why it is not FMUL"))

