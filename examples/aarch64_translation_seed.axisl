                   (lo (lane rn (% (* lane-index 2) 16)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 16))))
                 (let ((v (or i16 lo (shl i16 hi 8))))
                   (select i8 (icmp_ult i8 lane-index 8) d
                       (select i16 (icmp_slt i16 0x7f v) 0x7f
                          (select i16 (icmp_slt i16 v 0xff80) 0x80 v)))))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 8)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 8))))
                 (let ((v (or i32 lo (shl i32 hi 16))))
                   (select i16 (icmp_ult i16 lane-index 4) d
                       (select i32 (icmp_slt i32 0x7fff v) 0x7fff
                          (select i32 (icmp_slt i32 v 0xffff8000) 0x8000 v)))))
        (vmap v4i32 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 4)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 4))))
                 (let ((v (or i64 lo (shl i64 hi 32))))
                   (select i32 (icmp_ult i32 lane-index 2) d
                       (select i64 (icmp_slt i64 0x7fffffff v) 0x7fffffff
                          (select i64 (icmp_slt i64 v 0xffffffff80000000) 0x80000000 v))))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The saturating counterpart of XTN, which is why both opcodes exist"))

  (definstruction uqxtn2_v
    (mnemonic UQXTN2_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 20) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_vreg128 i128 in) (size imm i2 in)
