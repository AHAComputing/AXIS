  (definstruction fminnm_v
    (mnemonic FMINNM_V) (isa aarch64_base) (category float)
    (format A64_SIMD_3SAME_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 1) (one21 1) (opcode 24) (one10 1))
    (operands
