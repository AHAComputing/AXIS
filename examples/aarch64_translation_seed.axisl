    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The Q = 0 form of XTN2_V: the same narrowing into the low half, the high half cleared rather than kept"))

