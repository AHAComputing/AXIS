                                        (or i16 0x80 (lshr i16 f 3))))
              (base (select i64 (icmp_ult i16 scaled 256)
                            (add i64 (mul i64 scaled 2) 1)
                            (mul i64 (add i64 (and i64 scaled 0x1fe) 1) 2)))
              (root (fsqrt f64 (fdiv f64 0x41b0000000000000 (fcvt_u2f f64 64 base))))
              (guess (fcvt_f2u i64 64 root))
              (start (maxu i64 513 (sub i64 guess 1)))
              (c1 (add i64 start 1))
              (c2 (add i64 start 2))
              (fits0 (icmp_uge i64 (mul i64 (mul i64 base start) start) 0x10000000))
              (fits1 (icmp_uge i64 (mul i64 (mul i64 base c1) c1) 0x10000000))
              (fits2 (icmp_uge i64 (mul i64 (mul i64 base c2) c2) 0x10000000))
              (m (select i64 fits0 start
                   (select i64 fits1 c1 (select i64 fits2 c2 (add i64 start 3)))))
              (estimate (lshr i64 m 1))
              (result-exp (lshr i16 (sub i16 44 e) 1))
              (normal (or i16 (shl i16 (and i16 result-exp 0x1f) 10)
                               (and i16 (shl i16 (and i16 estimate 0xff) 2)
                                         0x3ff))))
          (select i16 is-nan 0x7e00
            (select i16 is-zero (or i16 sign 0x7c00)
              (select i16 negative 0x7e00
                (select i16 nan-or-inf 0 normal)))))) 0xffff))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The reciprocal square-root estimate at half precision, from the same parameterised formula"))

  (definstruction movi_16b
    (mnemonic MOVI_16B) (isa aarch64_base) (category float) (format A64_SIMD_MODIMM)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (op 0) (fixed 480) (cmode 14) (o2 0) (one 1))
    (operands
      (rd a64_vreg128 i128 out)
      (imm imm i8 in)
    )
    (asm "movi $rd, $imm")
    (semantics "The immediate in every byte of the register")
    ; A byte splat written as one multiply. Each partial product is the 8-bit
    ; immediate times a single 1 bit, so no partial product exceeds a byte and
    ; none of them carries -- the product places `imm` in all sixteen bytes
    ; exactly. The lane machinery is not needed because nothing is per-lane
    ; arithmetic here, only placement.
    (formal (mul i128 imm 0x01010101010101010101010101010101))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The `op=0` half of the same modified-immediate encoding MOVI_2D uses"))

  (definstruction dup_v_gen
    (mnemonic DUP_V_GEN) (isa aarch64_base) (category float) (format A64_SIMD_COPY)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (fixed 112) (zero15 0) (opcode 1) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_gpr64 i64 in) (imm5 imm i5 in)
    )
    ; `imm5 = x0000` names no lane width and is unallocated.
    (requires (and (!= imm5 0) (!= imm5 16)))
    (asm "dup $rd, $rn, arrangement $imm5")
    (semantics "Broadcast a general register into every lane; `imm5` names the lane width")
    ; The LOWEST SET BIT of `imm5` names the lane width -- bit 0 for bytes, then
    ; halves, words, doublewords -- so the tests run in that order and the last
    ; branch is the doubleword case rather than a fifth test. The broadcast
    ; itself is a multiply by the constant holding a single 1 at the bottom of
    ; each lane: every partial product is one lane wide, so none of them carries
    ; into the next.
    (formal (select i128 (icmp_eq i5 (and i5 imm5 1) 1) (mul i128 (and i128 rn 0xff) 0x01010101010101010101010101010101)
        (select i128 (icmp_eq i5 (and i5 imm5 2) 2) (mul i128 (and i128 rn 0xffff) 0x00010001000100010001000100010001)
        (select i128 (icmp_eq i5 (and i5 imm5 4) 4) (mul i128 (and i128 rn 0xffffffff) 0x00000001000000010000000100000001)
        (mul i128 (and i128 rn 0xffffffffffffffff) 0x00000000000000010000000000000001)))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The commonest vector word after MOVI: how a scalar enters a vectorised loop"))

  (definstruction ins_v_gen
    (mnemonic INS_V_GEN) (isa aarch64_base) (category float) (format A64_SIMD_COPY)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (fixed 112) (zero15 0) (opcode 3) (one10 1))
    (operands
      (rd a64_vreg128 i128 inout) (rn a64_gpr64 i64 in) (imm5 imm i5 in)
    )
    ; `imm5 = x0000` names no lane width and is unallocated.
    (requires (and (!= imm5 0) (!= imm5 16)))
    (asm "ins $rd, $imm5, $rn")
    (semantics "Insert a general register into the lane `imm5` names, leaving the others")
    ; `imm5` carries the lane index in the bits ABOVE the one that names the
    ; size, so each branch shifts the index it reads by that branch's lane
    ; width. `rd` is read as well as written, which is why it is `inout`: every
    ; lane but the named one survives.
    (formal (select i128 (icmp_eq i5 (and i5 imm5 1) 1)
        (or i128 (and i128 rd (not i128 (shl i128 0xff (mul i128 (and i128 (lshr i128 imm5 1) 0xf) 8))))
                   (shl i128 (and i128 rn 0xff) (mul i128 (and i128 (lshr i128 imm5 1) 0xf) 8)))
        (select i128 (icmp_eq i5 (and i5 imm5 2) 2)
        (or i128 (and i128 rd (not i128 (shl i128 0xffff (mul i128 (and i128 (lshr i128 imm5 2) 0x7) 16))))
                   (shl i128 (and i128 rn 0xffff) (mul i128 (and i128 (lshr i128 imm5 2) 0x7) 16)))
        (select i128 (icmp_eq i5 (and i5 imm5 4) 4)
        (or i128 (and i128 rd (not i128 (shl i128 0xffffffff (mul i128 (and i128 (lshr i128 imm5 3) 0x3) 32))))
                   (shl i128 (and i128 rn 0xffffffff) (mul i128 (and i128 (lshr i128 imm5 3) 0x3) 32)))
        (or i128 (and i128 rd (not i128 (shl i128 0xffffffffffffffff (mul i128 (and i128 (lshr i128 imm5 4) 0x1) 64))))
                   (shl i128 (and i128 rn 0xffffffffffffffff) (mul i128 (and i128 (lshr i128 imm5 4) 0x1) 64)))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A disassembler prints this as `mov v1.d[0], x9`; it reads its destination because the other lanes survive"))

  (definstruction braaz
    (mnemonic BRAAZ) (isa aarch64_base) (category custom) (format A64_BRANCH_REG)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 3508162) (fixed0 31))
    (operands
      (rn a64_gpr64 i64 in)
    )
    (asm "braaz $rn")
    (implementation axis_impl_braaz)
    (semantics "Authenticate rn with key A and a zero modifier, then branch. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The branch beside BLRAAZ, which was described and this was not"))

  (definstruction blraa
    (mnemonic BLRAA) (isa aarch64_base) (category custom) (format A64_BRANCH_REG_AUTH)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 3526594))
    (operands
      (rn a64_gpr64 i64 in)
      (rm a64_gpr64sp i64 in)
    )
    (asm "blraa $rn, $rm")
    (implementation axis_impl_blraa)
    (semantics "Authenticate rn with key A and rm as the modifier, then branch with link. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The linking counterpart of BRAA"))

  ; --- The last seven forms --------------------------------------------------
  ; Each needed its own layout, which is why they were left until the frequent
  ; ones were done. In a mining context that ordering is about cost, not value:
  ; one undecoded word ends a region, so a form appearing twice in the right
  ; function costs more than its share of the word count suggests.

  (definstruction fmov_d_imm
    (mnemonic FMOV_D_IMM) (isa aarch64_base) (category float) (format A64_FP_IMM)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fixed12 4) (zero9 0))
    (operands
      (rd a64_vreg64 i64 out)
      (imm imm i8 in)
    )
    (asm "fmov $rd, $imm")
    (semantics "An 8-bit encoded double constant expanded to IEEE-754: sign is imm<7>, the 11-bit exponent is NOT(imm<6>) then imm<6> repeated eight times then imm<5:4>, and the fraction is imm<3:0> followed by 48 zeros")
    (behavior
      (set rd
        (or i64
          (shl i64 (and i64 (lshr i64 imm 7) 1) 63)
          (or i64
            (shl i64
              (or i64
                (shl i64 (xor i64 (and i64 (lshr i64 imm 6) 1) 1) 10)
                (or i64
                  (shl i64 (mul i64 (and i64 (lshr i64 imm 6) 1) 255) 2)
                  (and i64 (lshr i64 imm 4) 3)))
              52)
            (shl i64 (and i64 imm 15) 48)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Six of the remaining words; how a small constant like 1.0 reaches a float register"))

  (definstruction fmsub_d
    (mnemonic FMSUB_D) (isa aarch64_base) (category float) (format A64_FP_DP3)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 250) (o0 1))
    (operands
      (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in)
      (rm a64_vreg64 i64 in) (ra a64_vreg64 i64 in)
    )
    (asm "fmsub $rd, $rn, $rm, $ra")
    (semantics "ra - rn * rm, fused: one rounding, not two")
    (behavior
      (set rd (fma_rm f64 (a64_rmode fpcr) (xor i64 rn 0x8000000000000000) rm ra))
    )
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The fused multiply-subtract, whose sign is on the multiplicand and whose single rounding is the point"))

  ; ⚠️ The other three corners of A64_FP_DP3. The group is selected by two
  ; bits -- `o1` inside the fixed field and `o0` beside Rm -- and only one of
  ; its four combinations was described. ARM defines all four as one fused
  ; multiply-add with the signs of the multiplicand and the addend varied:
  ;
  ;   FMADD   Ra + Rn*Rm        FMSUB   Ra + (-Rn)*Rm
  ;   FNMADD  -Ra + (-Rn)*Rm    FNMSUB  -Ra + Rn*Rm
  ;
  ; ⚠️ ONE rounding, which is the whole point of the group and the reason
  ; these are not a multiply followed by an add. The negations are exact --
  ; a sign-bit flip on the i64 pattern -- so they introduce no rounding of
  ; their own, and the fused step is the only place a result is rounded.
  (definstruction fmadd_d
    (mnemonic FMADD_D) (isa aarch64_base) (category float) (format A64_FP_DP3)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 250) (o0 0))
    (operands
      (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in)
      (rm a64_vreg64 i64 in) (ra a64_vreg64 i64 in)
    )
    (asm "fmadd $rd, $rn, $rm, $ra")
    (semantics "ra + rn * rm, fused: one rounding, not two")
    (behavior
      (set rd (fma_rm f64 (a64_rmode fpcr) rn rm ra))
    )
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The fused multiply-add itself, whose single rounding is what separates it from a multiply and an add"))

  (definstruction fnmadd_d
    (mnemonic FNMADD_D) (isa aarch64_base) (category float) (format A64_FP_DP3)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 251) (o0 0))
    (operands
      (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in)
      (rm a64_vreg64 i64 in) (ra a64_vreg64 i64 in)
    )
    (asm "fnmadd $rd, $rn, $rm, $ra")
    (semantics "-ra - rn * rm, fused: one rounding, not two")
    (behavior
      (set rd (fma_rm f64 (a64_rmode fpcr)
                (xor i64 rn 0x8000000000000000) rm
                (xor i64 ra 0x8000000000000000)))
    )
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Both signs flipped: the negated fused multiply-add, which is not the negation of FMADD when a NaN is involved"))

  (definstruction fnmsub_d
    (mnemonic FNMSUB_D) (isa aarch64_base) (category float) (format A64_FP_DP3)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 251) (o0 1))
    (operands
      (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in)
      (rm a64_vreg64 i64 in) (ra a64_vreg64 i64 in)
    )
    (asm "fnmsub $rd, $rn, $rm, $ra")
    (semantics "-ra + rn * rm, fused: one rounding, not two")
    (behavior
      (set rd (fma_rm f64 (a64_rmode fpcr) rn rm
                (xor i64 ra 0x8000000000000000)))
    )
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The addend negated and the multiplicand not: the fourth corner, and the one whose name reads least like what it does"))

  (definstruction fcsel_d
    (mnemonic FCSEL_D) (isa aarch64_base) (category float) (format A64_FP_CSEL)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fixed11 3))
    (operands
      (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in)
      (rm a64_vreg64 i64 in) (cond imm i4 in)
    )
    (asm "fcsel $rd, $rn, $rm, cond $cond")
    (semantics "rn when the condition holds, rm otherwise")
    (behavior
      (set rd (select (a64_cond_holds i4 nzcv cond) rn rm))
    )
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A branchless float choice, which reads NZCV rather than writing it"))

  (definstruction fccmp_d
    (mnemonic FCCMP_D) (isa aarch64_base) (category float) (format A64_FP_CCMP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fixed11 1) (op 0))
    (operands
      (rn a64_vreg64 i64 in) (rm a64_vreg64 i64 in)
      (cond imm i4 in) (alt imm i4 in)
    )
    (asm "fccmp $rn, $rm, $alt, cond $cond")
    (semantics "Compare when the condition holds, otherwise take the encoded NZCV")
    ; The replacement flags are `alt` and not `nzcv`: an operand sharing a name
    ; with an architectural register makes every read of it ambiguous, and the
    ; backends resolved it differently -- the golden model wanted 7 where the C
    ; executor produced 8, from one description. Naming them apart is the fix,
    ; and the disagreement is what said so.
    (behavior
      (setstate nzcv
        (select (a64_cond_holds i4 nzcv cond)
          (if i32 (fcmp_uno f64 rn rm) 3
            (if i32 (fcmp_oeq f64 rn rm) 6
              (if i32 (fcmp_olt f64 rn rm) 8 2)))
          alt) i4)
    )
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A chained float comparison, which substitutes flags rather than branching"))

  (definstruction scvtf_d_x_fixed
    (mnemonic SCVTF_D_X_FIXED) (isa aarch64_base) (category float)
    (format A64_FP_FIXED)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 1266) (opcode 2))
    (operands
      (rd a64_vreg64 i64 out) (rn a64_gpr64 i64 in) (scale imm i6 in (asm (minus-from 64)))
    )
    (asm "scvtf $rd, $rn, fbits $scale")
    (semantics "Convert a signed 64-bit fixed-point value with 64-scale fraction bits to double: the integer conversion, then a scale by a power of two, which is exact. The assembly prints fbits, which is 64 minus the encoded field, and the operand says so")
    (behavior
      (set rd
        (fmul f64
          (fcvt_s2f f64 64 rn)
          (shl i64 (add i64 scale 959) 52))))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Bit 21 clear is the whole difference from the integer conversion"))

  (definstruction cmeq_zero_v
    (mnemonic CMEQ_ZERO_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed21 16) (opcode 9) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (asm "cmeq $rd, $rn, 0, arrangement $size")
    (semantics "All-ones in each lane equal to zero, all-zeros in the rest")
    ; A lane-wise compare writes a MASK, not the 1 or 0 a scalar compare
    ; answers, which is why `icmp_eq` over a vector type is expanded as a
    ; compare widened to the lane rather than as an ordinary lane-parallel
    ; operator -- see LANE_COMPARE in src/simd.rs.
    (formal (select i128 (icmp_eq i2 size 0) (icmp_eq v16i8 rn 0)
      (select i128 (icmp_eq i2 size 1) (icmp_eq v8i16 rn 0)
        (select i128 (icmp_eq i2 size 2) (icmp_eq v4i32 rn 0)
                                        (icmp_eq v2i64 rn 0)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Comparing a vector against zero without spending a register on the zero"))

  (definstruction addp_d
    (mnemonic ADDP_D) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 30) (size 3) (fixed21 24) (opcode 27) (fixed11 2))
    (operands
      (rd a64_vreg64 i64 out) (rn a64_vreg128 i128 in)
    )
    (asm "addp $rd, $rn")
    (semantics "The two 64-bit lanes of rn added into a scalar")
    ; A reduction, not a lane-parallel operator: the two lanes meet, which is
    ; precisely what the lane masking exists to prevent elsewhere. Evaluated at
    ; i64, so each operand is taken as the low 64 bits of what it is given --
    ; `rn` is lane 0 and `rn >> 64` is lane 1.
    (formal (add i64 rn (lshr i128 rn 64)))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "How a vectorised reduction ends, which is why it appears at the bottom of a loop"))

  (definstruction fcvtzu_x_d
    (mnemonic FCVTZU_X_D) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 1267) (fpop 1600))
    (operands (rd a64_gpr64 i64 out) (rn a64_vreg64 i64 in))
    (asm "fcvtzu $rd, $rn")
    (semantics "Convert a double to an unsigned 64-bit integer, rounding toward zero")
    (behavior (set rd (fcvt_f2u i64 64 rn)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The 64-bit destination"))

  ; --- MOVI, the `cmode=1110` form -------------------------------------------
  ; The one a compiler emits to zero a vector register, and the commonest SIMD
  ; word a real binary has that this description could not name. `cmode=1110`
  ; with `op=1` expands the eight-bit immediate by **replicating each bit into a
  ; byte** -- bit `i` set means byte `i` is 0xff -- which is why the expression
  ; is a byte at a time rather than a shift of the immediate.

  (definstruction movi_d
    (mnemonic MOVI_D) (isa aarch64_base) (category float)
    (format A64_SIMD_MODIMM)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 0) (op 1) (fixed 480) (cmode 14) (o2 0) (one 1))
    (operands
      (rd a64_vreg64 i64 out)
      (imm imm i8 in)
    )
    (asm "movi $rd, $imm")
    (semantics "Each bit of the 8-bit immediate becomes a byte of the 64-bit result")
    (behavior
      (set rd (or i64 (shl i64 (mul i64 (and i64 (lshr i64 imm 0) 1) 255) 0) (or i64 (shl i64 (mul i64 (and i64 (lshr i64 imm 1) 1) 255) 8) (or i64 (shl i64 (mul i64 (and i64 (lshr i64 imm 2) 1) 255) 16) (or i64 (shl i64 (mul i64 (and i64 (lshr i64 imm 3) 1) 255) 24) (or i64 (shl i64 (mul i64 (and i64 (lshr i64 imm 4) 1) 255) 32) (or i64 (shl i64 (mul i64 (and i64 (lshr i64 imm 5) 1) 255) 40) (or i64 (shl i64 (mul i64 (and i64 (lshr i64 imm 6) 1) 255) 48) (shl i64 (mul i64 (and i64 (lshr i64 imm 7) 1) 255) 56)))))))))
    )
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "40 of the SIMD words in eight system binaries; `movi d0, #0` is how a double is zeroed"))

  (definstruction movi_2d
    (mnemonic MOVI_2D) (isa aarch64_base) (category float)
    (format A64_SIMD_MODIMM)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (op 1) (fixed 480) (cmode 14) (o2 0) (one 1))
    (operands
      (rd a64_vreg128 i128 out)
      (imm imm i8 in)
    )
    (asm "movi $rd, $imm")
    (semantics "Each bit of the immediate as a whole byte, that doubleword filling both halves")
    ; Not a splat of the immediate: each BIT of it expands to a whole byte,
    ; all-ones or all-zeros. Eight terms, one per bit, because that is what the
    ; instruction is -- no arithmetic identity stands in for it the way a
    ; multiply stands in for MOVI_16B's byte splat.
    ;
    ; That builds 64 bits, and the 2D form replicates them into BOTH
    ; doublewords, which is the multiply by a constant holding a 1 at the
    ; bottom of each half -- the same broadcast-by-multiply used above.
    (formal
      (mul i128 0x00000000000000010000000000000001
        (or i128 (or i128 (or i128 (or i128 (or i128 (or i128 (or i128 (shl i128 (mul i128 (and i128 (lshr i128 imm 0) 1) 0xff) 0)
          (shl i128 (mul i128 (and i128 (lshr i128 imm 1) 1) 0xff) 8))
          (shl i128 (mul i128 (and i128 (lshr i128 imm 2) 1) 0xff) 16))
          (shl i128 (mul i128 (and i128 (lshr i128 imm 3) 1) 0xff) 24))
          (shl i128 (mul i128 (and i128 (lshr i128 imm 4) 1) 0xff) 32))
          (shl i128 (mul i128 (and i128 (lshr i128 imm 5) 1) 0xff) 40))
          (shl i128 (mul i128 (and i128 (lshr i128 imm 6) 1) 0xff) 48))
          (shl i128 (mul i128 (and i128 (lshr i128 imm 7) 1) 0xff) 56))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Decodes and disassembles; its value is wider than any executor's, which is said rather than approximated"))

  ; --- Scalar floating point: moves, sign, conversions, compare ---------------
  ; Unlike pointer authentication these *are* stateable, so they state it. The
  ; sign operations are bit operations on purpose: AArch64 defines FNEG and FABS
  ; as flipping and clearing the sign bit, which is exact for NaNs where an
  ; arithmetic negation would not be.

  (definstruction fmov_d
    (mnemonic FMOV_D) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 16))
    (operands (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in))
    (asm "fmov $rd, $rn")
    (semantics "Copy one double register to another, bit for bit")
    (behavior (set rd rn))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A register-to-register move in the FP file, which no FP operator is needed to state"))

  (definstruction fneg_d
    (mnemonic FNEG_D) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 80))
    (operands (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in))
    (asm "fneg $rd, $rn")
    (semantics "Flip the sign bit")
    (behavior (set rd (xor i64 rn 0x8000000000000000)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The architecture defines it on the sign bit, so the description does too"))

  (definstruction fabs_d
    (mnemonic FABS_D) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 48))
    (operands (rd a64_vreg64 i64 out) (rn a64_vreg64 i64 in))
    (asm "fabs $rd, $rn")
    (semantics "Clear the sign bit")
    (behavior (set rd (and i64 rn 0x7fffffffffffffff)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Exact for NaNs, which an arithmetic absolute value would not be"))

  (definstruction scvtf_d_w
    (mnemonic SCVTF_D_W) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 128))
    (operands (rd a64_vreg64 i64 out) (rn a64_gpr32 i32 in))
    (asm "scvtf $rd, $rn")
    (semantics "Convert a signed 32-bit integer to double")
    (behavior (set rd (fcvt_s2f f64 32 rn)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The int-to-float direction a compiled loop counter takes"))

  (definstruction scvtf_d_x
    (mnemonic SCVTF_D_X) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 1267) (fpop 128))
    (operands (rd a64_vreg64 i64 out) (rn a64_gpr64 i64 in))
    (asm "scvtf $rd, $rn")
    (semantics "Convert a signed 64-bit integer to double")
    (behavior (set rd (fcvt_s2f f64 64 rn)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The 64-bit source form, told apart by sf"))

  (definstruction fcvtzs_w_d
    (mnemonic FCVTZS_W_D) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 1536))
    (operands (rd a64_gpr32 i32 out) (rn a64_vreg64 i64 in))
    (asm "fcvtzs $rd, $rn")
    (semantics "Convert a double to a signed 32-bit integer, rounding toward zero")
    (behavior (set rd (fcvt_f2s i32 64 rn)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The float-to-int direction, which rounds toward zero regardless of FPCR"))

  (definstruction fcvtzs_x_d
    (mnemonic FCVTZS_X_D) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 1267) (fpop 1536))
    (operands (rd a64_gpr64 i64 out) (rn a64_vreg64 i64 in))
    (asm "fcvtzs $rd, $rn")
    (semantics "Convert a double to a signed 64-bit integer, rounding toward zero")
