  ; ⚠️ POLYNOMIAL MULTIPLY -- the same shift-and-combine as an ordinary
  ; multiply with the addition replaced by `xor`, which is to say with the
  ; carries removed. It is a chain of eight steps, each naming the one above
  ; it, and that is a shape a lane operator could not hold until `let` bindings
  ; became sequential and `vmap` gave the operator a body.
  ;
  ; Bytes only. `size` is pinned in the encoding rather than carried as an
  ; operand, the way the logical operations at opcode 3 already are, because
  ; one legal value is not a field.

  (definstruction pmul_v
    (mnemonic PMUL_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (size 0) (one21 1) (opcode 19) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
    )
    (asm "pmul $rd, $rn, $rm")
    (semantics "Lanewise carry-less multiply of bytes, the low byte of each product")
    (formal
      (vmap v16i8 ((a rn) (b rm))
        (let ((acc0 (select i8 (icmp_ne i8 (and i8 b 0x1) 0) (shl i8 a 0) 0))
              (acc1 (xor i8 acc0 (select i8 (icmp_ne i8 (and i8 b 0x2) 0) (shl i8 a 1) 0)))
              (acc2 (xor i8 acc1 (select i8 (icmp_ne i8 (and i8 b 0x4) 0) (shl i8 a 2) 0)))
              (acc3 (xor i8 acc2 (select i8 (icmp_ne i8 (and i8 b 0x8) 0) (shl i8 a 3) 0)))
              (acc4 (xor i8 acc3 (select i8 (icmp_ne i8 (and i8 b 0x10) 0) (shl i8 a 4) 0)))
              (acc5 (xor i8 acc4 (select i8 (icmp_ne i8 (and i8 b 0x20) 0) (shl i8 a 5) 0)))
              (acc6 (xor i8 acc5 (select i8 (icmp_ne i8 (and i8 b 0x40) 0) (shl i8 a 6) 0)))
              (acc7 (xor i8 acc6 (select i8 (icmp_ne i8 (and i8 b 0x80) 0) (shl i8 a 7) 0))))
          acc7)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The multiply a CRC or a GCM authentication tag is built out of"))

  ; ⚠️ SATURATING DOUBLING MULTIPLY, RETURNING THE HIGH HALF -- the fixed-point
  ; multiply, where operands are fractions in [-1, 1) and the product must come
  ; back in the same format. Doubling is what turns a Q15 product back into
  ; Q15; taking the high half is what discards the bits that no longer fit.
  ;
  ; Exactly one input pair overflows, and it is worth naming rather than
  ; deriving: -1 times -1 is +1, which a signed lane cannot hold. Every other
  ; pair fits, including under the rounding form, so the saturation is a single
  ; test against both operands being the most negative value rather than a
  ; range check on the result.
  ;
