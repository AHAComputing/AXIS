    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A fused shape in the encoding rather than in the arithmetic; the rounding is unchanged"))

  (definstruction mls_v
    (mnemonic MLS_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (one21 1) (opcode 18) (one10 1))
