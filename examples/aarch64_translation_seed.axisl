  ; doubleword form -- which is a hole in the middle of the field rather than a
  ; bound, and `(and (> size 0) (< size 3))` is how a description says that.

  (definstruction sqdmulh_v
    (mnemonic SQDMULH_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 22) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (and (> size 0) (< size 3)))
    (asm "sqdmulh $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise signed saturating doubling multiply, high half")
    (formal
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn) (b rm))
