  ;; Complete scalar signed-imm9 writeback families. The table rows preserve
  ;; architectural encoding and result widths while the templates make
  ;; pre/post effect ordering explicit.
  (definstruction-family a64-writeback-load-pre
    ($name $mnemonic $size $opc $rt-kind $rt-type $mem-type $signedness $asm)
    (
     (ldr_b_w_pre LDRB_W_PRE 0 1 a64_gpr32 i32 i8 unsigned "ldrb $rt, [$rn, $imm]!")
     (ldrsb_x_pre LDRSB_X_PRE 0 2 a64_gpr64 i64 i8 signed "ldrsb $rt, [$rn, $imm]!")
     (ldrsb_w_pre LDRSB_W_PRE 0 3 a64_gpr32 i32 i8 signed "ldrsb $rt, [$rn, $imm]!")
     (ldr_h_w_pre LDRH_W_PRE 1 1 a64_gpr32 i32 i16 unsigned "ldrh $rt, [$rn, $imm]!")
     (ldrsh_x_pre LDRSH_X_PRE 1 2 a64_gpr64 i64 i16 signed "ldrsh $rt, [$rn, $imm]!")
     (ldrsh_w_pre LDRSH_W_PRE 1 3 a64_gpr32 i32 i16 signed "ldrsh $rt, [$rn, $imm]!")
     (ldr_w_pre LDR_W_PRE 2 1 a64_gpr32 i32 i32 unsigned "ldr $rt, [$rn, $imm]!")
     (ldrsw_x_pre LDRSW_X_PRE 2 2 a64_gpr64 i64 i32 signed "ldrsw $rt, [$rn, $imm]!"))
    (definstruction $name
      (mnemonic $mnemonic) (isa aarch64_base) (category custom) (format A64_LDST_INDEXED)
      (opcode 0) (func3 0) (func7 0)
      (encoding (size $size) (fixed 56) (opc $opc) (fixed21 0) (mode 3))
      (operands (rt $rt-kind $rt-type out) (rn a64_gpr64sp i64 inout) (imm imm i9 in))
      (asm $asm) (semantics "pre-index typed scalar load")
      (behavior (set rn (add rn (sext i64 9 imm))) (set rt (load $mem-type $signedness rn)))
      (latency 3) (throughput 0.5) (area-estimate-um2 0.0) (power-estimate-mw 0.0)
      (expected-speedup 1.0) (rationale "AArch64 typed pre-index scalar load")))

  (definstruction-family a64-writeback-load-post
    ($name $mnemonic $size $opc $rt-kind $rt-type $mem-type $signedness $asm)
    (
     (ldr_b_w_post LDRB_W_POST 0 1 a64_gpr32 i32 i8 unsigned "ldrb $rt, [$rn], $imm")
     (ldrsb_x_post LDRSB_X_POST 0 2 a64_gpr64 i64 i8 signed "ldrsb $rt, [$rn], $imm")
     (ldrsb_w_post LDRSB_W_POST 0 3 a64_gpr32 i32 i8 signed "ldrsb $rt, [$rn], $imm")
     (ldr_h_w_post LDRH_W_POST 1 1 a64_gpr32 i32 i16 unsigned "ldrh $rt, [$rn], $imm")
     (ldrsh_x_post LDRSH_X_POST 1 2 a64_gpr64 i64 i16 signed "ldrsh $rt, [$rn], $imm")
     (ldrsh_w_post LDRSH_W_POST 1 3 a64_gpr32 i32 i16 signed "ldrsh $rt, [$rn], $imm")
     (ldr_w_post LDR_W_POST 2 1 a64_gpr32 i32 i32 unsigned "ldr $rt, [$rn], $imm")
     (ldrsw_x_post LDRSW_X_POST 2 2 a64_gpr64 i64 i32 signed "ldrsw $rt, [$rn], $imm"))
    (definstruction $name
      (mnemonic $mnemonic) (isa aarch64_base) (category custom) (format A64_LDST_INDEXED)
      (opcode 0) (func3 0) (func7 0)
      (encoding (size $size) (fixed 56) (opc $opc) (fixed21 0) (mode 1))
      (operands (rt $rt-kind $rt-type out) (rn a64_gpr64sp i64 inout) (imm imm i9 in))
      (asm $asm) (semantics "post-index typed scalar load")
      (behavior (set rt (load $mem-type $signedness rn)) (set rn (add rn (sext i64 9 imm))))
      (latency 3) (throughput 0.5) (area-estimate-um2 0.0) (power-estimate-mw 0.0)
      (expected-speedup 1.0) (rationale "AArch64 typed post-index scalar load")))

  (definstruction-family a64-writeback-store-pre
    ($name $mnemonic $size $rt-kind $rt-type $mem-type $asm)
    (
     (str_b_w_pre STRB_W_PRE 0 a64_gpr32 i32 i8 "strb $rt, [$rn, $imm]!")
