  ; ⚠️ FLOAT TO INTEGER IN FIVE ROUNDING MODES, and back in two signednesses.
  ; The five differ only in how they round, and rounding a float to an
  ; INTEGRAL FLOAT is already described above -- so each of these is one of
  ; those followed by a conversion, and the conversion's own truncation is a
  ; no-op because its operand is integral by then. FCVTZ needs no pre-rounding
  ; at all: truncation is what the conversion does unaided.
  ;
  ; The saturation is the conversion's, not the description's, and it was
  ; measured rather than assumed: `fcvt_f2s` already answers INT_MIN and
  ; INT_MAX at the ends and ZERO for a NaN, which is exactly AArch64's rule.
  ; A description that clamped by hand on top of that would be saying the same
  ; thing twice and would have two places to get the boundary wrong.
  ;
  ; SCVTF and UCVTF go the other way and are the conversion alone -- the lane
  ; read as a signed or an unsigned integer. The U bit picks which, which is
  ; the whole of the difference between them.

  (definstruction fcvtns_v
    (mnemonic FCVTNS_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 0) (fixed21 16) (opcode 26) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (sz imm i1 in)
    )
    (asm "fcvtns $rd, $rn, arrangement $sz")
    (semantics "Convert to signed, rounding to nearest with ties to even")
    (formal
      (select i128 (icmp_eq i1 sz 0) (vmap v4f32 ((a rn))
                 (fcvt_f2s i32 32 (a64_frintn_32 a)))
        (vmap v2f64 ((a rn))
                 (fcvt_f2s i64 64 (a64_frintn_64 a)))))
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The default rounding, which is the mode a language's cast almost never uses"))

  (definstruction fcvtnu_v
