  ;; Conditional compare: true path computes arithmetic flags; false path
  ;; installs the instruction's literal NZCV value.
  (definstruction ccmn_x_reg
    (mnemonic CCMN_X_REG) (isa aarch64_base) (category custom) (format A64_COND_COMPARE)
    (opcode 0) (func3 0) (func7 0) (encoding (sf 1) (op 0) (s 1) (fixed 210) (immediate 0) (fixed10 0) (fixed4 0))
    (operands (rn a64_gpr64 i64 in) (rhs a64_gpr64 i64 in) (cond imm i4 in) (literal imm i4 in))
    (asm "ccmn $rn, $rhs, $literal, $cond") (semantics "if cond then NZCV = flags(rn + rhs), else NZCV = literal")
    (behavior (setstate nzcv (select i4 (a64_cond_holds i4 nzcv cond) (a64_add_nzcv i64 rn rhs) literal) i4))
    (latency 1) (throughput 1.0) (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "64-bit conditional compare-negative register form"))
  (definstruction ccmp_x_reg
    (mnemonic CCMP_X_REG) (isa aarch64_base) (category custom) (format A64_COND_COMPARE)
