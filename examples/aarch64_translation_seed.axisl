      (size imm i2 in)
    )
    (requires (< size 4))
    (asm "sqadd $rd, $rn, $rm, scalar $size")
    (semantics "Signed saturating add, scalar")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn) (b rm)) (select i8 (icmp_eq i8 lane-index 0) (a64_sqadd_8 a b) 0)) (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn) (b rm)) (select i16 (icmp_eq i16 lane-index 0) (a64_sqadd_16 a b) 0)) (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((a rn) (b rm)) (select i32 (icmp_eq i32 lane-index 0) (a64_sqadd_32 a b) 0)) (vmap v2i64 ((a rn) (b rm)) (select i64 (icmp_eq i64 lane-index 0) (a64_sqadd_64 a b) 0))))))
