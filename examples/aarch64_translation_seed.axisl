      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "add $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise add at the arrangement `size` names; the low 64 bits, the upper cleared")
    (formal
      (and i128 (select i128 (icmp_eq i2 size 0) (add v16i8 rn rm) (select i128 (icmp_eq i2 size 1) (add v8i16 rn rm) (select i128 (icmp_eq i2 size 2) (add v4i32 rn rm) (add v2i64 rn rm)))) 0xffffffffffffffff))
