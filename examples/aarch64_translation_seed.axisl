                             (y (lane rm (/ lane-index 2))))
          (select i16 (icmp_eq i16 (and i16 lane-index 1) 0) x y))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((x (lane rn (/ lane-index 2)))
                             (y (lane rm (/ lane-index 2))))
          (select i32 (icmp_eq i32 (and i32 lane-index 1) 0) x y))
        (vmap v2i64 ((x (lane rn (/ lane-index 2)))
                             (y (lane rm (/ lane-index 2))))
          (select i64 (icmp_eq i64 (and i64 lane-index 1) 0) x y))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The permutation the cross-lane machinery was built to describe"))

  (definstruction uzp2_v
    (mnemonic UZP2_V) (isa aarch64_base) (category float) (format A64_SIMD_PERMUTE)
    (opcode 0) (func3 0) (func7 0)
