  ; Element copies (DUP by element, SMOV, UMOV, INS by element), the
  ; fixed-point conversions, FMOV (vector immediate), FRINT32Z/64Z and
  ; FRECPX. A copy's `imm5` names the element size by its lowest set bit and
  ; the element by the bits above it. A fixed-point conversion is the plain one
  ; scaled by 2^fbits, which is exact, so it rounds once, where Arm does.
  (definstruction dup_elem_v
    (mnemonic DUP_ELEM_V) (isa aarch64_base) (category float)
    (format A64_SIMD_COPY)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (fixed 112) (zero15 0) (opcode 0) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (imm5 imm i5 in)
    )
    (requires (and (!= imm5 0) (!= imm5 16)))
    (asm "dup $rd, $rn, element $imm5")
    (semantics "Broadcast one element of rn to every lane")
    (formal
      (select i128 (icmp_eq i5 (and i5 imm5 1) 1) (mul i128 (and i128 (lshr i128 rn (mul i128 (lshr i128 (zext i128 5 imm5) 1) 8)) 0xff) 0x01010101010101010101010101010101)
        (select i128 (icmp_eq i5 (and i5 imm5 3) 2) (mul i128 (and i128 (lshr i128 rn (mul i128 (lshr i128 (zext i128 5 imm5) 2) 16)) 0xffff) 0x00010001000100010001000100010001)
        (select i128 (icmp_eq i5 (and i5 imm5 7) 4) (mul i128 (and i128 (lshr i128 rn (mul i128 (lshr i128 (zext i128 5 imm5) 3) 32)) 0xffffffff) 0x00000001000000010000000100000001)
        (mul i128 (and i128 (lshr i128 rn (mul i128 (lshr i128 (zext i128 5 imm5) 4) 64)) 0xffffffffffffffff) 0x00000000000000010000000000000001)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The splat of a lane, the by-element operand's other half"))

