  ; Pointer authentication, described so that a binary decodes. The
  ; authenticating branches carry a modifier register where an ordinary
  ; branch-register form has zeros, so they need a field there rather than a
  ; fixed value.
  (defformat A64_BRANCH_REG_AUTH
    (bits 32)
    (fields
      (fixed 31 10)
      (rn 9 5)
      (rm 4 0)
    )
  )

  ; Advanced SIMD modified immediate. The eight-bit immediate is `abcdefgh`,
  ; split across two fields the architecture does not put next to each other --
  ; `abc` at 18:16 and `defgh` at 9:5 -- which is what the four-number field
  ; form is for: instruction bits 18:16 carry immediate bits 7:5.
  ; The three-register-same-arrangement group. `size` selects the lane
  ; arrangement for the arithmetic, and *is part of the opcode* for the logical
  ; group -- AND, ORR, BSL and their siblings all sit at opcode 3 and are told
  ; apart by it -- so the arithmetic forms take it as an operand and the logical
  ; ones pin it.
  (defformat A64_FP_IMM
    (bits 32)
    (fields
      (fixed 31 21)
      (imm 20 13)
      (fixed12 12 10)
      (zero9 9 5)
      (rd 4 0)
    )
  )

  (defformat A64_FP_DP3
    (bits 32)
    (fields
      (fixed 31 21)
      (rm 20 16)
      (o0 15 15)
      (ra 14 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  (defformat A64_FP_CSEL
    (bits 32)
    (fields
      (fixed 31 21)
      (rm 20 16)
      (cond 15 12)
      (fixed11 11 10)
      (rn 9 5)
      (rd 4 0)
    )
  )

  ; A conditional compare writes NZCV and takes a replacement for it, so the
  ; low five bits are an operand and an opcode bit rather than a destination.
  (defformat A64_FP_CCMP
    (bits 32)
    (fields
      (fixed 31 21)
      (rm 20 16)
      (cond 15 12)
      (fixed11 11 10)
      (rn 9 5)
      (op 4 4)
      (alt 3 0)
    )
