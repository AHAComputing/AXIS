  ; ⚠️ MIN AND MAX, where the interesting part is the DECODE and not the
  ; semantics. `min`, `max`, `minu` and `maxu` have been lane-local atoms all
  ; along, so the four formals below are one line each. What these could not say
  ; before is that `size = 3` is UNALLOCATED: there is no 64-bit lanewise
  ; minimum in the base instruction set, and a decoder that answered SMAX for
  ; that bit pattern would be inventing an instruction.
  ;
  ; `requires` says it, and the generated decoders enforce it -- the C one
  ; compiles to `((insn >> 22) & 3) < 3`. The formals then have two tests and
  ; not three, and the last arm is the word case rather than a further test,
  ; because the fourth encoding does not reach here.

  (definstruction smax_v
    (mnemonic SMAX_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 12) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (< size 3))
    (asm "smax $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise signed maximum, bytes through words")
    (formal
      (select i128 (icmp_eq i2 size 0) (max v16i8 rn rm)
      (select i128 (icmp_eq i2 size 1) (max v8i16 rn rm)
        (max v4i32 rn rm))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "There is no 64-bit lanewise maximum, and the decode rule is what says so"))

