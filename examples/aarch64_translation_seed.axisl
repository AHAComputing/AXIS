    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Accelerator ordering event retaining the source DMB option"))

  (definstruction accel_dsb
    (mnemonic ACCEL_DSB) (isa accelerator_scalar64) (category custom)
