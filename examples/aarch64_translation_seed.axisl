  ; The FP16 forms take their single-precision source's declared latency --
  ; the same pipelines -- except divide and square root, which iterate over
  ; fewer bits and were measured on this host (silicon_check): 7 and 8 cycles.
  ; ⚠️ HALF PRECISION (FullFP16), derived from the single-precision forms. Each
  ; lane body is the `v4f32` arm with every width-dependent piece substituted:
  ; the lane type, the helper's width, the conversions' widths, and each bit
  ; constant through a closed table (the default NaN 0x7fc00000 is 0x7e00, the
  ; integral threshold 2^23 is 2^10...). A constant the table does not hold
  ; stops the generator rather than passing through -- which is why FRECPE and
  ; FRSQRTE, whose estimates are built from exponent arithmetic, are written
  ; out by hand. The encodings are LLVM's, sliced into the FP16 formats: those
  ; instructions live in spaces of their own, not at a different `sz`.
  (definstruction fmaxnm_8h
    (mnemonic FMAXNM_8H) (isa aarch64_base) (category float)
    (format A64_SIMD_3SAME_H)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (a 0) (fixed22 2) (fixed15 0) (opcode 0) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
    )
    (asm "fmaxnm $rd, $rn, $rm")
    (semantics "FMAXNM on half-precision lanes")
    (formal
      (vmap v8f16 ((a rn) (b rm)) (a64_fmaxnm_16 a b)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The single-precision FMAXNM_V lane body at half precision"))

