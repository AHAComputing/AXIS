(axis-module aarch64_translation_seed
  (version "0.1")
  (target translation)
  (description "AArch64 integer-register seed for semantic lifting")

  (defisa aarch64_base
    (role source)
    (base armv8-a)
    (word-bits 64)
    (registers "x[31]:i64" "sp:i64" "pc:i64" "nzcv:i4"
      "v[32]:i64"
      "fpcr:i32" "fpsr:i32" "tpidr_el0:i64" "tpidrro_el0:i64"
      "exclusive_address:i64" "exclusive_size:i8" "exclusive_valid:i1" "exclusive_value:i64")
    (features a64)
    (memory-model armv8)
    (endianness little)
  )

  (defisa accelerator_scalar64
    (role target)
    (base axis-custom64)
    (word-bits 64)
    (registers "r[32]:i64" "sp:i64" "pc:i64" "nzcv:i4"
      "v[32]:i64"
      "fpcr:i32" "fpsr:i32" "tpidr_el0:i64" "tpidrro_el0:i64"
      "exclusive_address:i64" "exclusive_size:i8" "exclusive_valid:i1" "exclusive_value:i64")
    (features scalar accelerator)
    (memory-model explicit)
    (endianness little)
  )

