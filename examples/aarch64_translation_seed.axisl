        (vmap v2i64 ((a rn) (b rm)) (a64_ushl_64 a b))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The U bit picks which right shift the negative half performs"))

  ; ⚠️ SIX CROSS-LANE PERMUTATIONS, one complete encoding group. A permutation
  ; is a function from output lane to input lane, and that function is known
  ; while the vector is expanded -- so each of these is written as the formula
  ; itself rather than as a table of moves, and it disappears at elaboration
  ; into the constant shifts every backend already understood.
  ;
  ; `lane-index` is the lane being computed. The formulas read, in order:
  ;   ZIP1  out[i] = i even ? rn[i/2]        : rm[i/2]
  ;   ZIP2  out[i] = i even ? rn[i/2 + n/2]  : rm[i/2 + n/2]
  ;   UZP1  out[i] = i < n/2 ? rn[2i]        : rm[2i mod n]
  ;   UZP2  out[i] = i < n/2 ? rn[2i + 1]    : rm[(2i + 1) mod n]
  ;   TRN1  out[i] = i even ? rn[i]          : rm[i - 1]
  ;   TRN2  out[i] = i even ? rn[i + 1]      : rm[i]
  ; and the `mod n` in UZP is not a wrap being papered over: for the lanes it
  ; applies to, 2i mod n IS 2(i - n/2), the index into the second source. An
  ; index that genuinely left the vector would be rejected rather than folded,
  ; and it caught an off-by-one in the first draft of UZP1 here.

  (definstruction uzp1_v
    (mnemonic UZP1_V) (isa aarch64_base) (category float) (format A64_SIMD_PERMUTE)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (fixed 14) (zero21 0) (zero15 0) (opcode 1) (two10 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (asm "uzp1 $rd, $rn, $rm, arrangement $size")
    (semantics "Take the even lanes of both sources in order")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((x (lane rn (% (* lane-index 2) 16)))
                             (y (lane rm (% (* lane-index 2) 16))))
          (select i8 (icmp_ult i8 lane-index 8) x y))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((x (lane rn (% (* lane-index 2) 8)))
                             (y (lane rm (% (* lane-index 2) 8))))
          (select i16 (icmp_ult i16 lane-index 4) x y))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((x (lane rn (% (* lane-index 2) 4)))
                             (y (lane rm (% (* lane-index 2) 4))))
          (select i32 (icmp_ult i32 lane-index 2) x y))
        (vmap v2i64 ((x (lane rn (% (* lane-index 2) 2)))
                             (y (lane rm (% (* lane-index 2) 2))))
          (select i64 (icmp_ult i64 lane-index 1) x y))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "De-interleaving is half of every complex-number and planar-pixel kernel"))

  (definstruction trn1_v
    (mnemonic TRN1_V) (isa aarch64_base) (category float) (format A64_SIMD_PERMUTE)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (fixed 14) (zero21 0) (zero15 0) (opcode 2) (two10 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
