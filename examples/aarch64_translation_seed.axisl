    (rationale "Rounding away from negative infinity is one added before the shift"))

  (definstruction urhadd_v
    (mnemonic URHADD_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (one21 1) (opcode 2) (one10 1))
