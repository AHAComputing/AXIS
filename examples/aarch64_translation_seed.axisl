      (rationale "AArch64 paired exclusive store with atomic two-address commit")))

  (definstruction-family accel-load-exclusive-pair
    ($name $mnemonic $sf $reg-kind $reg-type $stride $pair-size $order $load-order $asm)
    (
     (accel_ldxp32 ACCEL_LDXP32 0 a64_gpr32 i32 4 8 0 relaxed "accel.ldxp.32 $rt, $rt2, [$rn]")
     (accel_ldaxp32 ACCEL_LDAXP32 0 a64_gpr32 i32 4 8 1 acquire "accel.ldaxp.32 $rt, $rt2, [$rn]")
     (accel_ldxp64 ACCEL_LDXP64 1 a64_gpr64 i64 8 16 0 relaxed "accel.ldxp.64 $rt, $rt2, [$rn]")
     (accel_ldaxp64 ACCEL_LDAXP64 1 a64_gpr64 i64 8 16 1 acquire "accel.ldaxp.64 $rt, $rt2, [$rn]"))
    (definstruction $name
      (mnemonic $mnemonic) (isa accelerator_scalar64) (category custom)
      (format ACCEL_MEM_EXCLUSIVE_PAIR)
      (opcode 0) (func3 0) (func7 0)
      (encoding (opcode 17) (sf $sf) (load 1) (order $order) (exclusive 1)
        (fixed 0) (rs 31))
      (operands (rt $reg-kind $reg-type out) (rt2 $reg-kind $reg-type out)
        (rn a64_gpr64sp i64 in))
      (asm $asm) (semantics "Accelerator paired load-exclusive")
      (behavior
        (atomic-group 1
          (set rt (atomic_load $reg-type unsigned $load-order rn))
          (set rt2 (atomic_load $reg-type unsigned $load-order (add i64 rn $stride)))
          (setstate exclusive_address rn i64)
          (setstate exclusive_size $pair-size i8)
          (setstate exclusive_valid 1 i1)))
      (latency 3) (throughput 1.0)
      (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 2.0)
      (rationale "Accelerator paired exclusive load")))

  (definstruction-family accel-store-exclusive-pair
    ($name $mnemonic $sf $reg-kind $reg-type $stride $pair-size $order $store-order $asm)
    (
     (accel_stxp32 ACCEL_STXP32 0 a64_gpr32 i32 4 8 0 relaxed "accel.stxp.32 $rs, $rt, $rt2, [$rn]")
     (accel_stlxp32 ACCEL_STLXP32 0 a64_gpr32 i32 4 8 1 release "accel.stlxp.32 $rs, $rt, $rt2, [$rn]")
     (accel_stxp64 ACCEL_STXP64 1 a64_gpr64 i64 8 16 0 relaxed "accel.stxp.64 $rs, $rt, $rt2, [$rn]")
     (accel_stlxp64 ACCEL_STLXP64 1 a64_gpr64 i64 8 16 1 release "accel.stlxp.64 $rs, $rt, $rt2, [$rn]"))
    (definstruction $name
      (mnemonic $mnemonic) (isa accelerator_scalar64) (category custom)
      (format ACCEL_MEM_EXCLUSIVE_PAIR)
      (opcode 0) (func3 0) (func7 0)
      (encoding (opcode 17) (sf $sf) (load 0) (order $order) (exclusive 1)
        (fixed 0))
      (operands (rs a64_gpr32 i32 out) (rt $reg-kind $reg-type in)
        (rt2 $reg-kind $reg-type in) (rn a64_gpr64sp i64 in))
      (asm $asm) (semantics "Accelerator paired store-exclusive")
      (behavior
        (atomic-group 1
          (set rs (select i32
            (or i64 (xor i64 exclusive_address rn)
              (xor i64 exclusive_size $pair-size)
              (xor i64 exclusive_valid 1)) 1 0))
          (when (icmp_eq
            (or i64 (xor i64 exclusive_address rn)
              (xor i64 exclusive_size $pair-size)
              (xor i64 exclusive_valid 1)) 0)
            (atomic_store rn rt $reg-type $store-order))
          (when (icmp_eq
            (or i64 (xor i64 exclusive_address rn)
              (xor i64 exclusive_size $pair-size)
              (xor i64 exclusive_valid 1)) 0)
            (atomic_store (add i64 rn $stride) rt2 $reg-type $store-order))
          (setstate exclusive_valid 0 i1)))
      (latency 3) (throughput 1.0)
      (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 2.0)
      (rationale "Accelerator paired exclusive store")))

  (definstruction clrex
    (mnemonic CLREX) (isa aarch64_base) (category custom) (format A64_CLREX)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 872499) (fixed_lo 95))
    (operands (option imm i4 in))
    (asm "clrex #$option")
    (semantics "Clear the local exclusive monitor")
    (behavior (setstate exclusive_valid 0 i1))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "AArch64 CLREX invalidates any reservation; option is an encoded implementation hint"))

  (definstruction accel_clrex
    (mnemonic ACCEL_CLREX) (isa accelerator_scalar64) (category custom)
    (format ACCEL_STATE_IMM4)
    (opcode 0) (func3 0) (func7 0)
    (encoding (opcode 122) (fixed_hi 0) (fixed_lo 0))
    (operands (option imm i4 in))
    (asm "accel.clrex #$option")
    (semantics "Accelerator exclusive-monitor clear")
    (behavior (setstate exclusive_valid 0 i1))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Explicit accelerator reservation invalidation"))

  (definstruction dmb
    (mnemonic DMB) (isa aarch64_base) (category custom) (format A64_CLREX)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 872499) (fixed_lo 191))
    (operands (option imm i4 in))
    (asm "dmb #$option")
    (semantics "AArch64 data memory barrier")
    (behavior (barrier dmb option))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Retain the encoded DMB domain/type option as an ordering event"))

  (definstruction dsb
    (mnemonic DSB) (isa aarch64_base) (category custom) (format A64_CLREX)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 872499) (fixed_lo 159))
    (operands (option imm i4 in))
    (requires (and (!= option 0) (!= option 4)))
    (asm "dsb #$option")
    (semantics "AArch64 data synchronization barrier")
    (behavior (barrier dsb option))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Retain the encoded DSB option as a completion event"))

  (definstruction isb
    (mnemonic ISB) (isa aarch64_base) (category custom) (format A64_CLREX)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 872499) (fixed_lo 223))
    (operands (option imm i4 in))
    (asm "isb #$option")
    (semantics "AArch64 instruction synchronization barrier")
    (behavior (barrier isb option))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Retain the encoded ISB option as an instruction-stream synchronization event"))

  ; --- The W-destination signed loads, and the unsigned conversions -----------
  ; Each is a form beside one already here, differing in the field that names
  ; the destination width or the signedness of the conversion. They are what a
  ; real binary still had that this description did not.

  (definstruction ldrsb_w_unsigned
    (mnemonic LDRSB_W_UNSIGNED) (isa aarch64_base) (category custom)
    (format A64_LDST_UNSIGNED)
    (opcode 0) (func3 0) (func7 0)
    (encoding (size 0) (fixed 57) (opc 3))
    (operands
      (rt a64_gpr32 i32 out)
      (rn a64_gpr64sp i64 in)
      (imm imm i12 in)
    )
    (asm "ldrsb $rt, [$rn, $imm]")
    (semantics "wt = sign_extend(Mem8[rn|sp + imm12])")
    (behavior
      (set rt (load i8 signed (add rn imm)))
    )
    (latency 3) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The W destination of the signed byte load; `opc` 3 where the X form has 2"))

  (definstruction ldrsh_w_unsigned
    (mnemonic LDRSH_W_UNSIGNED) (isa aarch64_base) (category custom)
    (format A64_LDST_UNSIGNED)
    (opcode 0) (func3 0) (func7 0)
    (encoding (size 1) (fixed 57) (opc 3))
    (operands
      (rt a64_gpr32 i32 out)
      (rn a64_gpr64sp i64 in)
      (imm imm i12 in)
    )
    (asm "ldrsh $rt, [$rn, $imm, lsl 1]")
    (semantics "wt = sign_extend(Mem16[rn|sp + zero_extend(imm12) * 2])")
    (behavior
      (set rt (load i16 signed (add rn (shl imm 1))))
    )
    (latency 3) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The halfword's scale is two, which the address arithmetic says rather than the field"))

  (definstruction ucvtf_d_w
    (mnemonic UCVTF_D_W) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 192))
    (operands (rd a64_vreg64 i64 out) (rn a64_gpr32 i32 in))
    (asm "ucvtf $rd, $rn")
    (semantics "Convert an unsigned 32-bit integer to double")
    (behavior (set rd (fcvt_u2f f64 32 rn)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The unsigned twin of SCVTF, one `fpop` away"))

  (definstruction ucvtf_d_x
    (mnemonic UCVTF_D_X) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 1267) (fpop 192))
    (operands (rd a64_vreg64 i64 out) (rn a64_gpr64 i64 in))
    (asm "ucvtf $rd, $rn")
    (semantics "Convert an unsigned 64-bit integer to double")
    (behavior (set rd (fcvt_u2f f64 64 rn)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The 64-bit source, told apart by sf"))

  (definstruction fcvtzu_w_d
    (mnemonic FCVTZU_W_D) (isa aarch64_base) (category float) (format A64_FP_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 1600))
    (operands (rd a64_gpr32 i32 out) (rn a64_vreg64 i64 in))
    (asm "fcvtzu $rd, $rn")
    (semantics "Convert a double to an unsigned 32-bit integer, rounding toward zero")
    (behavior (set rd (fcvt_f2u i32 64 rn)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The unsigned float-to-int direction"))

  ; --- The addressing modes a compiled prologue actually uses ----------------
  ; The `d`-register pair with writeback is how a function saves and restores
  ; `d8`-`d15`; the unscaled and register-offset `q` forms are what vectorised
  ; code spills with. Each is an existing shape with one field moved.

  (definstruction ldp_d_post
    (mnemonic LDP_D_POST) (isa aarch64_base) (category float)
    (format A64_LDST_PAIR)
    (opcode 0) (func3 0) (func7 0)
    (encoding (opc 1) (fixed 5) (v 1) (mode 1) (l 1))
    (operands
      (rt a64_vreg64 i64 out)
      (rt2 a64_vreg64 i64 out)
      (rn a64_gpr64sp i64 inout)
      (imm imm i7 in)
    )
    (asm "ldp $rt, $rt2, [$rn], $imm, lsl 3")
    (semantics "dt, dt2 = Mem64[rn], Mem64[rn+8]; then rn += sign_extend(imm7) * 8")
    (behavior
      (set rt (load i64 unsigned rn))
      (set rt2 (load i64 unsigned (add rn 8)))
      (set rn (add rn (shl (sext i64 7 imm) 3)))
    )
    (latency 4) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "How a function restores the callee-saved d registers on the way out"))

  (definstruction stp_d_pre
    (mnemonic STP_D_PRE) (isa aarch64_base) (category float)
    (format A64_LDST_PAIR)
    (opcode 0) (func3 0) (func7 0)
    (encoding (opc 1) (fixed 5) (v 1) (mode 3) (l 0))
    (operands
      (rt a64_vreg64 i64 in)
      (rt2 a64_vreg64 i64 in)
      (rn a64_gpr64sp i64 inout)
      (imm imm i7 in)
    )
    (asm "stp $rt, $rt2, [$rn, $imm, lsl 3]!")
    (semantics "rn += sign_extend(imm7) * 8; then Mem64[rn], Mem64[rn+8] = dt, dt2")
    (behavior
      (set rn (add rn (shl (sext i64 7 imm) 3)))
      (store rn rt i64)
      (store (add rn 8) rt2 i64)
    )
    (latency 2) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The saving half, which pushes the pair and moves SP in one instruction"))

  (definstruction ldpsw_x_offset
    (mnemonic LDPSW_X_OFFSET) (isa aarch64_base) (category custom)
    (format A64_LDST_PAIR)
    (opcode 0) (func3 0) (func7 0)
    (encoding (opc 1) (fixed 5) (v 0) (mode 2) (l 1))
    (operands
      (rt a64_gpr64 i64 out)
      (rt2 a64_gpr64 i64 out)
      (rn a64_gpr64sp i64 in)
      (imm imm i7 in)
    )
    (asm "ldpsw $rt, $rt2, [$rn, $imm, lsl 2]")
    (semantics "xt, xt2 = sign_extend(Mem32[rn + sign_extend(imm7) * 4]), sign_extend(Mem32[.. + 4])")
    (behavior
      (set rt (load i32 signed (add rn (shl (sext i64 7 imm) 2))))
      (set rt2 (load i32 signed (add (add rn (shl (sext i64 7 imm) 2)) 4)))
    )
    (latency 4) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A pair of words widened on the way in, which the scale of four distinguishes"))

  (definstruction stur_q
    (mnemonic STUR_Q) (isa aarch64_base) (category float)
    (format A64_LDST_INDEXED)
    (opcode 0) (func3 0) (func7 0)
    (encoding (size 0) (fixed 60) (opc 2) (fixed21 0) (mode 0))
    (operands
      (rt a64_vreg128 i128 in)
      (rn a64_gpr64sp i64 in)
      (imm imm i9 in)
    )
    (asm "stur $rt, [$rn, $imm]")
    (semantics "Mem128[rn|sp + sign_extend(imm9)] = qt")
    (behavior
      (store (add rn (sext i64 9 imm)) rt i128)
    )
    (latency 3) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The unscaled signed-offset store of a whole vector register"))

  (definstruction ldur_q
    (mnemonic LDUR_Q) (isa aarch64_base) (category float)
    (format A64_LDST_INDEXED)
    (opcode 0) (func3 0) (func7 0)
    (encoding (size 0) (fixed 60) (opc 3) (fixed21 0) (mode 0))
    (operands
      (rt a64_vreg128 i128 out)
      (rn a64_gpr64sp i64 in)
      (imm imm i9 in)
    )
    (asm "ldur $rt, [$rn, $imm]")
    (semantics "qt = Mem128[rn|sp + sign_extend(imm9)]")
    (behavior
      (set rt (load i128 unsigned (add rn (sext i64 9 imm))))
    )
    (latency 4) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Its load counterpart"))

  (definstruction str_q_reg
    (mnemonic STR_Q_REG) (isa aarch64_base) (category float)
    (format A64_LDST_REGISTER)
    (opcode 0) (func3 0) (func7 0)
    (encoding (size 0) (fixed 60) (opc 2) (fixed21 1) (mode 2))
    (operands
      (rt a64_vreg128 i128 in)
      (rn a64_gpr64sp i64 in)
      (rm a64_gpr64 i64 in)
      (option imm i3 in)
      (s imm i1 in)
    )
    (asm "str $rt, [$rn, $rm, extend $option lsl $s]")
    (semantics "Mem128[rn|sp + extend(rm, option) << (s * 4)] = qt")
    (requires (or (= option 2) (= option 3) (= option 6) (= option 7)))
    (behavior
      (store (add rn (a64_extend_reg i64 rm option (mul s 4))) rt i128)
    )
    (latency 3) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A vector spill through a computed index; the shift is four because the element is sixteen bytes"))

  (definstruction ldr_q_reg
    (mnemonic LDR_Q_REG) (isa aarch64_base) (category float)
    (format A64_LDST_REGISTER)
    (opcode 0) (func3 0) (func7 0)
    (encoding (size 0) (fixed 60) (opc 3) (fixed21 1) (mode 2))
    (operands
      (rt a64_vreg128 i128 out)
      (rn a64_gpr64sp i64 in)
      (rm a64_gpr64 i64 in)
      (option imm i3 in)
      (s imm i1 in)
    )
    (asm "ldr $rt, [$rn, $rm, extend $option lsl $s]")
    (semantics "qt = Mem128[rn|sp + extend(rm, option) << (s * 4)]")
    (requires (or (= option 2) (= option 3) (= option 6) (= option 7)))
    (behavior
      (set rt (load i128 unsigned (add rn (a64_extend_reg i64 rm option (mul s 4)))))
    )
    (latency 4) (throughput 0.5)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Its load counterpart"))

  ; --- Vector arithmetic and moves: described, not implemented ---------------
  ; Each computes a 128-bit value, and every executor here computes in 64 -- the
  ; same wall `MOVI_2D` and the Q-form loads meet. So they carry prose
  ; `semantics` and no `behavior`: they decode and disassemble, and say nothing
  ; they cannot say truthfully. `size` is an operand where it names the lane
  ; arrangement and pinned where it is part of the opcode.

  (definstruction add_v
    (mnemonic ADD_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 16) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (asm "add $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise add at the arrangement `size` names")
    ; `size` is a field of the instruction word, not a property of the opcode,
    ; so the arrangement is selected rather than pinned -- one decode row, as
    ; the encoding has. Each branch names its lane type statically, which is
    ; what the lane expansion needs; the three not taken fold away in every
    ; backend that optimises and are simply unread in the ones that do not.
    (formal (select i128 (icmp_eq i2 size 0) (add v16i8 rn rm)
      (select i128 (icmp_eq i2 size 1) (add v8i16 rn rm)
        (select i128 (icmp_eq i2 size 2) (add v4i32 rn rm)
                                        (add v2i64 rn rm)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Vectorised integer addition, whichever lane width the compiler chose"))

  (definstruction sub_v
    (mnemonic SUB_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (one21 1) (opcode 16) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (asm "sub $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise subtract at the arrangement `size` names")
    ; The mirror of ADD_V: borrow is contained by the same lane masking that
    ; contains carry.
    (formal (select i128 (icmp_eq i2 size 0) (sub v16i8 rn rm)
      (select i128 (icmp_eq i2 size 1) (sub v8i16 rn rm)
        (select i128 (icmp_eq i2 size 2) (sub v4i32 rn rm)
                                        (sub v2i64 rn rm)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The U bit is the whole difference from ADD"))

  (definstruction cmhi_v
    (mnemonic CMHI_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (one21 1) (opcode 6) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (asm "cmhi $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise unsigned compare, all-ones in each lane where rn exceeds rm")
    ; Written with the operands reversed, because AXIS spells unsigned ordering
    ; `icmp_ult` and `rn > rm` is `rm < rn`. Adding a `ugt` spelling would be a
    ; second name for one comparison, which is how two vocabularies start.
    (formal (select i128 (icmp_eq i2 size 0) (icmp_ult v16i8 rm rn)
      (select i128 (icmp_eq i2 size 1) (icmp_ult v8i16 rm rn)
        (select i128 (icmp_eq i2 size 2) (icmp_ult v4i32 rm rn)
                                        (icmp_ult v2i64 rm rn)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A vector predicate, which a compiled comparison loop produces"))

  ; ⚠️ The other five vector comparisons. Three opcodes of A64_SIMD_3SAME hold
  ; two comparisons each -- `u` picks signed or unsigned for the orderings and
  ; equality-or-test for opcode 17 -- and only CMHI was described:
  ;
  ;        u=0      u=1
  ;   6    CMGT     CMHI
  ;   7    CMGE     CMHS
  ;  17    CMTST    CMEQ
  ;
  ; ⚠️ The lane vocabulary carries ONE SPELLING of each redundant pair --
  ; `eq ne ult uge slt sge` and not their mirrors -- which is the discipline
  ; CMHI's own comment describes. So `rn > rm` is written as the reversed
  ; `rm < rn`, while `rn >= rm` is written directly: the strict order has to
  ; be turned around and the non-strict one does not. Reaching for
  ; `icmp_ule` instead was refused outright, because an operator outside that
  ; set is not lane-local and a vector type has no meaning for it.
  (definstruction cmgt_v
    (mnemonic CMGT_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 6) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (asm "cmgt $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise signed compare, all-ones in each lane where rn exceeds rm")
    (formal (select i128 (icmp_eq i2 size 0) (icmp_slt v16i8 rm rn)
