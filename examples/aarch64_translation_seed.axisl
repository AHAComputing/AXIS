    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (one21 1) (opcode 8) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (asm "sshl $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise shift left by a signed amount; a negative amount shifts arithmetically right")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn) (b rm)) (a64_sshl_8 a b))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn) (b rm)) (a64_sshl_16 a b))
      (select i128 (icmp_eq i2 size 2) (vmap v4i32 ((a rn) (b rm)) (a64_sshl_32 a b))
        (vmap v2i64 ((a rn) (b rm)) (a64_sshl_64 a b))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "One instruction that is two shifts, which is why a lane operator needed a body"))

  (definstruction ushl_v
    (mnemonic USHL_V) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (one21 1) (opcode 8) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (asm "ushl $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise shift left by a signed amount; a negative amount shifts logically right")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((a rn) (b rm)) (a64_ushl_8 a b))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((a rn) (b rm)) (a64_ushl_16 a b))
