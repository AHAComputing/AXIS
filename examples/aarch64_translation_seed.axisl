    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
    )
    (asm "bic $rd, $rn, $rm")
    (semantics "Bitwise AND of rn with the complement of rm")
    (formal (and i128 rn (not i128 rm)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Clearing a mask, which is how a vectorised `andn` is spelled here"))

