  ; ⚠️ ROUNDING A FLOAT TO AN INTEGRAL FLOAT, in the four modes that do not
  ; depend on FPCR. All four are built on one observation: `fcvt` to an integer
  ; and back TRUNCATES toward zero, so the truncation is free and each mode is
  ; a correction to it.
  ;
  ; Two guards do the real work. A lane whose magnitude is at least 2^23 (or
  ; 2^52) is ALREADY INTEGRAL and is returned untouched -- which also catches
  ; every infinity and NaN, because the bit patterns of positive floats order
  ; the same way their values do, so one unsigned compare against the pattern
  ; of 2^23 finds all three at once. An infinity passes through; a NaN answers
  ; the DEFAULT NaN, because this corpus is FPCR.DN=1 (see the note on the
  ; floating-point half of 3SAME) -- passing the operand's NaN through was the
  ; one thing here the ASL model disagreed with. And the sign of zero
  ; has to be put back by hand: truncating -0.5 gives +0, where the
  ; architecture says -0, so the sign bit is or-ed back in.
  ;
  ; FRINTX and FRINTI are the same operation under the DYNAMIC rounding mode.
  ; They are not described here because this corpus does not carry FPCR --
  ; `aarch64_fp_env` is where that lives -- and an instruction whose answer
  ; depends on state the description cannot read would be a guess.
  (defsem a64_frintz_16 ((a i16)) i16
    (let ((mag (and i16 a 0x7fff)) (big (icmp_uge i16 mag 0x6400)) (t (or i16 (and i16 a 0x8000) (fcvt_s2f f16 16 (fcvt_f2s i16 16 a))))) (select i16 big (select i16 (icmp_ult i16 0x7c00 mag) 0x7e00 a) t)))
  (defsem a64_frintm_16 ((a i16)) i16
    (let ((mag (and i16 a 0x7fff)) (big (icmp_uge i16 mag 0x6400)) (t (or i16 (and i16 a 0x8000) (fcvt_s2f f16 16 (fcvt_f2s i16 16 a)))) (down (select i16 (fcmp_olt f16 a t) (fsub f16 t 0x3c00) t))) (select i16 big (select i16 (icmp_ult i16 0x7c00 mag) 0x7e00 a) down)))
  (defsem a64_frintp_16 ((a i16)) i16
    (let ((mag (and i16 a 0x7fff)) (big (icmp_uge i16 mag 0x6400)) (t (or i16 (and i16 a 0x8000) (fcvt_s2f f16 16 (fcvt_f2s i16 16 a)))) (up (select i16 (fcmp_olt f16 t a) (fadd f16 t 0x3c00) t))) (select i16 big (select i16 (icmp_ult i16 0x7c00 mag) 0x7e00 a) up)))
  (defsem a64_frinta_16 ((a i16)) i16
    (let ((mag (and i16 a 0x7fff)) (big (icmp_uge i16 mag 0x6400)) (t (or i16 (and i16 a 0x8000) (fcvt_s2f f16 16 (fcvt_f2s i16 16 a)))) (frac (and i16 (fsub f16 a t) 0x7fff)) (away (or i16 (and i16 a 0x8000) 0x3c00)) (rounded (select i16 (fcmp_ole f16 0x3800 frac) (fadd f16 t away) t))) (select i16 big (select i16 (icmp_ult i16 0x7c00 mag) 0x7e00 a) rounded)))
  (defsem a64_frintn_16 ((a i16)) i16
    (let ((mag (and i16 a 0x7fff)) (big (icmp_uge i16 mag 0x6400)) (t (or i16 (and i16 a 0x8000) (fcvt_s2f f16 16 (fcvt_f2s i16 16 a)))) (frac (and i16 (fsub f16 a t) 0x7fff)) (away (or i16 (and i16 a 0x8000) 0x3c00)) (over-half (fcmp_olt f16 0x3800 frac)) (at-half (fcmp_oeq f16 0x3800 frac)) (odd (icmp_ne i16 (and i16 (fcvt_f2s i16 16 t) 1) 0)) (rounded (select i16 (or i16 over-half (and i16 at-half odd)) (fadd f16 t away) t))) (select i16 big (select i16 (icmp_ult i16 0x7c00 mag) 0x7e00 a) rounded)))
  (defsem a64_fmax_16 ((a i16) (b i16)) i16
    (let ((unordered (or i16 (fcmp_uno f16 a a) (fcmp_uno f16 b b))) (both-zero (and i16 (icmp_eq i16 (and i16 a 0x7fff) 0) (icmp_eq i16 (and i16 b 0x7fff) 0)))) (select i16 both-zero (and i16 a b) (select i16 unordered 0x7e00 (select i16 (fcmp_olt f16 b a) a b)))))
  (defsem a64_fmin_16 ((a i16) (b i16)) i16
    (let ((unordered (or i16 (fcmp_uno f16 a a) (fcmp_uno f16 b b))) (both-zero (and i16 (icmp_eq i16 (and i16 a 0x7fff) 0) (icmp_eq i16 (and i16 b 0x7fff) 0)))) (select i16 both-zero (or i16 a b) (select i16 unordered 0x7e00 (select i16 (fcmp_olt f16 a b) a b)))))
  (defsem a64_fmaxnm_16 ((a i16) (b i16)) i16
    (let ((anan (fcmp_uno f16 a a)) (bnan (fcmp_uno f16 b b)) (signalling (or i16 (and i16 anan (icmp_eq i16 (and i16 a 0x200) 0)) (and i16 bnan (icmp_eq i16 (and i16 b 0x200) 0)))) (both-zero (and i16 (icmp_eq i16 (and i16 a 0x7fff) 0) (icmp_eq i16 (and i16 b 0x7fff) 0)))) (select i16 both-zero (and i16 a b) (select i16 (or i16 signalling (and i16 anan bnan)) 0x7e00 (select i16 anan b (select i16 bnan a (select i16 (fcmp_olt f16 b a) a b)))))))
  (defsem a64_fminnm_16 ((a i16) (b i16)) i16
    (let ((anan (fcmp_uno f16 a a)) (bnan (fcmp_uno f16 b b)) (signalling (or i16 (and i16 anan (icmp_eq i16 (and i16 a 0x200) 0)) (and i16 bnan (icmp_eq i16 (and i16 b 0x200) 0)))) (both-zero (and i16 (icmp_eq i16 (and i16 a 0x7fff) 0) (icmp_eq i16 (and i16 b 0x7fff) 0)))) (select i16 both-zero (or i16 a b) (select i16 (or i16 signalling (and i16 anan bnan)) 0x7e00 (select i16 anan b (select i16 bnan a (select i16 (fcmp_olt f16 a b) a b)))))))

  (defsem a64_frintz_32 ((a i32)) i32
    (let ((mag (and i32 a 0x7fffffff))
          (big (icmp_uge i32 mag 0x4b000000))
          (t (or i32 (and i32 a 0x80000000)
                      (fcvt_s2f f32 32 (fcvt_f2s i32 32 a)))))
      (select i32 big (select i32 (icmp_ult i32 0x7f800000 mag) 0x7fc00000 a) t)))
  (defsem a64_frintm_32 ((a i32)) i32
    (let ((mag (and i32 a 0x7fffffff))
          (big (icmp_uge i32 mag 0x4b000000))
          (t (or i32 (and i32 a 0x80000000)
                      (fcvt_s2f f32 32 (fcvt_f2s i32 32 a))))
          (down (select i32 (fcmp_olt f32 a t) (fsub f32 t 0x3f800000) t)))
      (select i32 big (select i32 (icmp_ult i32 0x7f800000 mag) 0x7fc00000 a) down)))
  (defsem a64_frintp_32 ((a i32)) i32
    (let ((mag (and i32 a 0x7fffffff))
          (big (icmp_uge i32 mag 0x4b000000))
          (t (or i32 (and i32 a 0x80000000)
                      (fcvt_s2f f32 32 (fcvt_f2s i32 32 a))))
          (up (select i32 (fcmp_olt f32 t a) (fadd f32 t 0x3f800000) t)))
      (select i32 big (select i32 (icmp_ult i32 0x7f800000 mag) 0x7fc00000 a) up)))
  (defsem a64_frinta_32 ((a i32)) i32
    (let ((mag (and i32 a 0x7fffffff))
          (big (icmp_uge i32 mag 0x4b000000))
          (t (or i32 (and i32 a 0x80000000)
                      (fcvt_s2f f32 32 (fcvt_f2s i32 32 a))))
          (frac (and i32 (fsub f32 a t) 0x7fffffff))
          (away (or i32 (and i32 a 0x80000000) 0x3f800000))
          (rounded (select i32 (fcmp_ole f32 0x3f000000 frac) (fadd f32 t away) t)))
      (select i32 big (select i32 (icmp_ult i32 0x7f800000 mag) 0x7fc00000 a) rounded)))
  (defsem a64_frintn_32 ((a i32)) i32
    (let ((mag (and i32 a 0x7fffffff))
          (big (icmp_uge i32 mag 0x4b000000))
          (t (or i32 (and i32 a 0x80000000)
                      (fcvt_s2f f32 32 (fcvt_f2s i32 32 a))))
          (frac (and i32 (fsub f32 a t) 0x7fffffff))
          (away (or i32 (and i32 a 0x80000000) 0x3f800000))
          (over-half (fcmp_olt f32 0x3f000000 frac))
          (at-half (fcmp_oeq f32 0x3f000000 frac))
          (odd (icmp_ne i32 (and i32 (fcvt_f2s i32 32 t) 1) 0))
          (rounded (select i32 (or i32 over-half (and i32 at-half odd))
                                (fadd f32 t away) t)))
      (select i32 big (select i32 (icmp_ult i32 0x7f800000 mag) 0x7fc00000 a) rounded)))
  (defsem a64_frintz_64 ((a i64)) i64
    (let ((mag (and i64 a 0x7fffffffffffffff))
          (big (icmp_uge i64 mag 0x4330000000000000))
          (t (or i64 (and i64 a 0x8000000000000000)
                      (fcvt_s2f f64 64 (fcvt_f2s i64 64 a)))))
      (select i64 big (select i64 (icmp_ult i64 0x7ff0000000000000 mag) 0x7ff8000000000000 a) t)))
  (defsem a64_frintm_64 ((a i64)) i64
    (let ((mag (and i64 a 0x7fffffffffffffff))
          (big (icmp_uge i64 mag 0x4330000000000000))
          (t (or i64 (and i64 a 0x8000000000000000)
                      (fcvt_s2f f64 64 (fcvt_f2s i64 64 a))))
          (down (select i64 (fcmp_olt f64 a t) (fsub f64 t 0x3ff0000000000000) t)))
      (select i64 big (select i64 (icmp_ult i64 0x7ff0000000000000 mag) 0x7ff8000000000000 a) down)))
  (defsem a64_frintp_64 ((a i64)) i64
    (let ((mag (and i64 a 0x7fffffffffffffff))
          (big (icmp_uge i64 mag 0x4330000000000000))
          (t (or i64 (and i64 a 0x8000000000000000)
                      (fcvt_s2f f64 64 (fcvt_f2s i64 64 a))))
          (up (select i64 (fcmp_olt f64 t a) (fadd f64 t 0x3ff0000000000000) t)))
      (select i64 big (select i64 (icmp_ult i64 0x7ff0000000000000 mag) 0x7ff8000000000000 a) up)))
  (defsem a64_frinta_64 ((a i64)) i64
    (let ((mag (and i64 a 0x7fffffffffffffff))
          (big (icmp_uge i64 mag 0x4330000000000000))
          (t (or i64 (and i64 a 0x8000000000000000)
                      (fcvt_s2f f64 64 (fcvt_f2s i64 64 a))))
          (frac (and i64 (fsub f64 a t) 0x7fffffffffffffff))
          (away (or i64 (and i64 a 0x8000000000000000) 0x3ff0000000000000))
          (rounded (select i64 (fcmp_ole f64 0x3fe0000000000000 frac) (fadd f64 t away) t)))
      (select i64 big (select i64 (icmp_ult i64 0x7ff0000000000000 mag) 0x7ff8000000000000 a) rounded)))
  (defsem a64_frintn_64 ((a i64)) i64
    (let ((mag (and i64 a 0x7fffffffffffffff))
          (big (icmp_uge i64 mag 0x4330000000000000))
          (t (or i64 (and i64 a 0x8000000000000000)
                      (fcvt_s2f f64 64 (fcvt_f2s i64 64 a))))
          (frac (and i64 (fsub f64 a t) 0x7fffffffffffffff))
          (away (or i64 (and i64 a 0x8000000000000000) 0x3ff0000000000000))
          (over-half (fcmp_olt f64 0x3fe0000000000000 frac))
          (at-half (fcmp_oeq f64 0x3fe0000000000000 frac))
          (odd (icmp_ne i64 (and i64 (fcvt_f2s i64 64 t) 1) 0))
          (rounded (select i64 (or i64 over-half (and i64 at-half odd))
                                (fadd f64 t away) t)))
      (select i64 big (select i64 (icmp_ult i64 0x7ff0000000000000 mag) 0x7ff8000000000000 a) rounded)))


  ; ⚠️ THE FOUR MINIMA AND MAXIMA, which differ only in what a NaN means. FMAX
  ; and FMIN propagate one: if either operand is unordered with itself the
  ; answer is the default NaN. FMAXNM and FMINNM do the opposite and return
  ; the NUMBER, which is what a reduction over a vector containing a NaN
  ; wants, and only when BOTH are NaN is the answer a NaN.
  ;
  ; ⚠️ ZEROS TIE BY SIGN, not by value, and this is where a plausible
  ; description is wrong. `+0 < -0` is false and so is `-0 < +0`, so a
  ; comparison alone always yields the second operand and FMAX(+0, -0) comes
  ; back negative. The silicon on this machine says otherwise: the maximum of
  ; two zeros is positive unless BOTH are negative -- which is `and` on the
  ; sign bits -- and the minimum is negative unless both are positive, which
  ; is `or`. The value bits are zero either way, so the entire rule is one
  ; bitwise operation on the operands themselves.
  ;
  ; Written once as `defsem` at each precision, because the pairwise forms
  ; compute the same function over a different pair of lanes, and eight
  ; spelled-out copies of a NaN rule is eight chances to get one subtly wrong.

  (defsem a64_fmax_32 ((a i32) (b i32)) i32
    (let ((unordered (or i32 (fcmp_uno f32 a a) (fcmp_uno f32 b b)))
          (both-zero (and i32 (icmp_eq i32 (and i32 a 0x7fffffff) 0)
                               (icmp_eq i32 (and i32 b 0x7fffffff) 0))))
      (select i32 both-zero (and i32 a b)
        (select i32 unordered 0x7fc00000
          (select i32 (fcmp_olt f32 b a) a b)))))
  (defsem a64_fmin_32 ((a i32) (b i32)) i32
    (let ((unordered (or i32 (fcmp_uno f32 a a) (fcmp_uno f32 b b)))
          (both-zero (and i32 (icmp_eq i32 (and i32 a 0x7fffffff) 0)
                               (icmp_eq i32 (and i32 b 0x7fffffff) 0))))
      (select i32 both-zero (or i32 a b)
        (select i32 unordered 0x7fc00000
          (select i32 (fcmp_olt f32 a b) a b)))))
  (defsem a64_fmaxnm_32 ((a i32) (b i32)) i32
    (let ((anan (fcmp_uno f32 a a))
          (bnan (fcmp_uno f32 b b))
          ; ⚠️ Only a QUIET NaN is "missing". A signalling NaN in either
          ; operand makes the answer a NaN whatever the other one holds.
          (signalling (or i32 (and i32 anan (icmp_eq i32 (and i32 a 0x400000) 0))
                                (and i32 bnan (icmp_eq i32 (and i32 b 0x400000) 0))))
          (both-zero (and i32 (icmp_eq i32 (and i32 a 0x7fffffff) 0)
                               (icmp_eq i32 (and i32 b 0x7fffffff) 0))))
      (select i32 both-zero (and i32 a b)
        (select i32 (or i32 signalling (and i32 anan bnan)) 0x7fc00000
          (select i32 anan b
            (select i32 bnan a
              (select i32 (fcmp_olt f32 b a) a b)))))))
  (defsem a64_fminnm_32 ((a i32) (b i32)) i32
    (let ((anan (fcmp_uno f32 a a))
          (bnan (fcmp_uno f32 b b))
          ; ⚠️ Only a QUIET NaN is "missing". A signalling NaN in either
          ; operand makes the answer a NaN whatever the other one holds.
          (signalling (or i32 (and i32 anan (icmp_eq i32 (and i32 a 0x400000) 0))
                                (and i32 bnan (icmp_eq i32 (and i32 b 0x400000) 0))))
          (both-zero (and i32 (icmp_eq i32 (and i32 a 0x7fffffff) 0)
                               (icmp_eq i32 (and i32 b 0x7fffffff) 0))))
      (select i32 both-zero (or i32 a b)
        (select i32 (or i32 signalling (and i32 anan bnan)) 0x7fc00000
          (select i32 anan b
            (select i32 bnan a
              (select i32 (fcmp_olt f32 a b) a b)))))))
  (defsem a64_fmax_64 ((a i64) (b i64)) i64
    (let ((unordered (or i64 (fcmp_uno f64 a a) (fcmp_uno f64 b b)))
          (both-zero (and i64 (icmp_eq i64 (and i64 a 0x7fffffffffffffff) 0)
                               (icmp_eq i64 (and i64 b 0x7fffffffffffffff) 0))))
      (select i64 both-zero (and i64 a b)
        (select i64 unordered 0x7ff8000000000000
          (select i64 (fcmp_olt f64 b a) a b)))))
  (defsem a64_fmin_64 ((a i64) (b i64)) i64
    (let ((unordered (or i64 (fcmp_uno f64 a a) (fcmp_uno f64 b b)))
          (both-zero (and i64 (icmp_eq i64 (and i64 a 0x7fffffffffffffff) 0)
                               (icmp_eq i64 (and i64 b 0x7fffffffffffffff) 0))))
      (select i64 both-zero (or i64 a b)
        (select i64 unordered 0x7ff8000000000000
          (select i64 (fcmp_olt f64 a b) a b)))))
  (defsem a64_fmaxnm_64 ((a i64) (b i64)) i64
    (let ((anan (fcmp_uno f64 a a))
          (bnan (fcmp_uno f64 b b))
          ; ⚠️ Only a QUIET NaN is "missing". A signalling NaN in either
          ; operand makes the answer a NaN whatever the other one holds.
          (signalling (or i64 (and i64 anan (icmp_eq i64 (and i64 a 0x8000000000000) 0))
                                (and i64 bnan (icmp_eq i64 (and i64 b 0x8000000000000) 0))))
          (both-zero (and i64 (icmp_eq i64 (and i64 a 0x7fffffffffffffff) 0)
                               (icmp_eq i64 (and i64 b 0x7fffffffffffffff) 0))))
      (select i64 both-zero (and i64 a b)
        (select i64 (or i64 signalling (and i64 anan bnan)) 0x7ff8000000000000
          (select i64 anan b
            (select i64 bnan a
              (select i64 (fcmp_olt f64 b a) a b)))))))
  (defsem a64_fminnm_64 ((a i64) (b i64)) i64
    (let ((anan (fcmp_uno f64 a a))
          (bnan (fcmp_uno f64 b b))
          ; ⚠️ Only a QUIET NaN is "missing". A signalling NaN in either
          ; operand makes the answer a NaN whatever the other one holds.
          (signalling (or i64 (and i64 anan (icmp_eq i64 (and i64 a 0x8000000000000) 0))
                                (and i64 bnan (icmp_eq i64 (and i64 b 0x8000000000000) 0))))
          (both-zero (and i64 (icmp_eq i64 (and i64 a 0x7fffffffffffffff) 0)
                               (icmp_eq i64 (and i64 b 0x7fffffffffffffff) 0))))
      (select i64 both-zero (or i64 a b)
        (select i64 (or i64 signalling (and i64 anan bnan)) 0x7ff8000000000000
          (select i64 anan b
            (select i64 bnan a
              (select i64 (fcmp_olt f64 a b) a b)))))))


  ; ⚠️ SHIFT BY A SIGNED AMOUNT, the other thing a closed list of lane
  ; operators could not express. `shl` and `lshr` are both lane-local and both
  ; already atoms, but SSHL picks BETWEEN them per lane, on the sign of the
  ; low byte of the second operand -- and choosing is not an operator, it is a
  ; body.
  ;
  ; Two details the ARM definition insists on and a naive `(shl a b)` gets
  ; wrong. The amount is the low EIGHT bits read as signed, not the whole lane,
  ; so a 16-bit lane shifted by 0x0104 shifts by 4 and not by 260. And an
  ; amount at or past the lane width does not wrap: a left shift empties the
  ; lane, an unsigned right shift empties it, and a signed right shift fills it
  ; with the sign -- which is why the arithmetic case shifts by width-1 rather
  ; than answering zero.
  (defsem a64_sshl_8 ((a i8) (b i8)) i8
    (let ((amount (and i8 b 0xff))
          (negative (icmp_ne i8 (and i8 b 0x80) 0))
          (back (and i8 (sub i8 0 amount) 0xff))
          (saturated (select i8 (icmp_ult i8 amount 8) (shl i8 a amount) 0))
          (drained (select i8 (icmp_ult i8 back 8) (sra i8 a back)
                                (sra i8 a 7))))
      (select i8 negative drained saturated)))
  (defsem a64_sshl_16 ((a i16) (b i16)) i16
    (let ((amount (and i16 b 0xff))
          (negative (icmp_ne i16 (and i16 b 0x80) 0))
          (back (and i16 (sub i16 0 amount) 0xff))
          (saturated (select i16 (icmp_ult i16 amount 16) (shl i16 a amount) 0))
          (drained (select i16 (icmp_ult i16 back 16) (sra i16 a back)
                                (sra i16 a 15))))
      (select i16 negative drained saturated)))
  (defsem a64_sshl_32 ((a i32) (b i32)) i32
    (let ((amount (and i32 b 0xff))
          (negative (icmp_ne i32 (and i32 b 0x80) 0))
          (back (and i32 (sub i32 0 amount) 0xff))
          (saturated (select i32 (icmp_ult i32 amount 32) (shl i32 a amount) 0))
          (drained (select i32 (icmp_ult i32 back 32) (sra i32 a back)
                                (sra i32 a 31))))
      (select i32 negative drained saturated)))
  (defsem a64_sshl_64 ((a i64) (b i64)) i64
    (let ((amount (and i64 b 0xff))
          (negative (icmp_ne i64 (and i64 b 0x80) 0))
          (back (and i64 (sub i64 0 amount) 0xff))
          (saturated (select i64 (icmp_ult i64 amount 64) (shl i64 a amount) 0))
          (drained (select i64 (icmp_ult i64 back 64) (sra i64 a back)
                                (sra i64 a 63))))
      (select i64 negative drained saturated)))
  (defsem a64_ushl_8 ((a i8) (b i8)) i8
    (let ((amount (and i8 b 0xff))
          (negative (icmp_ne i8 (and i8 b 0x80) 0))
          (back (and i8 (sub i8 0 amount) 0xff))
          (saturated (select i8 (icmp_ult i8 amount 8) (shl i8 a amount) 0))
          ; ⚠️ Zero, not a sign fill. An arithmetic right shift past the
          ; lane keeps the sign, which is why SSHL shifts by 7 there;
          ; a logical one empties the lane, and copying the signed arm
          ; here left the top bits standing.
          (drained (select i8 (icmp_ult i8 back 8) (lshr i8 a back) 0)))
      (select i8 negative drained saturated)))
  (defsem a64_ushl_16 ((a i16) (b i16)) i16
    (let ((amount (and i16 b 0xff))
          (negative (icmp_ne i16 (and i16 b 0x80) 0))
          (back (and i16 (sub i16 0 amount) 0xff))
          (saturated (select i16 (icmp_ult i16 amount 16) (shl i16 a amount) 0))
          ; ⚠️ Zero, not a sign fill. An arithmetic right shift past the
          ; lane keeps the sign, which is why SSHL shifts by 15 there;
          ; a logical one empties the lane, and copying the signed arm
          ; here left the top bits standing.
          (drained (select i16 (icmp_ult i16 back 16) (lshr i16 a back) 0)))
      (select i16 negative drained saturated)))
  (defsem a64_ushl_32 ((a i32) (b i32)) i32
    (let ((amount (and i32 b 0xff))
          (negative (icmp_ne i32 (and i32 b 0x80) 0))
          (back (and i32 (sub i32 0 amount) 0xff))
          (saturated (select i32 (icmp_ult i32 amount 32) (shl i32 a amount) 0))
          ; ⚠️ Zero, not a sign fill. An arithmetic right shift past the
          ; lane keeps the sign, which is why SSHL shifts by 31 there;
          ; a logical one empties the lane, and copying the signed arm
          ; here left the top bits standing.
          (drained (select i32 (icmp_ult i32 back 32) (lshr i32 a back) 0)))
      (select i32 negative drained saturated)))
  (defsem a64_ushl_64 ((a i64) (b i64)) i64
    (let ((amount (and i64 b 0xff))
          (negative (icmp_ne i64 (and i64 b 0x80) 0))
          (back (and i64 (sub i64 0 amount) 0xff))
          (saturated (select i64 (icmp_ult i64 amount 64) (shl i64 a amount) 0))
          ; ⚠️ Zero, not a sign fill. An arithmetic right shift past the
          ; lane keeps the sign, which is why SSHL shifts by 63 there;
          ; a logical one empties the lane, and copying the signed arm
          ; here left the top bits standing.
          (drained (select i64 (icmp_ult i64 back 64) (lshr i64 a back) 0)))
      (select i64 negative drained saturated)))


  ; ⚠️ SATURATING LANE ARITHMETIC, which needed a lane operator to have a body.
  ; A lane operation used to be one atom from a closed list, so a result that
  ; clamps instead of wrapping -- five steps, not one -- had nowhere to be
  ; written. `vmap` names the lane values and takes an expression over them.
  ;
  ; The bodies are `defsem` rather than repeated inline, because each of the
  ; four instructions below says the same thing at four lane widths and the
  ; difference between a signed saturating add and a signed saturating subtract
  ; is one operator and one sign test. Sixteen copies of that spelled out is
  ; sixteen chances to get one of them wrong in a way no reader would see.
  ;
  ; Signed overflow is detected by SIGN, not by a carry out: an add overflows
  ; exactly when the operands agree in sign and the result does not, and a
  ; subtract when they DISAGREE and the result differs from the first. The
  ; clamp is then decided by the sign of `a`, which is the sign the true result
  ; would have had. Unsigned is simpler and needs no sign at all -- an add
  ; overflowed if the sum came out below either operand, and a subtract if the
  ; second operand was the larger.

  (defsem a64_sqadd_8 ((a i8) (b i8)) i8
    (let ((sum (add i8 a b))
          (same-sign (icmp_eq i8 (and i8 (xor i8 a b) 0x80) 0))
          (flipped (icmp_ne i8 (and i8 (xor i8 a sum) 0x80) 0))
          (overflowed (and i8 same-sign flipped))
          (limit (select i8 (icmp_eq i8 (and i8 (lshr i8 a 7) 1) 1)
                              0x80 0x7f)))
      (select i8 overflowed limit sum)))
  (defsem a64_sqadd_16 ((a i16) (b i16)) i16
    (let ((sum (add i16 a b))
          (same-sign (icmp_eq i16 (and i16 (xor i16 a b) 0x8000) 0))
          (flipped (icmp_ne i16 (and i16 (xor i16 a sum) 0x8000) 0))
          (overflowed (and i16 same-sign flipped))
          (limit (select i16 (icmp_eq i16 (and i16 (lshr i16 a 15) 1) 1)
                              0x8000 0x7fff)))
      (select i16 overflowed limit sum)))
  (defsem a64_sqadd_32 ((a i32) (b i32)) i32
    (let ((sum (add i32 a b))
          (same-sign (icmp_eq i32 (and i32 (xor i32 a b) 0x80000000) 0))
          (flipped (icmp_ne i32 (and i32 (xor i32 a sum) 0x80000000) 0))
          (overflowed (and i32 same-sign flipped))
          (limit (select i32 (icmp_eq i32 (and i32 (lshr i32 a 31) 1) 1)
                              0x80000000 0x7fffffff)))
      (select i32 overflowed limit sum)))
  (defsem a64_sqadd_64 ((a i64) (b i64)) i64
    (let ((sum (add i64 a b))
          (same-sign (icmp_eq i64 (and i64 (xor i64 a b) 0x8000000000000000) 0))
          (flipped (icmp_ne i64 (and i64 (xor i64 a sum) 0x8000000000000000) 0))
          (overflowed (and i64 same-sign flipped))
          (limit (select i64 (icmp_eq i64 (and i64 (lshr i64 a 63) 1) 1)
                              0x8000000000000000 0x7fffffffffffffff)))
      (select i64 overflowed limit sum)))

  (defsem a64_sqsub_8 ((a i8) (b i8)) i8
    (let ((diff (sub i8 a b))
          (opposite (icmp_ne i8 (and i8 (xor i8 a b) 0x80) 0))
          (flipped (icmp_ne i8 (and i8 (xor i8 a diff) 0x80) 0))
          (overflowed (and i8 opposite flipped))
          (limit (select i8 (icmp_eq i8 (and i8 (lshr i8 a 7) 1) 1)
                              0x80 0x7f)))
      (select i8 overflowed limit diff)))
  (defsem a64_sqsub_16 ((a i16) (b i16)) i16
    (let ((diff (sub i16 a b))
          (opposite (icmp_ne i16 (and i16 (xor i16 a b) 0x8000) 0))
          (flipped (icmp_ne i16 (and i16 (xor i16 a diff) 0x8000) 0))
          (overflowed (and i16 opposite flipped))
          (limit (select i16 (icmp_eq i16 (and i16 (lshr i16 a 15) 1) 1)
                              0x8000 0x7fff)))
      (select i16 overflowed limit diff)))
  (defsem a64_sqsub_32 ((a i32) (b i32)) i32
    (let ((diff (sub i32 a b))
          (opposite (icmp_ne i32 (and i32 (xor i32 a b) 0x80000000) 0))
          (flipped (icmp_ne i32 (and i32 (xor i32 a diff) 0x80000000) 0))
          (overflowed (and i32 opposite flipped))
          (limit (select i32 (icmp_eq i32 (and i32 (lshr i32 a 31) 1) 1)
                              0x80000000 0x7fffffff)))
      (select i32 overflowed limit diff)))
  (defsem a64_sqsub_64 ((a i64) (b i64)) i64
    (let ((diff (sub i64 a b))
          (opposite (icmp_ne i64 (and i64 (xor i64 a b) 0x8000000000000000) 0))
          (flipped (icmp_ne i64 (and i64 (xor i64 a diff) 0x8000000000000000) 0))
          (overflowed (and i64 opposite flipped))
          (limit (select i64 (icmp_eq i64 (and i64 (lshr i64 a 63) 1) 1)
                              0x8000000000000000 0x7fffffffffffffff)))
      (select i64 overflowed limit diff)))

  (defsem a64_uqadd_8 ((a i8) (b i8)) i8
    (let ((sum (add i8 a b)))
      (select i8 (icmp_ult i8 sum a) 0xff sum)))
  (defsem a64_uqadd_16 ((a i16) (b i16)) i16
    (let ((sum (add i16 a b)))
      (select i16 (icmp_ult i16 sum a) 0xffff sum)))
  (defsem a64_uqadd_32 ((a i32) (b i32)) i32
    (let ((sum (add i32 a b)))
      (select i32 (icmp_ult i32 sum a) 0xffffffff sum)))
  (defsem a64_uqadd_64 ((a i64) (b i64)) i64
    (let ((sum (add i64 a b)))
      (select i64 (icmp_ult i64 sum a) 0xffffffffffffffff sum)))

  (defsem a64_uqsub_8 ((a i8) (b i8)) i8
    (select i8 (icmp_ult i8 a b) 0 (sub i8 a b)))
  (defsem a64_uqsub_16 ((a i16) (b i16)) i16
    (select i16 (icmp_ult i16 a b) 0 (sub i16 a b)))
  (defsem a64_uqsub_32 ((a i32) (b i32)) i32
    (select i32 (icmp_ult i32 a b) 0 (sub i32 a b)))
  (defsem a64_uqsub_64 ((a i64) (b i64)) i64
    (select i64 (icmp_ult i64 a b) 0 (sub i64 a b)))


  (defsem a64_rev64 ((x i64)) i64
    (let ((a (or i64
               (shl (and x 0x00ff00ff00ff00ff) 8)
               (and (lshr x 8) 0x00ff00ff00ff00ff))))
      (let ((b (or i64
                 (shl (and a 0x0000ffff0000ffff) 16)
                 (and (lshr a 16) 0x0000ffff0000ffff))))
        (or i64 (shl b 32) (lshr b 32)))))

  (defsem a64_rbit64 ((x i64)) i64
    (let ((a (or i64
               (shl (and x 0x5555555555555555) 1)
               (and (lshr x 1) 0x5555555555555555))))
      (let ((b (or i64
                 (shl (and a 0x3333333333333333) 2)
                 (and (lshr a 2) 0x3333333333333333))))
        (let ((c (or i64
                   (shl (and b 0x0f0f0f0f0f0f0f0f) 4)
                   (and (lshr b 4) 0x0f0f0f0f0f0f0f0f))))
          (let ((d (or i64
                     (shl (and c 0x00ff00ff00ff00ff) 8)
                     (and (lshr c 8) 0x00ff00ff00ff00ff))))
            (let ((e (or i64
                       (shl (and d 0x0000ffff0000ffff) 16)
                       (and (lshr d 16) 0x0000ffff0000ffff))))
              (or i64 (shl e 32) (lshr e 32))))))))

  (defsem a64_rbit32 ((x i32)) i32
    (let ((a (or i32
               (shl (and x 0x55555555) 1)
               (and (lshr x 1) 0x55555555))))
      (let ((b (or i32
                 (shl (and a 0x33333333) 2)
                 (and (lshr a 2) 0x33333333))))
        (let ((c (or i32
                   (shl (and b 0x0f0f0f0f) 4)
                   (and (lshr b 4) 0x0f0f0f0f))))
          (let ((d (or i32
                     (shl (and c 0x00ff00ff) 8)
                     (and (lshr c 8) 0x00ff00ff))))
            (or i32 (shl d 16) (lshr d 16)))))))

  (defsem a64_cls64 ((x i64)) i64
    (sub i64 (clz (xor x (ashr x 63))) 1))

  (defsem a64_cls32 ((x i32)) i32
    (sub i32 (clz (xor x (ashr x 31))) 1))

  ; FPCR.RMode, bits 23:22, in the encoding the `_rm` operators already take:
  ; 00 nearest, 01 toward +infinity, 10 toward -infinity, 11 toward zero. The
  ; field reaches the operator through an extraction and nothing else, which is
  ; the claim docs/simd_fp_design.md section 8.2 made and this is where the
  ; 544-instruction corpus makes it too.
  (defsem a64_rmode ((fpcr i32)) i32
    (and i32 (lshr i32 fpcr 22) 3))

  ; The exception word, from the `fflags` order `_fx` returns into FPSR's. The
  ; two are five-bit reversals of each other -- invalid is the top bit of one
  ; and the bottom bit of the other -- and overflow, in the middle, is the only
  ; bit that does not move.
  (defsem a64_fpsr_bits ((flags i32)) i32
    (or i32
      (and i32 (lshr i32 flags 4) 1)
      (or i32
        (shl i32 (and i32 (lshr i32 flags 3) 1) 1)
        (or i32
          (shl i32 (and i32 (lshr i32 flags 2) 1) 2)
          (or i32
            (shl i32 (and i32 (lshr i32 flags 1) 1) 3)
            (shl i32 (and i32 flags 1) 4))))))

  (definstruction add_x_shift0
    (mnemonic ADD_X_SHIFT0)
    (isa aarch64_base)
    (category custom)
    (format A64_ADD_SUB_SHIFTED)
    (opcode 0)
    (func3 0)
    (func7 0)
    (encoding (sf 1) (op 0) (s 0) (fixed 11) (n 0))
    (operands
      (rd a64_gpr64 i64 out)
      (rn a64_gpr64 i64 in)
      (rm a64_gpr64 i64 in)
      (shift imm i2 in)
      (imm6 imm i6 in)
    )
    (asm "add $rd, $rn, $rm, $shift $imm6")
    (semantics "rd = rn + ShiftReg(rm, shift, imm6)")
    (requires (a64-shifted-reg i64 shift imm6))
    (behavior
      (set rd (add rn (a64_shift_reg i64 rm shift imm6)))
    )
    (latency 1)
    (throughput 1.0)
    (area-estimate-um2 0.0)
    (power-estimate-mw 0.0)
    (expected-speedup 1.0)
    (rationale "Models complete legal 64-bit shifted-register ADD encodings")
  )

