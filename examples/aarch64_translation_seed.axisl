                     (qlo (lane rm (% (* lane-index 2) 16)))
                     (qhi (lane rm (% (+ (* lane-index 2) 1) 16))))
               (select i8 (icmp_ult i8 lane-index 8)
                            (max i8 lo hi) (max i8 qlo qhi)))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((lo (lane rn (% (* lane-index 2) 8)))
                     (hi (lane rn (% (+ (* lane-index 2) 1) 8)))
                     (qlo (lane rm (% (* lane-index 2) 8)))
                     (qhi (lane rm (% (+ (* lane-index 2) 1) 8))))
               (select i16 (icmp_ult i16 lane-index 4)
                            (max i16 lo hi) (max i16 qlo qhi)))
        (vmap v4i32 ((lo (lane rn (% (* lane-index 2) 4)))
                     (hi (lane rn (% (+ (* lane-index 2) 1) 4)))
                     (qlo (lane rm (% (* lane-index 2) 4)))
                     (qhi (lane rm (% (+ (* lane-index 2) 1) 4))))
               (select i32 (icmp_ult i32 lane-index 2)
                            (max i32 lo hi) (max i32 qlo qhi))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A reduction step that halves the vector without leaving the register file"))

