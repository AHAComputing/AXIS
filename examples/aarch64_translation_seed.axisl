                       (doubled (add i64 (mul i64 wa wb) (mul i64 wa wb)))
                       (high (sra i64 doubled 32))
                       (both-min (and i32 (icmp_eq i32 a 0x80000000)
                                           (icmp_eq i32 b 0x80000000))))
