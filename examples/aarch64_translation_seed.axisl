        (vmap v2i64 ((x (lane rn (- lane-index (% lane-index 2))))
                             (y (lane rm (- lane-index (% lane-index 2)))))
          (select i64 (icmp_eq i64 (and i64 lane-index 1) 0) x y))))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "A 2x2 transpose is two instructions, and this is the first of them"))

  (definstruction zip1_v
    (mnemonic ZIP1_V) (isa aarch64_base) (category float) (format A64_SIMD_PERMUTE)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (fixed 14) (zero21 0) (zero15 0) (opcode 3) (two10 2))
