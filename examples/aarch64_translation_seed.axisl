  ; ⚠️ The remaining SCALAR (SISD) forms, derived like the first batch: bit 28
  ; set and Q = 1, the formal masked to element 0 in each arm -- the vector
  ; form's lane body, the register above it cleared. The integer ones exist
  ; only on doublewords; the FP ones on single and double. By element, the
  ; widening ones come from the lower-half forms, whose lane 0 is element 0
  ; of `rn` against `rm[index]`. Scalar pairwise is `rn[0] op rn[1]`, which is
  ; the vector pairwise form's lane 0 -- `rm` never reaches it.
  (definstruction add_sisd
    (mnemonic ADD_SISD) (isa aarch64_base) (category float) (format A64_SIMD_3SAME)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 30) (one21 1) (opcode 16) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (size imm i2 in)
    )
    (requires (= size 3))
    (asm "add $rd, $rn, $rm, arrangement $size")
    (semantics "Lanewise add at the arrangement `size` names, scalar")
    (formal
      (select i128 (icmp_eq i2 size 0)
        (and i128 (add v16i8 rn rm) 0xff)
        (select i128 (icmp_eq i2 size 1)
          (and i128 (add v8i16 rn rm) 0xffff)
          (select i128 (icmp_eq i2 size 2)
            (and i128 (add v4i32 rn rm) 0xffffffff)
            (and i128 (add v2i64 rn rm) 0xffffffffffffffff)))))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The scalar form of ADD_V: its lane body on element 0, the register above it cleared"))

