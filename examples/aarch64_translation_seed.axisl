    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The 64-bit destination form"))

  (definstruction fcmp_d
    (mnemonic FCMP_D) (isa aarch64_base) (category float) (format A64_FP_DP2)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (fpop 8) (rd 0))
    (operands (rn a64_vreg64 i64 in) (rm a64_vreg64 i64 in))
    (asm "fcmp $rn, $rm")
    (semantics "Compare two doubles and set NZCV; unordered is C and V")
    (behavior
      (setstate nzcv
        (if i32 (fcmp_uno f64 rn rm) 3
          (if i32 (fcmp_oeq f64 rn rm) 6
            (if i32 (fcmp_olt f64 rn rm) 8 2))) i4)
    )
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The four NZCV shapes an AArch64 float compare produces, unordered included"))

  (definstruction fcmp_d_zero
    (mnemonic FCMP_D_ZERO) (isa aarch64_base) (category float) (format A64_FP_DP2)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 243) (rm 0) (fpop 8) (rd 8))
    (operands (rn a64_vreg64 i64 in))
    (asm "fcmp $rn, #0.0")
    (semantics "Compare a double against +0.0 and set NZCV")
    (behavior
      (setstate nzcv
        (if i32 (fcmp_uno f64 rn 0) 3
          (if i32 (fcmp_oeq f64 rn 0) 6
            (if i32 (fcmp_olt f64 rn 0) 8 2))) i4)
    )
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The compare-with-zero form, which spends no register and is what a null float test emits"))

  ; ---------------------------------------------------------------------------
  ; Pointer authentication (arm64e), and BRK.
  ;
  ; **Described, not implemented.** Signing and authenticating a pointer is a
  ; keyed cipher over a modifier, and AXIS states no key, no cipher and no
  ; fault. So these carry prose `semantics` and no `behavior` or `formal`:
  ; nothing here claims to compute what they compute, and no executor is handed
  ; a value it would have had to invent. What they do carry is an encoding, and
  ; that is the point -- they are 1280 of the 1709 words a real arm64e binary
  ; has that this description did not name, and a miner that cannot decode
  ; `pacibsp` cannot find the function boundary that follows it.
  ;
  ; A consequence worth stating: the authenticating branches state no `setpc`,
  ; so a lifted block does not end at one. They decode and disassemble; they do
  ; not terminate a region.
  ; ---------------------------------------------------------------------------

  (definstruction pacibsp
    (mnemonic PACIBSP) (isa aarch64_base) (category custom) (format A64_CLREX)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 872498) (option 3) (fixed_lo 127))
    (operands)
    (asm "pacibsp")
    (implementation axis_impl_pacibsp)
    (semantics "Sign x30 with key B, using SP as the modifier. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The commonest undecoded word in an arm64e binary: every signed function opens with it"))

  (definstruction autibsp
    (mnemonic AUTIBSP) (isa aarch64_base) (category custom) (format A64_CLREX)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 872498) (option 3) (fixed_lo 255))
    (operands)
    (asm "autibsp")
    (implementation axis_impl_autibsp)
    (semantics "Authenticate x30 with key B and SP; faults on mismatch. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The counterpart of PACIBSP, at the other end of the function"))

  (definstruction retab
    (mnemonic RETAB) (isa aarch64_base) (category custom) (format A64_BRANCH_REG)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 3512259) (rn 31) (fixed0 31))
    (operands)
    (asm "retab")
    (implementation axis_impl_retab)
    (semantics "Authenticate x30 with key B and SP, then return to it. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "How a signed function returns; states no setpc because the target is an authenticated value"))

  (definstruction blraaz
    (mnemonic BLRAAZ) (isa aarch64_base) (category custom) (format A64_BRANCH_REG)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 3510210) (fixed0 31))
    (operands
      (rn a64_gpr64 i64 in)
    )
    (asm "blraaz $rn")
    (implementation axis_impl_blraaz)
    (semantics "Authenticate rn with key A and a zero modifier, then branch with link. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "An indirect call through an authenticated pointer"))

  (definstruction braa
    (mnemonic BRAA) (isa aarch64_base) (category custom) (format A64_BRANCH_REG_AUTH)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 3524546))
    (operands
      (rn a64_gpr64 i64 in)
      (rm a64_gpr64sp i64 in)
    )
    (asm "braa $rn, $rm")
    (implementation axis_impl_braa)
    (semantics "Authenticate rn with key A and rm as the modifier, then branch. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Every authenticated stub is one of these, which is why it leads the misses"))

  (definstruction paciza
    (mnemonic PACIZA) (isa aarch64_base) (category custom) (format A64_PAC_DP1)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 114690335))
    (operands
      (rd a64_gpr64 i64 inout)
    )
    (asm "paciza $rd")
    (implementation axis_impl_paciza)
    (semantics "Sign rd with key A and a zero modifier. Keyed and not modelled.")
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Signing a pointer held in a register rather than the link register"))

  (definstruction brk
    (mnemonic BRK) (isa aarch64_base) (category custom) (format A64_EXCEPTION)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed 1697) (fixed0 0))
    (operands
      (imm imm i16 in)
    )
    (asm "brk #$imm")
    (semantics "Take a breakpoint exception; the encoded comment is decoded and printed but changes no architectural state")
    (behavior
      (trap ebreak))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Base-ISA, not arm64e: a compiler emits it for unreachable code and it decoded as nothing"))

  (definstruction accel_dmb
    (mnemonic ACCEL_DMB) (isa accelerator_scalar64) (category custom)
    (format ACCEL_STATE_IMM4)
    (opcode 0) (func3 0) (func7 0)
    (encoding (opcode 122) (fixed_hi 0) (fixed_lo 1))
    (operands (option imm i4 in))
    (asm "accel.dmb #$option")
    (semantics "Accelerator data memory barrier")
