    (requires (< size 3))
    (asm "uqxtn2 $rd, $rn, arrangement $size")
    (semantics "Unsigned saturating extract narrow into the upper half")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v16i8 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 16)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 16))))
                 (let ((v (or i16 lo (shl i16 hi 8))))
                   (select i8 (icmp_ult i8 lane-index 8) d
                       (select i16 (icmp_ult i16 0xff v) 0xff v))))
      (select i128 (icmp_eq i2 size 1) (vmap v8i16 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 8)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 8))))
                 (let ((v (or i32 lo (shl i32 hi 16))))
                   (select i16 (icmp_ult i16 lane-index 4) d
                       (select i32 (icmp_ult i32 0xffff v) 0xffff v))))
        (vmap v4i32 ((d rd)
                   (lo (lane rn (% (* lane-index 2) 4)))
                   (hi (lane rn (% (+ (* lane-index 2) 1) 4))))
                 (let ((v (or i64 lo (shl i64 hi 32))))
                   (select i32 (icmp_ult i32 lane-index 2) d
                       (select i64 (icmp_ult i64 0xffffffff v) 0xffffffff v)))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Completes the opcode, and the only one whose source is read unsigned"))

  ; ⚠️ SHLL2 goes the other way and is the mirror image: it reads the UPPER
  ; half of its source and writes a FULL register of lanes twice as wide, each
  ; shifted left by its own new width. `rd` is an ordinary output here -- there
  ; is nothing to preserve -- and the half-register is on the reading side.
  ;
  ; Source lane j of the destination is narrow lane j + n/2, which lives inside
  ; wide container (j / 2) + n/4; whether it is that container's low or high
  ; half is `lane-index & 1`. The index arithmetic picks the container and the
  ; body picks the half, because `%` belongs to the index language and `and`
  ; belongs to the body.

  (definstruction shll2_v
    (mnemonic SHLL2_V) (isa aarch64_base) (category float)
    (format A64_SIMD_2MISC)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed21 16) (opcode 19) (fixed11 2))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (size imm i2 in)
    )
    (requires (< size 3))
    (asm "shll2 $rd, $rn, arrangement $size")
    (semantics "Widen the upper half of rn, each lane shifted left by its new width")
    (formal
      (select i128 (icmp_eq i2 size 0) (vmap v8i16 ((c (lane rn (+ (/ lane-index 2) 4))))
                 (let ((half (select i16 (icmp_eq i16 (and i16 lane-index 1) 0)
                                             (and i16 c 0xff)
                                             (lshr i16 c 8))))
                   (shl i16 half 8)))
      (select i128 (icmp_eq i2 size 1) (vmap v4i32 ((c (lane rn (+ (/ lane-index 2) 2))))
                 (let ((half (select i32 (icmp_eq i32 (and i32 lane-index 1) 0)
                                             (and i32 c 0xffff)
                                             (lshr i32 c 16))))
                   (shl i32 half 16)))
        (vmap v2i64 ((c (lane rn (+ (/ lane-index 2) 1))))
                 (let ((half (select i64 (icmp_eq i64 (and i64 lane-index 1) 0)
                                             (and i64 c 0xffffffff)
                                             (lshr i64 c 32))))
                   (shl i64 half 32))))))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The widening that puts a lane in the top of its new lane rather than the bottom"))

  ; ⚠️ THIS CORPUS DESCRIBES AArch64 WITH FPCR.DN = 1 -- default-NaN mode. Every
  ; floating-point operation with a NaN operand answers THE default NaN
  ; (0x7fc00000, 0x7ff8000000000000), which is what AXIS's float operators
  ; produce for every ISA. Arm's reset value is DN = 0, where the operand's
  ; own NaN propagates, quieted, keeping its payload and sign -- and that is
  ; what real userspace runs with, so this is a stated restriction, not a
  ; claim about what the silicon does. The ASL gate runs the architecture's
  ; model with DN = 1 so it measures what this corpus says. Faithful
  ; propagation is a language-level change to the float operators and is
  ; deliberately separate work.
  ;
  ; The lanes themselves need nothing new:
  ; an AXIS float is a bit pattern and the lane expansion is bit-vector work
  ; either way, so `fadd v4f32` is the same construction as `add v4i32` with a
  ; different type atom. That is the whole argument for having built the lane
  ; machinery domain-agnostically.
  ;
  ; What is new is that a float comparison has no entry in `LANE_COMPARE`. That
  ; list knows a lane compare answers a MASK rather than a 1, and it is integer
  ; only -- so the three comparisons below say the widening themselves, inside
  ; a lane body. Only ordered predicates exist here, so greater-than is
  ; less-than with its operands the other way round, exactly as the integer
  ; compares do it, and NaN falls out correctly for free: an ordered predicate
  ; is false against a NaN, and false times the lane mask is a lane of zeros.

  (definstruction fadd_v
    (mnemonic FADD_V) (isa aarch64_base) (category float)
    (format A64_SIMD_3SAME_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 0) (one21 1) (opcode 26) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (sz imm i1 in)
    )
    (asm "fadd $rd, $rn, $rm, arrangement $sz")
    (semantics "Lanewise floating-point add")
    (formal
      (select i128 (icmp_eq i1 sz 0) (fadd v4f32 rn rm)
        (fadd v2f64 rn rm)))
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "The same lane construction as the integer add, with a different type atom"))

  (definstruction fsub_v
    (mnemonic FSUB_V) (isa aarch64_base) (category float)
    (format A64_SIMD_3SAME_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 0) (fixed 14) (fixed23 1) (one21 1) (opcode 26) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (sz imm i1 in)
    )
    (asm "fsub $rd, $rn, $rm, arrangement $sz")
    (semantics "Lanewise floating-point subtract")
    (formal
      (select i128 (icmp_eq i1 sz 0) (fsub v4f32 rn rm)
        (fsub v2f64 rn rm)))
    (latency 5) (throughput 1.0)
    (area-estimate-um2 0.0) (power-estimate-mw 0.0) (expected-speedup 1.0)
    (rationale "Bit 23 rather than the opcode is what separates this from FADD"))

  (definstruction faddp_v
    (mnemonic FADDP_V) (isa aarch64_base) (category float)
    (format A64_SIMD_3SAME_FP)
    (opcode 0) (func3 0) (func7 0)
    (encoding (fixed_hi 0) (q 1) (u 1) (fixed 14) (fixed23 0) (one21 1) (opcode 26) (one10 1))
    (operands
      (rd a64_vreg128 i128 out) (rn a64_vreg128 i128 in) (rm a64_vreg128 i128 in)
      (sz imm i1 in)
    )
    (asm "faddp $rd, $rn, $rm, arrangement $sz")
    (semantics "Pairwise floating-point add across rn and rm")
    (formal
      (select i128 (icmp_eq i1 sz 0) (vmap v4f32 ((lo (lane rn (% (* lane-index 2) 4)))
                     (hi (lane rn (% (+ (* lane-index 2) 1) 4)))
                     (qlo (lane rm (% (* lane-index 2) 4)))
                     (qhi (lane rm (% (+ (* lane-index 2) 1) 4))))
               (select i32 (icmp_ult i32 lane-index 2)
                            (fadd f32 lo hi) (fadd f32 qlo qhi)))
        (vmap v2f64 ((lo (lane rn (% (* lane-index 2) 2)))
