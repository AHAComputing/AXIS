  (definstruction vxor_vv
    (mnemonic VXOR_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 5) (func7 5)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vxor.vv $vd, $vs2, $vs1")
    (semantics "Bitwise xor; element width and lane count both come from vtype")
    (formal (xor vti vs1 vs2))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Bitwise xor; element width and lane count both come from vtype"))

  (definstruction vmax_vv
    (mnemonic VMAX_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 6) (func7 6)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vmax.vv $vd, $vs2, $vs1")
    (semantics "Signed maximum; element width and lane count both come from vtype")
