    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Bitwise and; element width and lane count both come from vtype"))

  (definstruction vor_vv
    (mnemonic VOR_VV) (isa rvv) (category simd) (format RVV_V)
