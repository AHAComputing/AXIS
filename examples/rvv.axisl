; RVV: a scalable-vector ISA whose shapes come from a dynamic CSR.
;
; This is the other half of stage S7, and the half that exercises stage S3. SVE
; encodes the element width in the instruction; RVV takes it from `vtype`, so
; every instruction written against `vti` means a different shape at every
; (SEW, LMUL) point and AXIS elaborates one point at a time while the ladder
; sweeps them.
;
; `vti` is the integer shape vtype describes and `vtiw` its widened form: twice
; the element at twice the register footprint. The two cancel, which is why a
; widening operation has the same lane count as its operands.
;
; `vl` is *state*, not a mode, and the split matters: vtype changes shapes and
; must be static, while vl changes extent and need not be. So `vsetvli` is an
; ordinary instruction writing ordinary architectural state, and the tail policy
; reads it.
;
; Both agnostic policies are described honestly rather than resolved. A
; mask-agnostic or tail-agnostic element is architecturally *unspecified*: an
; implementation may leave it undisturbed or write all-ones and both are
; correct. What is specified is *which* elements, and that is what the ladder
; compares -- exactly, without masking -- while the contents are left free and
; fuzzed across realisations.
;
; Not described, and each for a stated reason: LMUL > 1 register grouping needs
; the operand-to-register mapping that pure lane functions cannot express, and
; `vfredusum` has no single architectural answer, so only the ordered reduction
; exists here. `vrgather` was on that list and is not any more -- it reads its
; index from a runtime vector, so it expands to a select tree quadratic in the
; lane count, which is described up to a stated ceiling of 32 lanes rather than
; refused.
(axis-module rvv
  (version "0.1.0")
  (target rvmt)
  (description "RVV scalable vectors: vtype-derived shapes, policies, memory")

  (defisa rvv
    (base rv64im)
    (word-bits 64)
    (vector-bits 128)
    (vector-sew 32)
    (vector-lmul 1)
    (vector-elen 64)
    (unspecified-realization compute)
    (registers "v[32]:i64" "pc:i64" "vl:i64" "vxsat:i8" "mem_lo:i64" "mem_hi:i64")
    (features simd scalable custom)
    (memory-model rvwmo)
    (endianness little))

  (defformat RVV_V
    (bits 32)
    (fields
      (opcode 6 0)
      (vd 11 7)
      (func3 14 12)
      (vs1 19 15)
      (vs2 24 20)
      (func7 31 25)))

  ; As in the SVE corpus: a memory form's base register is `rs1`, and RVV_V's
  ; field of that name is the vector source slot. Same layout, names that bind.
  ; One format per operand shape rather than one with every field: a field that
  ; an instruction neither uses nor pins is unbound, and an instruction with an
  ; unbound field is not encodable -- which is how the first attempt at these
  ; left the plain load and store exactly as unrunnable as before.
  ; The configuration form is not a vector-register instruction at all: it
  ; takes a scalar length and writes a scalar, so `RVV_V`'s `vd`/`vs1`/`vs2`
  ; are the wrong names for its bits and none of its operands bound to any of
  ; them. Its own shape, by the same rule as the memory forms above -- and the
  ; reason it needs stating is that an instruction whose operands bind to
  ; nothing is not encodable, has no fixture, and is therefore executed by no
  ; gate at all. `vtypei` is pinned because this corpus fixes SEW and LMUL in
  ; the behavior rather than decoding them.
  ; A scalar destination in the vector destination's bits. `vcpop.m rd, vs2`
  ; writes an x register, and an operand binds to the field whose name it
  ; matches, so `rd` bound to nothing. Same bits, the name the instruction uses.
  (defformat RVV_VX
    (bits 32)
    (fields
      (opcode 6 0)
      (rd 11 7)
      (func3 14 12)
      (vs1 19 15)
      (vs2 24 20)
      (func7 31 25)))

  ; A slide's background source, which sits where `vs1` does and is called `vb`.
  (defformat RVV_VB
    (bits 32)
    (fields
      (opcode 6 0)
      (vd 11 7)
      (func3 14 12)
      (vb 19 15)
      (vs2 24 20)
      (func7 31 25)))

  ; Two shapes that name a fourth register the three-register format cannot
  ; hold: the vector length a tail policy reads, and the mask register a
  ; predicated form reads. Three registers, a fourth and an opcode fit exactly
  ; -- 7 + 5 + 3 + 5 + 5 + 5 leaves two bits of `func7`, enough because `func3`
  ; already tells these apart.
  (defformat RVV_V_VL
    (bits 32)
    (fields
      (opcode 6 0)
      (vd 11 7)
      (func3 14 12)
      (vs1 19 15)
      (vs2 24 20)
      (vl 29 25)
      (func7 31 30)))

  (defformat RVV_V_MASK
    (bits 32)
    (fields
      (opcode 6 0)
      (vd 11 7)
      (func3 14 12)
      (vs1 19 15)
      (vs2 24 20)
      (v0 29 25)
      (func7 31 30)))

  (defformat RVV_VSET
    (bits 32)
    (fields
      (opcode 6 0)
      (rd 11 7)
      (func3 14 12)
      (avl 19 15)
      (vtypei 24 20)
      (func7 31 25)))

  (defformat RVV_MEM
    (bits 32)
    (fields
      (opcode 6 0)
      (vd 11 7)
      (func3 14 12)
      (rs1 19 15)
      (func7 31 25)))

  (defformat RVV_MEM_ST
    (bits 32)
    (fields
      (opcode 6 0)
      (vs3 11 7)
      (func3 14 12)
      (rs1 19 15)
      (func7 31 25)))

  (defformat RVV_MEM_STRIDED
    (bits 32)
    (fields
      (opcode 6 0)
      (vd 11 7)
      (func3 14 12)
      (rs1 19 15)
      (rs2 24 20)
      (func7 31 25)))

  (defformat RVV_MEM_INDEXED
    (bits 32)
    (fields
      (opcode 6 0)
      (vd 11 7)
      (func3 14 12)
      (rs1 19 15)
      (vs2 24 20)
      (func7 31 25)))

  (defformat RVV_MEM_ST_INDEXED
    (bits 32)
    (fields
      (opcode 6 0)
      (vs3 11 7)
      (func3 14 12)
      (rs1 19 15)
      (vs2 24 20)
      (func7 31 25)))

  (defformat RVV_MEM2
    (bits 32)
    (fields
      (opcode 6 0)
      (vd0 11 7)
      (func3 14 12)
      (rs1 19 15)
      (vd1 24 20)
      (func7 31 25)))

  (definstruction vadd_vv
    (mnemonic VADD_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 1) (func7 1)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vadd.vv $vd, $vs2, $vs1")
    (semantics "Add; element width and lane count both come from vtype")
    (formal (add vti vs1 vs2))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Add; element width and lane count both come from vtype"))

  (definstruction vsub_vv
    (mnemonic VSUB_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 2) (func7 2)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vsub.vv $vd, $vs2, $vs1")
    (semantics "Subtract; element width and lane count both come from vtype")
    (formal (sub vti vs1 vs2))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Subtract; element width and lane count both come from vtype"))

  (definstruction vand_vv
    (mnemonic VAND_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 3) (func7 3)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vand.vv $vd, $vs2, $vs1")
    (semantics "Bitwise and; element width and lane count both come from vtype")
