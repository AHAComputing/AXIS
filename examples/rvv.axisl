  (definstruction vmul_vv
    (mnemonic VMUL_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 0) (func7 8)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vmul.vv $vd, $vs2, $vs1")
    (semantics "Multiply, low half")
    (formal (mul vti vs1 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Multiply, low half"))

  (definstruction vwadd_vv
    (mnemonic VWADD_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 1) (func7 9)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vwadd.vv $vd, $vs2, $vs1")
    (semantics "Widening signed add: 2*SEW result at 2*LMUL, so the lane count is unchanged")
    (formal (vwadd vtiw vti vs1 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Widening signed add: 2*SEW result at 2*LMUL, so the lane count is unchanged"))

  (definstruction vwaddu_vv
    (mnemonic VWADDU_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 2) (func7 10)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vwaddu.vv $vd, $vs2, $vs1")
    (semantics "Widening unsigned add: 2*SEW result at 2*LMUL, so the lane count is unchanged")
    (formal (vwaddu vtiw vti vs1 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Widening unsigned add: 2*SEW result at 2*LMUL, so the lane count is unchanged"))

  (definstruction vwsub_vv
    (mnemonic VWSUB_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 3) (func7 11)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vwsub.vv $vd, $vs2, $vs1")
    (semantics "Widening signed subtract: 2*SEW result at 2*LMUL, so the lane count is unchanged")
    (formal (vwsub vtiw vti vs1 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Widening signed subtract: 2*SEW result at 2*LMUL, so the lane count is unchanged"))

  (definstruction vwmul_vv
    (mnemonic VWMUL_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 4) (func7 12)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vwmul.vv $vd, $vs2, $vs1")
    (semantics "Widening signed multiply: 2*SEW result at 2*LMUL, so the lane count is unchanged")
    (formal (vwmul vtiw vti vs1 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Widening signed multiply: 2*SEW result at 2*LMUL, so the lane count is unchanged"))

  (definstruction vwmulu_vv
    (mnemonic VWMULU_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 5) (func7 13)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vwmulu.vv $vd, $vs2, $vs1")
    (semantics "Widening unsigned multiply: 2*SEW result at 2*LMUL, so the lane count is unchanged")
    (formal (vwmulu vtiw vti vs1 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Widening unsigned multiply: 2*SEW result at 2*LMUL, so the lane count is unchanged"))

  (definstruction vnsrl_wv
    (mnemonic VNSRL_WV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 6) (func7 14)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vnsrl.wv $vd, $vs2, $vs1")
    (semantics "Narrowing logical shift right: the shift amount is the low lg2(2*SEW) bits, stated rather than assumed")
    (formal (vnsrl vti vtiw vs1 vs2))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Narrowing logical shift right: the shift amount is the low lg2(2*SEW) bits, stated rather than assumed"))

  (definstruction vnsra_wv
    (mnemonic VNSRA_WV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 7) (func7 15)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vnsra.wv $vd, $vs2, $vs1")
    (semantics "Narrowing arithmetic shift right: the shift amount is the low lg2(2*SEW) bits, stated rather than assumed")
    (formal (vnsra vti vtiw vs1 vs2))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Narrowing arithmetic shift right: the shift amount is the low lg2(2*SEW) bits, stated rather than assumed"))

  (definstruction vmslt_vv
    (mnemonic VMSLT_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 0) (func7 16)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vmslt.vv $vd, $vs2, $vs1")
    (semantics "Set-less-than into a mask, one bit per element")
    (formal (icmp_slt vti vs1 vs2))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Set-less-than into a mask, one bit per element"))

  (definstruction vmseq_vv
    (mnemonic VMSEQ_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 1) (func7 17)
    (operands (vd vreg i64 out) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vmseq.vv $vd, $vs2, $vs1")
    (semantics "Set-equal into a mask")
    (formal (icmp_eq vti vs1 vs2))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Set-equal into a mask"))

  (definstruction vadd_vv_tu
    (mnemonic VADD_VV_TU) (isa rvv) (category simd) (format RVV_V_MASK)
    (opcode 87) (func3 2) (func7 3)
    (operands (vd vreg i64 inout) (v0 vreg i64 in) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vadd.vv.tu $vd, $vs2, $vs1, $v0")
    (semantics "Masked add, mask-undisturbed: inactive elements keep vd")
    (formal (vmerge vti v0 (add vti vs1 vs2) vd))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Masked add, mask-undisturbed: inactive elements keep vd"))

  (definstruction vadd_vv_ma
    (mnemonic VADD_VV_MA) (isa rvv) (category simd) (format RVV_V_MASK)
    (opcode 87) (func3 3) (func7 3)
    (operands (vd vreg i64 out) (v0 vreg i64 in) (vs1 vreg i64 in) (vs2 vreg i64 in))
    (asm "vadd.vv.ma $vd, $vs2, $vs1, $v0")
    (semantics "Masked add, mask-agnostic: inactive elements are unspecified, and which ones is not")
    (formal (vundef vti v0 (add vti vs1 vs2)))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Masked add, mask-agnostic: inactive elements are unspecified, and which ones is not"))

  (definstruction vadd_vv_ta
    (mnemonic VADD_VV_TA) (isa rvv) (category simd) (format RVV_V_VL)
    (opcode 87) (func3 4) (func7 3)
    (operands (vd vreg i64 out) (vl reg i64 in) (vs1 vreg i64 in) (vs2 vreg i64 in))
