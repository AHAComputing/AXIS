    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Add with a tail-agnostic policy: elements at or above vl are unspecified"))

  (definstruction vredsum_vs
    (mnemonic VREDSUM_VS) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 5) (func7 21)
    (encoding (vs1 0))
    (operands (vd vreg i64 out) (vs2 vreg i64 in))
