  (definstruction vslideup_vi
    (mnemonic VSLIDEUP_VI) (isa rvv) (category simd) (format RVV_VB)
    (opcode 87) (func3 7) (func7 23)
    (operands (vd vreg i64 out) (vs2 vreg i64 in) (vb vreg i64 in))
    (asm "vslideup.vi $vd, $vs2, $vb")
    (semantics "Slide up by one; the elements below the offset are undisturbed, which is why a background operand is named")
    (formal (vslideup vti vs2 vb 1))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Slide up by one; the elements below the offset are undisturbed, which is why a background operand is named"))

  (definstruction vslidedown_vi
    (mnemonic VSLIDEDOWN_VI) (isa rvv) (category simd) (format RVV_VB)
    (opcode 87) (func3 0) (func7 24)
    (operands (vd vreg i64 out) (vs2 vreg i64 in) (vb vreg i64 in))
    (asm "vslidedown.vi $vd, $vs2, $vb")
    (semantics "Slide down by one; the tail takes the background")
    (formal (vslidedown vti vs2 vb 1))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 2.0)
    (rationale "Slide down by one; the tail takes the background"))

  (definstruction vle32_v
    (mnemonic VLE32_V) (isa rvv) (category custom) (format RVV_MEM)
    (opcode 7) (func3 1) (func7 25)
    (operands (vd vreg i32 out) (rs1 reg i64 in))
    (asm "vle32.v $vd, ($rs1)")
    (semantics "Unit-stride load of 32-bit elements")
    (behavior (set vd (vload vni32 rs1)))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 2000.0) (power-estimate-mw 3.0) (expected-speedup 2.0)
    (rationale "Unit-stride load of 32-bit elements"))

  (definstruction vse32_v
    (mnemonic VSE32_V) (isa rvv) (category custom) (format RVV_MEM_ST)
    (opcode 39) (func3 2) (func7 26)
    (operands (vs3 vreg i32 in) (rs1 reg i64 in))
    (asm "vse32.v $vs3, ($rs1)")
    (semantics "Unit-stride store of 32-bit elements")
    (behavior (store (vaddr vni32 rs1) vs3 i32))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 2000.0) (power-estimate-mw 3.0) (expected-speedup 2.0)
    (rationale "Unit-stride store of 32-bit elements"))

  (definstruction vlse32_v
    (mnemonic VLSE32_V) (isa rvv) (category custom) (format RVV_MEM_STRIDED)
    (opcode 7) (func3 3) (func7 27)
    (operands (vd vreg i32 out) (rs1 reg i64 in) (rs2 reg i64 in))
    (asm "vlse32.v $vd, ($rs1), $rs2")
    (semantics "Strided load of 32-bit elements")
    (behavior (set vd (vload_strided vni32 rs1 rs2)))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 2000.0) (power-estimate-mw 3.0) (expected-speedup 2.0)
    (rationale "Strided load of 32-bit elements"))

  (definstruction vlseg2e32_v
    (mnemonic VLSEG2E32_V) (isa rvv) (category custom) (format RVV_MEM2)
    (opcode 7) (func3 4) (func7 28)
    (operands (vd0 vreg i32 out) (vd1 vreg i32 out) (rs1 reg i64 in))
    (asm "vlseg2e32.v $vd0, $vd1, ($rs1)")
    (semantics "Two-field segment load")
    (behavior (set vd0 (vload_seg vni32 2 0 rs1))
      (set vd1 (vload_seg vni32 2 1 rs1)))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 2000.0) (power-estimate-mw 3.0) (expected-speedup 2.0)
    (rationale "Two-field segment load"))

  (definstruction vle32ff_v
    (mnemonic VLE32FF_V) (isa rvv) (category custom) (format RVV_MEM)
    (opcode 7) (func3 5) (func7 29)
    (operands (vd vreg i32 out) (rs1 reg i64 in))
    (asm "vle32ff.v $vd, ($rs1)")
    (semantics "Fault-only-first load: stops at the first element that would leave the accessible region")
    (behavior (set vd (vload_ff vni32 rs1 mem_lo mem_hi)))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 2000.0) (power-estimate-mw 3.0) (expected-speedup 2.0)
    (rationale "Fault-only-first load: stops at the first element that would leave the accessible region"))

  (definstruction vsetvli
    (mnemonic VSETVLI) (isa rvv) (category custom) (format RVV_VSET)
    (opcode 87) (func3 7) (func7 30) (encoding (vtypei 0))
    (operands (rd reg i64 out) (avl reg i64 in))
    (asm "vsetvli $rd, $avl")
    (semantics "Set the active vector length to min(avl, VLMAX) and report it")
    (behavior
      (setstate vl (minu i64 avl 4) i64)
      (set rd (minu i64 avl 4)))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 500.0) (power-estimate-mw 0.5) (expected-speedup 1.0)
    (rationale "vl is state an instruction reads, so setting it is an ordinary state write"))

  (definstruction vluxei32_v
    (mnemonic VLUXEI32_V) (isa rvv) (category custom) (format RVV_MEM_INDEXED)
    (opcode 7) (func3 5) (func7 60)
    (operands (vd vreg i32 out) (rs1 reg i64 in) (vs2 vreg i64 in))
    (asm "vluxei32.v $vd, ($rs1), $vs2")
    (semantics "Indexed (gather) load: element i reads rs1 + vs2[i]")
    (behavior (set vd (vload_indexed vni32 rs1 vs2)))
    (latency 5) (throughput 1.0)
    (area-estimate-um2 2500.0) (power-estimate-mw 4.0) (expected-speedup 1.5)
    (rationale "Gather takes its offset from the lane's own index element, so it is an ordinary per-lane address function"))

  (definstruction vsuxei32_v
    (mnemonic VSUXEI32_V) (isa rvv) (category custom) (format RVV_MEM_ST_INDEXED)
    (opcode 39) (func3 6) (func7 61)
    (operands (vs3 vreg i32 in) (rs1 reg i64 in) (vs2 vreg i64 in))
    (asm "vsuxei32.v $vs3, ($rs1), $vs2")
    (semantics "Indexed (scatter) store: element i writes rs1 + vs2[i]")
    (behavior (store (vaddr_indexed vni32 rs1 vs2) vs3 i32))
    (latency 1) (throughput 1.0)
    (area-estimate-um2 2500.0) (power-estimate-mw 4.0) (expected-speedup 1.5)
    (rationale "Scatter is the same address function in the location instead of the value"))

  (definstruction vrgather_vv
    (mnemonic VRGATHER_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 2) (func7 62)
    (operands (vd vreg i64 out) (vs2 vreg i64 in) (vs1 vreg i64 in))
    (asm "vrgather.vv $vd, $vs2, $vs1")
    (semantics "Gather: element i reads source element vs1[i], or zero when that index is out of range")
    (formal (vrgather vti vs2 vs1))
    (latency 4) (throughput 1.0)
    (area-estimate-um2 3000.0) (power-estimate-mw 5.0) (expected-speedup 1.5)
    (rationale "The one permute whose source lane is chosen at runtime, so it expands to a select tree rather than a static map"))

  ; --- mask manipulation --------------------------------------------------
  ;
  ; All six are the same question asked differently: where does this element sit
  ; relative to the active elements before it? `viota` reports that prefix count
  ; directly; the three set-first masks are comparisons against it; `vcpop` is
  ; the count over the whole vector and `vfirst` the position of the earliest
  ; active element.
  ;
  ; They needed no new machinery. The prefix count was written for `vcompress`,
  ; which packs *by* it, and extracting it made this family fall out -- which is
  ; the usual sign that a construct was decomposed at the right joint.
  ;
  ; `vcpop` and `vfirst` produce a scalar, so they collapse to one instruction
  ; each rather than one per lane, exactly as a reduction does.

  (definstruction viota_m
    (mnemonic VIOTA_M) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 7) (func7 63)
    (encoding (vs1 0))
    (operands (vd vreg i32 out) (vs2 vreg i32 in))
    (asm "viota.m $vd, $vs2")
    (semantics "Prefix count: element i is the number of active mask elements before it")
    (formal (viota vni32 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1200.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Prefix count: element i is the number of active mask elements before it"))

  (definstruction vmsbf_m
    (mnemonic VMSBF_M) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 0) (func7 64)
    (encoding (vs1 0))
    (operands (vd vreg i32 out) (vs2 vreg i32 in))
    (asm "vmsbf.m $vd, $vs2")
    (semantics "Set before first: active until the first set mask element")
    (formal (vmsbf vni32 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1200.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Set before first: active until the first set mask element"))

  (definstruction vmsif_m
    (mnemonic VMSIF_M) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 1) (func7 65)
    (encoding (vs1 0))
    (operands (vd vreg i32 out) (vs2 vreg i32 in))
    (asm "vmsif.m $vd, $vs2")
    (semantics "Set including first: as vmsbf but the first set element is included")
    (formal (vmsif vni32 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1200.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Set including first: as vmsbf but the first set element is included"))

  (definstruction vmsof_m
    (mnemonic VMSOF_M) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 2) (func7 66)
    (encoding (vs1 0))
    (operands (vd vreg i32 out) (vs2 vreg i32 in))
    (asm "vmsof.m $vd, $vs2")
    (semantics "Set only first: active at the first set mask element alone")
    (formal (vmsof vni32 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1200.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Set only first: active at the first set mask element alone"))

  (definstruction vcpop_m
    (mnemonic VCPOP_M) (isa rvv) (category simd) (format RVV_VX)
    (opcode 87) (func3 3) (func7 67)
    (encoding (vs1 0))
    (operands (rd reg i32 out) (vs2 vreg i32 in))
    (asm "vcpop.m $rd, $vs2")
    (semantics "Count the active mask elements into a scalar")
    (formal (vcpop vni32 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1200.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Count the active mask elements into a scalar"))

  (definstruction vfirst_m
    (mnemonic VFIRST_M) (isa rvv) (category simd) (format RVV_VX)
    (opcode 87) (func3 4) (func7 68)
    (encoding (vs1 0))
    (operands (rd reg i32 out) (vs2 vreg i32 in))
    (asm "vfirst.m $rd, $vs2")
    (semantics "Index of the first active mask element, or -1 when there is none")
    (formal (vfirst vni32 vs2))
    (latency 3) (throughput 1.0)
    (area-estimate-um2 1200.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Index of the first active mask element, or -1 when there is none"))

  ; --- float predicates and fixed-point saturation ------------------------
  ;
  ; None of these needed a new operator. Letting the IEEE comparisons and
  ; `select` through the lane-local vocabulary was enough, and saturating
  ; arithmetic then composes out of what was already there: an unsigned add
  ; saturates when its sum falls below either operand, and a signed one when the
  ; operands share a sign the result does not.
  ;
  ; Writing them compositionally rather than as primitives is the honest form --
  ; the overflow rule is *in* the description, where it can be read and argued
  ; with, instead of hidden inside an operator name. The cost is that the
  ; expression repeats its sum, since the language has no way to bind an
  ; intermediate; at four lanes that is cheap and at sixty-four it would not be.
  ;
  ; Not modelled: the `vxsat` sticky flag those instructions set. That is a state
  ; write, so it needs a behavior rather than a formal, and it would make these
  ; effectful instructions rather than pure ones.

  (definstruction vmfeq_vv
    (mnemonic VMFEQ_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 6) (func7 70)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vmfeq.vv $vd, $vs2, $vs1")
    (semantics "Float equality into a mask, one bit per element")
    (formal (fcmp_oeq vnf32 vs1 vs2))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Float equality into a mask, one bit per element"))

  (definstruction vmflt_vv
    (mnemonic VMFLT_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 7) (func7 71)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vmflt.vv $vd, $vs2, $vs1")
    (semantics "Float less-than into a mask")
    (formal (fcmp_olt vnf32 vs1 vs2))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Float less-than into a mask"))

  (definstruction vmfle_vv
    (mnemonic VMFLE_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 0) (func7 72)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vmfle.vv $vd, $vs2, $vs1")
    (semantics "Float less-or-equal into a mask")
    (formal (fcmp_ole vnf32 vs1 vs2))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Float less-or-equal into a mask"))

  (definstruction vsaddu_vv
    (mnemonic VSADDU_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 1) (func7 73)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vsaddu.vv $vd, $vs2, $vs1")
    (semantics "Unsigned saturating add: a sum below either operand has wrapped")
    (formal (select vni32 (icmp_ult vni32 (add vni32 vs1 vs2) vs1) 0xffffffff (add vni32 vs1 vs2)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Unsigned saturating add: a sum below either operand has wrapped"))

  (definstruction vssubu_vv
    (mnemonic VSSUBU_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 2) (func7 74)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vssubu.vv $vd, $vs2, $vs1")
    (semantics "Unsigned saturating subtract: clamps at zero")
    (formal (select vni32 (icmp_ult vni32 vs1 vs2) 0 (sub vni32 vs1 vs2)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Unsigned saturating subtract: clamps at zero"))

  (definstruction vsadd_vv
    (mnemonic VSADD_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 3) (func7 75)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vsadd.vv $vd, $vs2, $vs1")
    (semantics "Signed saturating add: overflow when the operands share a sign the result does not")
    (formal (select vni32 (lshr vni32 (and vni32 (xor vni32 vs1 (add vni32 vs1 vs2)) (xor vni32 vs2 (add vni32 vs1 vs2))) 31) (select vni32 (icmp_slt vni32 vs1 0) 0x80000000 0x7fffffff) (add vni32 vs1 vs2)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Signed saturating add: overflow when the operands share a sign the result does not"))

  (definstruction vssub_vv
    (mnemonic VSSUB_VV) (isa rvv) (category simd) (format RVV_V)
    (opcode 87) (func3 4) (func7 76)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vssub.vv $vd, $vs2, $vs1")
    (semantics "Signed saturating subtract: overflow when the operands differ in sign and the result differs from vs1")
    (formal (select vni32 (lshr vni32 (and vni32 (xor vni32 vs1 vs2) (xor vni32 vs1 (sub vni32 vs1 vs2))) 31) (select vni32 (icmp_slt vni32 vs1 0) 0x80000000 0x7fffffff) (sub vni32 vs1 vs2)))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Signed saturating subtract: overflow when the operands differ in sign and the result differs from vs1"))

  (definstruction vmv_x_s
    (mnemonic VMV_X_S) (isa rvv) (category simd) (format RVV_VX)
    (opcode 87) (func3 5) (func7 77)
    (encoding (vs1 0))
    (operands (rd reg i32 out) (vs2 vreg i32 in))
    (asm "vmv.x.s $rd, $vs2")
    (semantics "Move element 0 to a scalar register")
    (formal (vextract vni32 vs2 0))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1400.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Move element 0 to a scalar register"))

  ; --- saturation with its sticky flag ------------------------------------
  ;
  ; The pure forms above compute the saturated value and say nothing about
  ; vxsat. A real machine sets that flag when saturation occurs and leaves it
  ; set until software clears it, so the flag is *sticky* -- which means the
  ; instruction reads the old value and ors into it, and that makes these
  ; effectful rather than pure.
  ;
  ; Both forms are kept. The pure ones state the saturation rule where it can be
  ; read; these state what the machine also records. Splitting them that way is
  ; not how a real description would be organised, but it keeps the arithmetic
  ; legible in one place and the flag legible in another.
  ;
  ; `vxsat` is architectural state, and state is scalar: one flag, not one per
  ; lane. Lane instantiation therefore has to know which symbols are state and
  ; leave them alone -- otherwise the sticky read becomes `vxsat__l0`, a name
  ; nothing declares.

  (definstruction vsaddu_vv_x
    (mnemonic VSADDU_VV_X) (isa rvv) (category custom) (format RVV_V)
    (opcode 87) (func3 0) (func7 80)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vsaddu.vv.x $vd, $vs2, $vs1")
    (semantics "Unsigned saturating add that records saturation in vxsat")
    (behavior
      (set vd (select vni32 (icmp_ult vni32 (add vni32 vs1 vs2) vs1) 0xffffffff (add vni32 vs1 vs2)))
      (setstate vxsat (or i8 vxsat (icmp_ult vni32 (add vni32 vs1 vs2) vs1)) i8))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Unsigned saturating add that records saturation in vxsat"))

  (definstruction vssubu_vv_x
    (mnemonic VSSUBU_VV_X) (isa rvv) (category custom) (format RVV_V)
    (opcode 87) (func3 1) (func7 81)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vssubu.vv.x $vd, $vs2, $vs1")
    (semantics "Unsigned saturating subtract that records saturation")
    (behavior
      (set vd (select vni32 (icmp_ult vni32 vs1 vs2) 0 (sub vni32 vs1 vs2)))
      (setstate vxsat (or i8 vxsat (icmp_ult vni32 vs1 vs2)) i8))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Unsigned saturating subtract that records saturation"))

  (definstruction vsadd_vv_x
    (mnemonic VSADD_VV_X) (isa rvv) (category custom) (format RVV_V)
    (opcode 87) (func3 2) (func7 82)
    (operands (vd vreg i32 out) (vs1 vreg i32 in) (vs2 vreg i32 in))
    (asm "vsadd.vv.x $vd, $vs2, $vs1")
    (semantics "Signed saturating add that records saturation")
    (behavior
      (set vd (select vni32 (lshr vni32 (and vni32 (xor vni32 vs1 (add vni32 vs1 vs2)) (xor vni32 vs2 (add vni32 vs1 vs2))) 31) (select vni32 (icmp_slt vni32 vs1 0) 0x80000000 0x7fffffff) (add vni32 vs1 vs2)))
      (setstate vxsat (or i8 vxsat (lshr vni32 (and vni32 (xor vni32 vs1 (add vni32 vs1 vs2)) (xor vni32 vs2 (add vni32 vs1 vs2))) 31)) i8))
    (latency 2) (throughput 1.0)
    (area-estimate-um2 1500.0) (power-estimate-mw 2.0) (expected-speedup 1.5)
    (rationale "Signed saturating add that records saturation"))
)
